---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Briefkaart from '../../components/Briefkaart.astro';
import SubstackCta from '../../components/SubstackCta.astro';
import { organizationSchema, breadcrumbSchema } from '../../lib/seo';
import { INSTAGRAM_URL, SUBSTACK_URL } from '../../lib/social';

// Kanaal-URLs komen uit src/lib/social.ts (een bron, geen drift). Substack is
// live sinds 2026-07-16. Substack is het enige nieuwsbriefkanaal (LAT-12309).

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'De brief', url: '/de-brief/' },
  ]),
];
---

<SiteLayout
  title="De brief, de nieuwsbrief van VinoMartino"
  description="Eens per maand stopt Marijn een brief in je inbox: over een wijnmaker die we net bezochten, een regio die opnieuw onze aandacht trok, een fles die indruk maakte. Aanmelden gaat via Substack."
  schema={schema}
  activeNav="de-brief"
  alternates={{ nl: '/de-brief/', en: '/en/de-brief/' }}
>
  <section class="hero">
    <div class="container container-narrow">
      <span class="kicker">De brief · eens per maand</span>
      <h1>De brief</h1>
      <p class="lede">
        Eens per maand stopt Marijn een brief in je inbox. Geen persberichten,
        geen uitnodigingen voor generieke wijnfestivals, een echte brief. Over een
        wijnmaker die we net bezochten, een regio die opnieuw onze aandacht trok, een
        fles die indruk maakte. Aanmelden gaat via Substack.
        {/* LAT-12572: weghalen zodra de eerste editie verstuurd is. */}
        De eerste editie verschijnt op 5 november.
      </p>

      <div class="signup">
        <SubstackCta placement="de-brief" ctaId="newsletter_signup" label="Schrijf je in voor De brief" />
      </div>

      <p class="follow">
        Al nieuwsgierig? Volg Marijn alvast op
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram</a>{SUBSTACK_URL ? (
          <>, of lees de brieven online op <a href={SUBSTACK_URL} target="_blank" rel="noopener" data-cta-id="substack_link">Substack</a></>
        ) : null}, daar verschijnen de eerste verhalen.
      </p>
    </div>
  </section>

  <section class="voorbeeld">
    <div class="container container-narrow">
      <Briefkaart dateline="De Brief, voorbeeld">
        <p>Beste lezer,</p>
        <p>
          Het was de dag nadat de laatste trossen Nebbiolo waren geoogst, begin
          november, en de Langhe was verlaten op een manier die alleen november kan.
          Geel en stil. We reden op smalle asfaltwegen van La Morra naar Verduno, met
          niemand voor ons en niemand achter ons.
        </p>
        <p>
          Bij Fratelli Alessandria, een huis in Verduno dat niet in de toeristengidsen
          staat, deed de wijnmaker open alsof we deel waren van zijn middag en niet van
          iets bijzonders. We proefden de 2017 Monvigliero: breed, warm, met de typische
          teer en rozen van Nebbiolo en iets wat ik alleen kan omschrijven als november
          zelf in een glas.
        </p>
        <p>
          In de volledige editie: het hele verhaal uit de Langhe, de Piemonte-pakketpagina
          die eraan komt, en een Siciliaanse wijnhuis-tip.
        </p>
        <p>
          Dit is een voorbeeld. Meld je aan, dan valt de eerstvolgende editie in je inbox.
        </p>
      </Briefkaart>
    </div>
  </section>
</SiteLayout>

<style>
  .container { max-width: 1280px; margin: 0 auto; padding-inline: var(--gutter); }
  .container-narrow { max-width: 760px; }

  .hero {
    padding: clamp(56px, 10vw, 112px) 0;
    text-align: center;
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-rust, #A14F2A);
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5vw + 1rem, 5rem);
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
    line-height: 0.95;
  }
  .lede {
    font-family: var(--font-serif, var(--font-body));
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--color-text-soft, var(--color-text));
    margin: 1.5rem auto 0;
    max-width: 600px;
  }
  .signup {
    margin: 2rem auto 0;
    max-width: 480px;
  }
  .follow {
    font-family: var(--font-serif, var(--font-body));
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-faint, var(--color-text-soft, var(--color-text)));
    margin: 1.25rem auto 0;
    max-width: 480px;
  }
  .follow a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .voorbeeld {
    padding: 0 0 clamp(56px, 10vw, 112px);
  }
  .voorbeeld-link {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.35;
    margin-top: 1.1rem;
  }
  .voorbeeld-link a {
    color: var(--burgundy);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
