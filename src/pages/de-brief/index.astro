---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Briefkaart from '../../components/Briefkaart.astro';
import SubstackCta from '../../components/SubstackCta.astro';
import { organizationSchema, breadcrumbSchema } from '../../lib/seo';
import { INSTAGRAM_URL, SUBSTACK_URL } from '../../lib/social';

// Kanaal-URLs komen uit src/lib/social.ts (een bron, geen drift). Substack is
// live sinds 2026-07-16. Substack is het enige nieuwsbriefkanaal (LAT-12309).

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'De brief', url: '/de-brief/' },
  ]),
];
---

<SiteLayout
  title="De brief, de nieuwsbrief van VinoMartino"
  description="Eens per maand stopt Marijn een brief in je inbox: over een wijnmaker die we net bezochten, een regio die opnieuw onze aandacht trok, een fles die indruk maakte. Aanmelden gaat via Substack."
  schema={schema}
  activeNav="de-brief"
  alternates={{ nl: '/de-brief/', en: '/en/de-brief/' }}
>
  <section class="hero">
    <div class="container container-narrow">
      <span class="kicker">De brief · eens per maand</span>
      <h1>De brief</h1>
      <p class="lede">
        Eens per maand stopt Marijn een brief in je inbox. Geen persberichten,
        geen uitnodigingen voor generieke wijnfestivals, een echte brief. Over een
        wijnmaker die we net bezochten, een regio die opnieuw onze aandacht trok, een
        fles die indruk maakte.
        {/* LAT-13196: geen vaste verschijningsdatum beloven; het archief hieronder is de waarheid. */}
        De brief verschijnt sinds juli 2026 op Substack, in het Nederlands.
        Aanmelden gaat via Substack.
      </p>

      <div class="signup">
        <SubstackCta placement="de-brief" ctaId="newsletter_signup" label="Schrijf je in voor De brief" />
      </div>

      <p class="follow">
        Al nieuwsgierig? Volg Marijn alvast op
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram</a>{SUBSTACK_URL ? (
          <>, of lees de brieven online op <a href={SUBSTACK_URL} target="_blank" rel="noopener" data-cta-id="substack_link">Substack</a></>
        ) : null}, daar staan alle verschenen brieven.
      </p>
    </div>
  </section>

  <section class="voorbeeld">
    <div class="container container-narrow">
      <Briefkaart dateline="De brief, verschenen edities">
        <p>Twee brieven zijn tot nu toe verschenen:</p>
        <ul class="edities">
          <li>16 juli 2026, de Langhe: <a href="https://vinomartino.substack.com/p/waarom-de-ene-barolo-twintig-jaar" target="_blank" rel="noopener">Waarom de ene Barolo twintig jaar dichtblijft en de andere niet</a></li>
          <li>2 oktober 2026, Toscane: <a href="https://vinomartino.substack.com/p/waarom-brunello-chianti-en-vino-nobile-923" target="_blank" rel="noopener">Waarom Brunello, Chianti en Vino Nobile dezelfde druif zijn en toch niet op elkaar lijken</a></li>
        </ul>
        <p>De volgende brief heeft nog geen datum. Wie zich aanmeldt, krijgt hem in de inbox zodra hij verschijnt.</p>
      </Briefkaart>
    </div>
  </section>
</SiteLayout>

<style>
  .container { max-width: 1280px; margin: 0 auto; padding-inline: var(--gutter); }
  .container-narrow { max-width: 760px; }

  .hero {
    padding: clamp(56px, 10vw, 112px) 0;
    text-align: center;
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-rust, #A14F2A);
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5vw + 1rem, 5rem);
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
    line-height: 0.95;
  }
  .lede {
    font-family: var(--font-serif, var(--font-body));
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--color-text-soft, var(--color-text));
    margin: 1.5rem auto 0;
    max-width: 600px;
  }
  .signup {
    margin: 2rem auto 0;
    max-width: 480px;
  }
  .follow {
    font-family: var(--font-serif, var(--font-body));
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-faint, var(--color-text-soft, var(--color-text)));
    margin: 1.25rem auto 0;
    max-width: 480px;
  }
  .follow a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .edities { padding-left: 1.2rem; }
  .edities li { margin-bottom: 0.5rem; }
  /* Briefkaart blijft crème in kelder-modus; de globale linkkleur (goud) valt daar weg. */
  .edities a { color: var(--fixed-ink); text-decoration: underline; text-underline-offset: 3px; }
  .edities a:hover { color: #5A1A1F; }

  .voorbeeld {
    padding: 0 0 clamp(56px, 10vw, 112px);
  }
  .voorbeeld-link {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.35;
    margin-top: 1.1rem;
  }
  .voorbeeld-link a {
    color: var(--burgundy);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
