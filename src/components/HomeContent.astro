---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Briefkaart from '../components/Briefkaart.astro';
import SubstackCta from '../components/SubstackCta.astro';
import { loadArticles } from '../lib/articles';
import { loadRoutes } from '../lib/routes';
import { loadStreken } from '../lib/streken';
import { organizationSchema } from '../lib/seo';
import { getAuthorByByline } from '../lib/authors';
import { loadUiStrings } from '../lib/ui-strings';
import { rubriekLabel } from '../lib/rubriek-labels';
import { type Locale, DEFAULT_LOCALE, localizeHref } from '../lib/i18n';
// LAT-5467 — de homepage rendert haar kaarten met een rauwe <img> i.p.v.
// SmartImg, dus de beeld-niveau §7-marker moet hier apart worden meegegeven.
import { loadSyntheticImageIds, syntheticImageAttrs } from '../lib/synthetic-images';

interface Props {
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale = DEFAULT_LOCALE, alternates } = Astro.props;

// LAT-2704 — interne hrefs locale-aware; NL blijft byte-identiek.
const lh = (href: string) => localizeHref(href, locale);
const ui = await loadUiStrings(locale);

// LAT-5467 — één gememoiseerde DAM-read per build; `herkomst(src)` geeft het
// data-beeldherkomst-attribuut terug voor AI-beeld en niets voor de rest.
const syntheticIds = await loadSyntheticImageIds();
const herkomst = (src: string | null | undefined) => syntheticImageAttrs(syntheticIds, null, src);
const dateLocale = locale === 'en' ? 'en-GB' : 'nl-NL';

// LAT-1848: render altijd de gecanoniseerde auteursnaam uit het auteur-record
// (bv. "Marijn") i.p.v. het ruwe Directus author-veld (dat nog "Martin" kan zijn).
const authorName = (byline: string | null | undefined): string =>
  getAuthorByByline(byline)?.name ?? byline ?? 'VinoMartino';

const articles = await loadArticles(locale);
// LAT-1611: het "verhaal van de week" is instelbaar via het `featured`-veld in
// Directus. Board zet de toggle aan op het gewenste artikel; bij meerdere wint
// het nieuwste. Geen featured-artikel → val terug op het nieuwste artikel.
const spotlight = articles.find((a) => a.featured) ?? articles[0];
// LAT-13075 — homepage v2: de hero draagt geen artikelbeelden meer, dus de
// asymmetrische feed toont de vijf nieuwste artikelen na het spotlight-artikel.
const moreArticles = articles.filter((a) => a.slug !== spotlight?.slug).slice(0, 5);
const FEED_TONES = ['bordeaux', 'vine', 'paper'] as const;
const routes = await loadRoutes(locale);
const allStreken = await loadStreken(locale);

const schema = organizationSchema();

const HERO_IMAGE = '/images/landschap-piemonte-barolo-001.jpg';

// ── LAT-13075 — Homepage v2 (goedgekeurd ontwerp, plaat "01 Homepage") ────
// Eén uitgelichte route over de volle breedte plus drie bestemmingen, allemaal
// uit Directus `routes`. Beeld = het `hero_image` van dat route-record zelf
// (DAM-gekoppeld, rendert al op de routepagina), nooit een pool- of conceptfoto
// (HARDE REGEL 2/14). Streeknaam en land komen uit het gekoppelde streek-record.
// `routes` kent geen featured-veld; daarom een deterministische voorkeurslijst
// van route-slugs. Ontbreekt een voorkeursroute of haar hero, dan vult de eerste
// route met hero uit een nog niet getoonde streek het gat (geen lege kaart).
const HOME_V2_FEATURED_ROUTE = 'langhe-piemonte';
const HOME_V2_DESTINATION_ROUTES = [
  'champagne-reims-epernay-montagne-de-reims',
  'mosel-bernkastel-traben-trarbach',
  'toscane-bolgheri-montalcino-carmignano',
];
const HOME_V2_DESTINATIONS_MAX = 3;

const strekenBySlug = new Map(allStreken.map((s) => [s.slug, s]));
const routesWithHero = routes.filter((r) => Boolean(r.heroImage) && Boolean(r.streekSlug));
const toHomeCard = (r: (typeof routes)[number]) => {
  const streek = strekenBySlug.get(r.streekSlug);
  return {
    slug: r.slug,
    href: lh(`/wijnroutes/${r.slug}/`),
    title: r.title,
    image: r.heroImage as string,
    streekSlug: r.streekSlug,
    region: streek?.name || '',
    country: streek?.country || '',
  };
};

const featuredRoute =
  routesWithHero.find((r) => r.slug === HOME_V2_FEATURED_ROUTE) ?? routesWithHero[0];
const featured = featuredRoute ? toHomeCard(featuredRoute) : undefined;

const usedStreken = new Set<string>(featured ? [featured.streekSlug] : []);
const destinations: ReturnType<typeof toHomeCard>[] = [];
const pushDestination = (r: (typeof routes)[number] | undefined) => {
  if (!r || usedStreken.has(r.streekSlug) || destinations.length >= HOME_V2_DESTINATIONS_MAX) return;
  const card = toHomeCard(r);
  if (!card.region) return;
  usedStreken.add(r.streekSlug);
  destinations.push(card);
};
for (const slug of HOME_V2_DESTINATION_ROUTES) {
  pushDestination(routesWithHero.find((r) => r.slug === slug));
}
for (const r of routesWithHero) pushDestination(r);

function formatDate(value?: string | null) {
  if (!value) return '';
  try {
    return new Date(value).toLocaleDateString(dateLocale, { day: 'numeric', month: 'long', year: 'numeric' });
  } catch {
    return '';
  }
}
---

<SiteLayout
  title={ui.t('home.meta.title')}
  description={ui.t('home.meta.description')}
  ogImage={featured?.image ?? HERO_IMAGE}
  schema={schema}
  locale={locale}
  alternates={alternates}
>
  <section class="home-intro" aria-labelledby="home-v2-title">
    <div class="container home-intro__inner">
      <h1 id="home-v2-title" class="home-intro__title">{ui.t('home.v2.title')}</h1>
      <p class="home-intro__sub">{ui.t('home.v2.sub')}</p>
    </div>
  </section>

  {featured && (
    <section class="home-feature" aria-label={ui.t('home.v2.featured.aria')}>
      <img
        class="home-feature__img"
        src={featured.image}
        alt={featured.title}
        width="1600"
        height="900"
        fetchpriority="high"
        decoding="async"
        {...herkomst(featured.image)}
      />
      <div class="container home-feature__inner">
        <div class="home-feature__card">
          {featured.region && (
            <span class="home-feature__kicker">{ui.t('home.v2.featured.kicker').replace('{streek}', featured.region)}</span>
          )}
          <h2 class="home-feature__title">{featured.title}</h2>
          <a href={featured.href} class="home-feature__btn">{ui.t('home.v2.featured.cta')}</a>
        </div>
      </div>
    </section>
  )}

  {destinations.length > 0 && (
    <section id="bestemmingen" class="home-dest" aria-labelledby="home-v2-dest-title">
      <div class="container">
        <h2 id="home-v2-dest-title" class="home-dest__title">{ui.t('home.v2.dest.title')}</h2>
        <ul class="home-dest__grid">
          {destinations.map((d) => (
            <li>
              <a href={d.href} class="home-dest__card">
                <span class="home-dest__media">
                  <img src={d.image} alt={d.title} width="600" height="550" loading="lazy" decoding="async" {...herkomst(d.image)} />
                </span>
                <span class="home-dest__name">{d.region}</span>
                {d.country && <span class="home-dest__country">{d.country}</span>}
              </a>
            </li>
          ))}
        </ul>
        <p class="home-dest__cta"><a href={lh('/wijnroutes/')} class="home-dest__link">{ui.t('home.v2.dest.cta')}</a></p>
      </div>
    </section>
  )}

  {spotlight && (
    <section class="spotlight">
      <div class="container spotlight-inner">
        <a href={lh(`/artikelen/${spotlight.slug}/`)} class="spotlight-media-link" aria-label={spotlight.title}>
          {spotlight.heroImage ? (
            <img
              src={spotlight.heroImage}
              alt={spotlight.title}
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
              class="spotlight-img"
              {...herkomst(spotlight.heroImage)}
            />
          ) : (
            <div class="spotlight-img spotlight-placeholder" aria-hidden="true"></div>
          )}
        </a>
        <div class="spotlight-body">
          <span class="kicker">{ui.t('home.spotlight.kicker')}</span>
          {spotlight.category && <span class="spotlight-cat">{rubriekLabel(ui, spotlight.category)}</span>}
          <h2 class="spotlight-title">
            <a href={lh(`/artikelen/${spotlight.slug}/`)}>{spotlight.title}</a>
          </h2>
          {spotlight.description && <p class="spotlight-desc">{spotlight.description}</p>}
          <p class="spotlight-meta">
            <span>{authorName(spotlight.author)}</span>
            <span class="dot" aria-hidden="true">·</span>
            <span>{formatDate(spotlight.pubDate)}</span>
          </p>
          <a href={lh(`/artikelen/${spotlight.slug}/`)} class="quiet-cta">{ui.t('home.spotlight.cta')}</a>
        </div>
      </div>
    </section>
  )}

  {moreArticles.length > 0 && (
    <section class="cards-section cards-section--alt">
      <div class="container">
        <header class="section-head">
          <h2 class="section-h">{ui.t('home.feed.title')}</h2>
          <p class="section-sub">
            {ui.t('home.latest.sub')}
          </p>
        </header>
        <div class="feed-grid feed-grid--b">
          {moreArticles.map((article, idx) => (
            <ArticleCard
              href={lh(`/artikelen/${article.slug}/`)}
              title={article.title}
              kicker={article.category ? rubriekLabel(ui, article.category) : null}
              zelfGereisd={article.zelfGereisd}
              bezoekjaar={article.bezoekjaar}
              variant="b"
              index={idx + 1}
              tone={FEED_TONES[idx % FEED_TONES.length]}
              featured={idx === 0}
              locale={locale}
            >
              {article.heroImage ? (
                <img slot="media" src={article.heroImage} alt={article.title} width={idx === 0 ? 1200 : 800} height={idx === 0 ? 900 : 600} loading="lazy" decoding="async" {...herkomst(article.heroImage)} />
              ) : (
                <div slot="media" class="card-placeholder" aria-hidden="true"></div>
              )}
            </ArticleCard>
          ))}
        </div>
        <p class="section-cta"><a href={lh('/artikelen/')} class="btn btn-outline">{ui.t('home.latest.allesCta')}</a></p>
      </div>
    </section>
  )}

  <section class="proof" aria-label={ui.t('home.proof.aria')}>
    <div class="container proof-inner">
      <div class="proof-portrait">
        <img
          src="/over-ons-hero.jpg"
          alt={ui.t('home.proof.portraitAlt')}
          width="800"
          height="1000"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="proof-body">
        <span class="kicker proof-kicker">{ui.t('home.proof.kicker')}</span>
        {/* LAT-2008: cijfers gestaafd tegen de canon. "11" spiegelt de Tier 1-lijst
            `visited` op /over-ons/ (elf zelf-gereisde streken); "2019" is dezelfde bronclaim als
            "streken sinds 2019" daar. Het "60+ wijnhuizen"-cijfer is geschrapt tot
            er telbewijs uit Directus is (Marijn, 2026-07-03). */}
        <ul class="proof-stats">
          <li><span class="proof-num">11</span><span class="proof-label">{ui.t('home.proof.stat1Label')}</span></li>
          <li><span class="proof-num">2019</span><span class="proof-label">{ui.t('home.proof.stat2Label')}</span></li>
        </ul>
        <p class="proof-manifest">
          {ui.t('home.proof.manifestPre')}<em>{ui.t('home.proof.manifestEm')}</em>.
        </p>
        <a href={lh('/over-ons/')} class="btn btn-outline">{ui.t('home.proof.cta')}</a>
      </div>
    </div>
  </section>

  <section class="brief">
    <div class="container">
      <Briefkaart dateline={ui.t('home.brief.dateline')} align="center">
        <h2 class="brief-kaart-h">{ui.t('home.brief.heading')}</h2>
        <p>
          {ui.t('home.brief.body')}
        </p>
        <div class="brief-signup">
          <SubstackCta placement="home-brief" ctaId="newsletter_signup" label={ui.t('home.brief.submit')} />
        </div>
      </Briefkaart>
    </div>
  </section>
</SiteLayout>

<style>
  /* ── LAT-13075 Homepage v2: intro, uitgelichte route, bestemmingen ─── */
  .home-intro {
    background: var(--paper);
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(1.75rem, 4vw, 2.5rem);
  }
  .home-intro__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.5rem, 6.4vw, 4.75rem);
    line-height: 1.04;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 18ch;
    margin: 0;
    overflow-wrap: break-word;
  }
  .home-intro__sub {
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.45;
    color: var(--inkSoft);
    margin: var(--space-4) 0 0;
    max-width: 44ch;
  }
  .home-feature {
    position: relative;
    min-height: clamp(420px, 52vw, 640px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--paperDeep);
  }
  .home-feature__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .home-feature__inner {
    position: relative;
    width: 100%;
    padding-bottom: clamp(1.25rem, 3vw, 2.5rem);
  }
  .home-feature__card {
    background: var(--fixed-cream);
    color: var(--fixed-ink);
    max-width: 24rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    box-shadow: 0 10px 30px rgba(31, 26, 22, 0.18);
  }
  .home-feature__kicker {
    display: block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fixed-ink);
    margin-bottom: var(--space-2);
  }
  .home-feature__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.12;
    margin: 0 0 var(--space-4);
    color: var(--fixed-ink);
    overflow-wrap: break-word;
  }
  .home-feature__btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.6rem 1.25rem;
    background: var(--burgundy);
    color: var(--fixed-cream);
    font-family: var(--font-body);
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .home-feature__btn:hover,
  .home-feature__btn:focus-visible { background: var(--burgundyDeep); color: var(--fixed-cream); }
  .home-dest {
    background: var(--paper);
    padding: clamp(2.5rem, 6vw, 4.5rem) 0;
  }
  .home-dest__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.1;
    text-align: center;
    color: var(--ink);
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
  }
  .home-dest__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }
  .home-dest__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: var(--ink);
  }
  .home-dest__media {
    display: block;
    width: 100%;
    aspect-ratio: 12 / 11;
    overflow: hidden;
    background: var(--paperDeep);
  }
  .home-dest__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .home-dest__card:hover .home-dest__media img { transform: scale(1.03); }
  .home-dest__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    line-height: 1.2;
    margin-top: var(--space-3);
  }
  .home-dest__country {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--inkSoft);
    margin-top: var(--space-1);
  }
  .home-dest__cta {
    text-align: center;
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
  }
  .home-dest__link {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--burgundy);
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 1px;
  }
  .home-dest__link:hover { color: var(--burgundyDeep); }
  @media (max-width: 640px) {
    .home-feature { min-height: 0; flex-direction: column; align-items: stretch; }
    .home-feature__img { position: relative; height: 260px; }
    .home-feature__inner { margin-top: -3rem; }
    .home-feature__card { max-width: none; }
    .home-dest__grid { grid-template-columns: 1fr; gap: var(--space-6); }
    .home-dest__media { aspect-ratio: 16 / 10; }
  }
  /* ── Variant B feed: asymmetrisch, eerste kaart 2x2 ─────── */
  .feed-grid--b {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .feed-grid--b > :global(.vm-card--featured) { grid-column: span 2; grid-row: span 2; }
  @media (max-width: 1024px) {
    .feed-grid--b { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    .feed-grid--b > :global(.vm-card--featured) { grid-row: span 1; }
  }
  @media (max-width: 640px) {
    .feed-grid--b { grid-template-columns: 1fr !important; }
    .feed-grid--b > :global(.vm-card--featured) { grid-column: auto; }
  }

  /* ── "Net terug"-feed: 4 / 2 / 1 kolommen ─────────────── */
  .feed-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }
  @media (max-width: 1024px) {
    .feed-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .feed-grid { grid-template-columns: 1fr; }
  }

  /* ── Buttons ──────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 1.85rem;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
    cursor: pointer;
  }
  .btn-primary {
    background: var(--burgundy);
    color: var(--fixed-cream);
  }
  .btn-primary:hover { background: var(--burgundyDeep); color: var(--fixed-cream); }
  .btn-ghost {
    background: transparent;
    color: var(--fixed-cream);
    border-color: color-mix(in srgb, var(--fixed-cream) 60%, transparent);
  }
  .btn-ghost:hover {
    background: color-mix(in srgb, var(--fixed-cream) 10%, transparent);
    color: var(--fixed-cream);
    border-color: var(--fixed-cream);
  }
  .btn-outline {
    background: transparent;
    color: var(--burgundy);
    border-color: var(--burgundy);
  }
  .btn-outline:hover { background: var(--burgundy); color: var(--fixed-cream); }
  :global([data-theme='cellar']) .btn-outline {
    background: var(--burgundy);
    color: var(--fixed-cream);
  }
  :global([data-theme='cellar']) .btn-outline:hover { background: var(--burgundyDeep); color: var(--fixed-cream); }
  .btn-gold {
    background: var(--gold);
    color: var(--fixed-ink);
  }
  .btn-gold:hover { background: var(--fixed-cream); color: var(--fixed-ink); }

  /* ── Shared typographic helpers ───────────────────────── */
  .kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rust);
  }

  /* ── Spotlight ───────────────────────────────────────── */
  .spotlight {
    padding: var(--space-20) 0;
    background: var(--paperDeep);
  }
  .spotlight-inner {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-12);
    align-items: center;
  }
  .spotlight-media-link {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paperShade);
  }
  .spotlight-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-image) var(--ease-out);
  }
  .spotlight-placeholder {
    background: linear-gradient(135deg, var(--paperShade), var(--paperDeep));
  }
  .spotlight-media-link:hover .spotlight-img { transform: scale(1.03); }
  .spotlight-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .spotlight-cat {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--burgundy);
  }
  .spotlight-title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.875rem, 1.5vw + 1.5rem, 3rem);
    line-height: 1.08;
    color: var(--ink);
    margin: var(--space-2) 0 var(--space-3);
  }
  .spotlight-title a {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(var(--rust), var(--rust));
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size var(--duration-base) var(--ease-out);
  }
  .spotlight-title a:hover { background-size: 100% 1px; }
  .spotlight-desc {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--inkSoft);
    margin-bottom: var(--space-4);
  }
  .spotlight-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
