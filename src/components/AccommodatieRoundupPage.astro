---
import { gateWineRetail } from '../lib/cta-blocks';
// LAT-2693 — gedeelde accommodatie-roundup per streek. NL-route +
// /en/-tegenhanger renderen dit component; `locale` stuurt de UI-dictionary
// (chrome EN) en de SiteLayout-hreflang. Pagina-inhoud (roundup-tekst) blijft
// NL tot LAT-2687. NL byte-identiek via de NL-defaults van ui.t().
// Interne link-URL's blijven NL-absoluut tot de aparte link-localisatie-pas
// (scope #3), identiek aan StreekDetail/RouteDetail.
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/keuzehulp.css';
import AccommodatieRoundup from '../components/AccommodatieRoundup.astro';
import CtaPrimary from '../components/CtaPrimary.astro';
import CtaComparison from '../components/CtaComparison.astro';
import CtaClosing from '../components/CtaClosing.astro';
import HubBacklink from '../components/HubBacklink.astro';
import { type AccommodatieRoundup as Roundup } from '../lib/accommodaties';
import { type Streek } from '../lib/streken';
import { currencyForLand } from '../lib/currency';
import { organizationSchema, breadcrumbSchema } from '../lib/seo';
import { loadUiStrings } from '../lib/ui-strings';
import { DEFAULT_LOCALE, type Locale, localizeHref } from '../lib/i18n';

interface Props {
  roundup: Roundup;
  streek: Streek | null;
  streekSlug: string;
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { roundup, streek, streekSlug, locale = DEFAULT_LOCALE, alternates } = Astro.props;

// LAT-2704 — interne hrefs locale-aware; NL blijft byte-identiek.
const lh = (href: string) => localizeHref(href, locale);
const ui = await loadUiStrings(locale);
const regio = roundup.regio || streek?.name || streekSlug;
// LAT-1664: bron-valuta volgt het land van de streek (Zuid-Afrika → ZAR); de
// roundup converteert naar EUR voor weergave. Display blijft EUR (board-besluit).
const bronValuta = currencyForLand(streek?.landSlug);

// LAT-1821: aparte 3-CTA-structuur voor de accommodatie-surface (eigen veld
// streken.accom_cta_blocks, pre-geparsed in de loader als accomCta). Andere copy
// dan de streek-CTA. Leeg/ontbrekend → componenten renderen niets.
// LAT-12912: wine-retail alleen op een Tier 1-streek.
const accomCta = gateWineRetail(streek?.accomCta ?? {}, streek?.zelfGereisd === true);

// LAT-1898 — Piemonte-funnel: redactioneel intro-blok 'Slapen in de Langhe'
// (markdown→HTML) VÓÓR de lijst + beknopte planningspassage(s) NÁ de lijst. Beide
// uit de loader (streken.waar_slapen_intro / streken.accom_cta_blocks.planning).
const waarSlapenIntroHtml = streek?.waarSlapenIntroHtml ?? '';
const accomPlanning = streek?.accomPlanning ?? [];

// LAT-13771 — keuzehulp. Opties komen uit precies de kaarten die AccommodatieRoundup
// rendert (clusters met kaarten). Klasse = CMS-tier; die select verschijnt alleen als
// élke kaart in deze streek een tier heeft.
const kaarten = roundup.clusters.filter((c) => c.kaarten.length > 0).flatMap((c) => c.kaarten);
const collator = new Intl.Collator(locale);
const plaatsTelling = new Map<string, number>();
for (const k of kaarten) if (k.plaats) plaatsTelling.set(k.plaats, (plaatsTelling.get(k.plaats) ?? 0) + 1);
const plaatsOpties = [...plaatsTelling.entries()].sort((a, b) => collator.compare(a[0], b[0]));
const toonKlasse = kaarten.length > 0 && kaarten.every((k) => Boolean(k.tier));
const klasseTelling = new Map<string, number>();
if (toonKlasse) for (const k of kaarten) klasseTelling.set(k.tier!, (klasseTelling.get(k.tier!) ?? 0) + 1);
const klasseOpties = [...klasseTelling.entries()];
const totaal = kaarten.length;
const khI18n = {
  een: ui.t('accommodaties.filter.telling.verblijfEen'),
  alle: ui.t('accommodaties.filter.telling.verblijvenAlle'),
  van: ui.t('accommodaties.filter.telling.verblijven'),
  verwijder: ui.t('wijnhuizen.filter.chip.verwijder'),
};
const tellingStart = totaal === 1 ? khI18n.een : khI18n.alle.replace('{n}', String(totaal));
const toonMeerOver = Boolean(waarSlapenIntroHtml) || accomPlanning.length > 0;

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: ui.t('streek.breadcrumb.home'), url: '/' },
    { name: ui.t('accommodaties.breadcrumb.index'), url: '/accommodaties/' },
    { name: regio, url: `/accommodaties/${streekSlug}/` },
  ]),
];
---

<SiteLayout
  title={`${ui.t('accommodaties.roundup.meta.titlePre')}${regio}${ui.t('accommodaties.roundup.meta.titlePost')}`}
  description={`${ui.t('accommodaties.roundup.meta.descPre')}${regio}${ui.t('accommodaties.roundup.meta.descPost')}`}
  ogImage={streek?.ogImage || streek?.heroImage || undefined}
  schema={schema}
  activeNav="accommodaties"
  locale={locale}
  alternates={alternates}
>
  <section class="hero-sm">
    <div class="container">
      <nav class="crumbs" aria-label={ui.t('accommodaties.roundup.crumbsAria')}>
        <a href={lh('/accommodaties/')}>{ui.t('accommodaties.breadcrumb.index')}</a>
        <span aria-hidden="true">/</span>
        <span>{regio}</span>
      </nav>
      <h1>{ui.t('accommodaties.roundup.h1Pre')}{regio}</h1>
      <p class="hero-desc">{ui.t('accommodaties.roundup.heroDesc')}</p>
      {streek && (
        <p class="hero-link"><a href={lh(`/streken/${streek.slug}/`)}>{ui.t('accommodaties.roundup.readGuidePre')}{regio}{ui.t('accommodaties.roundup.readGuidePost')}</a></p>
      )}
    </div>
  </section>

  <div class="container acc-resultaten">
    <div class="acc-keuzehulp" data-kh-root data-i18n={JSON.stringify(khI18n)} data-totaal={totaal} data-track="accommodaties_streek">
      {/* Zelfde CLS-aanpak als /wijnhuizen/ (LAT-12594): server-side zichtbaar, zonder JS verborgen. */}
      <noscript><style is:inline>.wh-filters { display: none !important; }</style></noscript>
      <form class="wh-filters kh-filters--selects" role="search" aria-label={ui.t('accommodaties.filter.label')} data-kh-form>
        <div class="wh-field">
          <label for="acc-plaats">{ui.t('accommodaties.filter.plaats.label')}</label>
          <select id="acc-plaats" name="plaats" data-kh-select>
            <option value="">{ui.t('accommodaties.filter.plaats.alle')}</option>
            {plaatsOpties.map(([plaats, n]) => (
              <option value={plaats} data-label={plaats}>{plaats} ({n})</option>
            ))}
          </select>
        </div>
        {toonKlasse && (
          <div class="wh-field">
            <label for="acc-klasse">{ui.t('accommodaties.filter.klasse.label')}</label>
            <select id="acc-klasse" name="klasse" data-kh-select>
              <option value="">{ui.t('accommodaties.filter.klasse.alle')}</option>
              {klasseOpties.map(([tier, n]) => (
                <option value={tier} data-label={ui.t(`stay.tier.${tier}`)}>{ui.t(`stay.tier.${tier}`)} ({n})</option>
              ))}
            </select>
          </div>
        )}
        <div class="wh-status">
          <p class="wh-telling" data-kh-telling aria-live="polite" aria-atomic="true">{tellingStart}</p>
          <ul class="wh-chips" data-kh-chips aria-label={ui.t('wijnhuizen.filter.actief')}></ul>
          <button type="button" class="wh-wis" data-kh-wis hidden>{ui.t('accommodaties.filter.wis')}</button>
        </div>
      </form>

      <div class="wh-leeg" data-kh-leeg hidden>
        <h2>{ui.t('accommodaties.filter.leeg.titel')}</h2>
        <p>{ui.t('wijnhuizen.filter.leeg.tekst')}</p>
        <div class="wh-leeg-acties">
          <button type="button" data-wh-wis-leeg>{ui.t('accommodaties.filter.wis')}</button>
        </div>
      </div>

      <AccommodatieRoundup roundup={roundup} context={streekSlug} bronValuta={bronValuta} hideHead locale={locale} variant="index" />
    </div>
  </div>

  <div class="container">
    <CtaPrimary data={accomCta.primary} sid={streekSlug} />
  </div>

  {toonMeerOver && (
    <div class="container">
      <section class="acc-meer-over" aria-labelledby="acc-meer-over-titel">
        <h2 id="acc-meer-over-titel" class="acc-meer-over__titel">{ui.t('accommodaties.roundup.meerOver').replace('{regio}', regio)}</h2>
        {waarSlapenIntroHtml && (
          <div class="waar-slapen-intro">
            <div class="waar-slapen-intro__prose" set:html={waarSlapenIntroHtml} />
          </div>
        )}
        {accomPlanning.length > 0 && (
          <section class="accom-planning" aria-label={ui.t('accommodaties.roundup.planningAria')}>
            {accomPlanning.map((block) => (
              <div class="accom-planning__block">
                {block.heading && <h2>{block.heading}</h2>}
                {block.text && <p>{block.text}</p>}
              </div>
            ))}
          </section>
        )}
      </section>
    </div>
  )}

  <div class="container">
    <CtaComparison data={accomCta.comparison} sid={streekSlug} />
    <CtaClosing data={accomCta.closing} sid={streekSlug} />
    <HubBacklink type="accommodatie" slug={streekSlug} locale={locale} />
  </div>
</SiteLayout>

<script>
  // LAT-13771 — keuzehulp (Plaats/Klasse), status in het URL-fragment.
  import { initAlleKeuzehulpen } from '../lib/keuzehulp-client';
  initAlleKeuzehulpen();
</script>

<style>
  /* LAT-13771 — compacte hero: de resultaten moeten boven de vouw beginnen. */
  .hero-sm {
    background: var(--paperDeep);
    padding: var(--space-6) 0 var(--space-5);
    text-align: center;
  }
  .crumbs {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--inkSoft);
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: var(--space-2);
  }
  .crumbs a { color: var(--rust); text-decoration: none; }
  .hero-sm h1 {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 1.5rem + 1vw, 2.375rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.15;
    color: var(--ink);
    margin-top: 0;
  }
  .hero-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--inkSoft);
    margin-top: var(--space-2);
    max-width: 48rem;
    margin-inline: auto;
  }
  .hero-link {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }
  .hero-link a { color: var(--rust); text-decoration: none; }

  /* LAT-13771 — resultaten direct onder de hero; keuzehulp-CSS in src/styles/keuzehulp.css. */
  .acc-resultaten { padding-top: var(--space-5); }
  .acc-keuzehulp :global(.wh-filters) { margin-bottom: var(--space-5); }
  .acc-meer-over { max-width: var(--max-width-narrow); margin: var(--space-10, 2.5rem) auto var(--space-4); }
  .acc-meer-over__titel {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.4rem + 0.8vw, 2rem);
    font-weight: 400;
    color: var(--ink);
    margin: 0 0 var(--space-4);
  }
  @media (max-width: 420px) {
    .hero-sm { padding: var(--space-5) 0 var(--space-4); }
    .hero-sm .hero-desc { font-size: 0.9375rem; }
    .acc-resultaten { padding-top: var(--space-4); }
  }

  /* LAT-1898 — intro-blok 'Slapen in de Langhe' (nu onder "Meer over slapen in …"). */
  .waar-slapen-intro {
    max-width: var(--max-width-narrow);
    margin: 0 auto var(--space-4);
  }
  .waar-slapen-intro__prose {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink);
  }
  .waar-slapen-intro__prose :global(p) { margin-bottom: 1.1rem; }
  .waar-slapen-intro__prose :global(h2) {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 500;
    margin: 0 0 1rem;
  }
  .waar-slapen-intro__prose :global(h3) {
    font-family: var(--font-ui);
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 1.75rem 0 0.5rem;
  }
  .waar-slapen-intro__prose :global(a) { color: var(--rust); }

  /* LAT-1898 — beknopte planningspassage ná de accommodatielijst. */
  .accom-planning {
    max-width: var(--max-width-narrow);
    margin: var(--space-8) auto;
    padding: var(--space-6);
    background: var(--paperDeep);
    border: 1px solid var(--rule);
  }
  .accom-planning__block + .accom-planning__block { margin-top: var(--space-5); }
  .accom-planning__block h2 {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0 0 0.5rem;
  }
  .accom-planning__block p {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--inkSoft);
    margin: 0;
  }
</style>
