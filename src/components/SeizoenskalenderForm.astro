---
// LAT-3209 / LAT-12309: seizoenskalender-landingspagina; aanmelden gaat via Substack.
import SubstackCta from './SubstackCta.astro';
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import { loadUiStrings } from '../lib/ui-strings';

interface Props {
  /** Kop boven het formulier. Uit Directus; leeg = geen kop. */
  heading?: string;
  locale?: Locale;
}

const { heading = '', locale = DEFAULT_LOCALE } = Astro.props;
const ui = await loadUiStrings(locale);
---

<section class="sk-form" aria-labelledby={heading ? 'sk-form-heading' : undefined}>
  {heading && <h2 id="sk-form-heading">{heading}</h2>}
  <p class="sk-form__lede">{ui.t('newsletter.footer.lede')}</p>

  <div class="sk-form__form">
    <SubstackCta placement="seizoenskalender" ctaId="seizoenskalender_signup" label={ui.t('newsletter.footer.submit')} />
  </div>

  <p class="sk-form__fineprint">{ui.t('newsletter.footer.fineprint')}</p>
</section>

<style>
  .sk-form {
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    max-width: 620px;
    border: 1px solid var(--color-rule, #c9b98f);
    background: var(--color-bg-soft, var(--color-bg, #fff));
  }
  .sk-form h2 {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.5vw + 0.5rem, 1.875rem);
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
    line-height: 1.1;
  }
  .sk-form__lede {
    font-family: var(--font-serif, var(--font-body));
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-soft, var(--color-text));
    margin: 0.9rem 0 0;
  }
  .sk-form__form {
    margin: 1.5rem 0 0;
  }
  .sk-form__fineprint {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-text-faint, var(--color-text-soft, var(--color-text)));
    margin: 1rem 0 0;
  }

</style>
