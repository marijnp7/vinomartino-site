---
// LAT-12710 — slaapoverzicht: vergelijkingskaarten (naam, dorp, type, waarom in één zin,
// boek-knop) met optioneel label "Hier sliepen wij" en één disclosure-regel onder het blok.
import RouteStayCard from './RouteStayCard.astro';
import OverviewIcon from './OverviewIcon.astro';
import { type PaginaSlaap } from '../lib/route-pagina';
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import { loadUiStrings } from '../lib/ui-strings';

interface Props {
  kop?: string | null;
  intro?: string | null;
  items: PaginaSlaap[];
  disclosureHtml?: string;
  context: string;
  id?: string;
  locale?: Locale;
}
const { kop, intro, items, disclosureHtml = '', context, id = 'slapen', locale = DEFAULT_LOCALE } = Astro.props;
const ui = await loadUiStrings(locale);
const disclosure = disclosureHtml || `<p>${ui.t('stay.disclosure.microcopy')}</p>`;
---

{items.length > 0 && (
  <section class="rslaap" id={id}>
    {kop && <h2 class="rslaap__kop">{kop}</h2>}
    {intro && <p class="rslaap__intro">{intro}</p>}
    {items.filter((it) => it.label).length > 1 && (
      <nav class="rslaap__choices" aria-label={kop ?? undefined}>
        {items.map((it, i) => <a href={`#${id}-stay-${i + 1}`}>
          <span>{it.icon && <OverviewIcon name={it.icon} />}{it.label ?? it.naam}<span aria-hidden="true">↘</span></span>
          <small>{it.naam}</small>
        </a>)}
      </nav>
    )}
    <div class="rslaap__grid">
      {items.map((it, i) => <RouteStayCard stay={it} context={context} locale={locale} id={`${id}-stay-${i + 1}`} placement="route-slaapoverzicht" />)}
    </div>
    <div class="rslaap__disclosure" set:html={disclosure} />
  </section>
)}

<style>
  .rslaap { margin: var(--space-12) 0; scroll-margin-top: var(--space-6); }
  .rslaap__kop { font-family: var(--font-display); font-size: 1.75rem; font-weight: 500; margin: 0 0 var(--space-3); }
  .rslaap__intro { font-family: var(--font-body); color: var(--inkSoft); line-height: 1.6; margin: 0 0 var(--space-5); max-width: var(--article-body-max); }
  .rslaap__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-4);
    align-items: stretch;
  }
  .rslaap__grid > :global(*) { min-width: 0; }
  .rslaap__choices { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); margin: 1.5rem 0 2rem; border: 1px solid var(--rule); }
  .rslaap__choices a { padding: 1rem; color: var(--ink); text-decoration: none; border: 1px solid var(--ruleSoft); }
  .rslaap__choices a:hover { background: var(--paperDeep); }
  .rslaap__choices a:focus-visible { outline: 2px solid var(--burgundyInk); outline-offset: -3px; }
  .rslaap__choices a > span { display: flex; align-items: center; gap: 0.6rem; color: var(--burgundyInk); font-family: var(--font-ui); font-size: 0.875rem; font-weight: 600; }
  .rslaap__choices a > span > span { margin-left: auto; }
  .rslaap__choices :global(svg) { flex-shrink: 0; }
  .rslaap__choices small { display: block; margin-top: 0.5rem; font-family: var(--font-body); font-size: 1rem; }
  .rslaap__disclosure { margin-top: var(--space-4); }
  .rslaap__disclosure :global(p) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.5;
    letter-spacing: 0.03em;
    color: var(--inkFaint);
    margin: 0;
  }
</style>
