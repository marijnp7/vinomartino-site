---
// LAT-12710 — slaapoverzicht: vergelijkingskaarten (naam, dorp, type, waarom in één zin,
// boek-knop) met optioneel label "Hier sliepen wij" en één disclosure-regel onder het blok.
import PoiCard from './PoiCard.astro';
import { routeStayAnchor, stayNaamKey, type StayRecord } from '../lib/stay-tier';
import { type PaginaSlaap } from '../lib/route-pagina';
import { accommodatieBookingDeeplink } from '../lib/affiliates';
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import { loadUiStrings } from '../lib/ui-strings';

interface Props {
  kop?: string | null;
  intro?: string | null;
  items: PaginaSlaap[];
  disclosureHtml?: string;
  context: string;
  id?: string;
  locale?: Locale;
  /** LAT-14550/14556: accommodations-record (tier, beeld) per verblijfsnaam (stayNaamKey). */
  stayRecords?: Record<string, StayRecord>;
  /** LAT-14556: adressen die al als volle kaart bij een dag staan → compacte verwijzing. */
  eersteNacht?: Record<string, number>;
}
const { kop, intro, items, disclosureHtml = '', context, id = 'slapen', locale = DEFAULT_LOCALE, stayRecords = {}, eersteNacht = {} } = Astro.props;
// LAT-14556: hetzelfde adres twee keer in het overzicht → één kaart.
const gezien = new Set<string>();
const uniek = items.filter((it) => { const k = stayNaamKey(it.naam); if (gezien.has(k)) return false; gezien.add(k); return true; });
// LAT-14556 (herkeuring 23-10): een verwijzing ("Zelfde adres als nacht N") is geen kaart. In het
// kaartraster rekte hij op tot een lege tegel op rijhoogte; daarom een compacte lijst ónder het raster.
const vol = uniek.filter((it) => eersteNacht[stayNaamKey(it.naam)] == null);
const refs = uniek.filter((it) => eersteNacht[stayNaamKey(it.naam)] != null);
const ui = await loadUiStrings(locale);
const disclosure = disclosureHtml || `<p>${ui.t('stay.disclosure.microcopy')}</p>`;
---

{uniek.length > 0 && (
  <section class="rslaap" id={id}>
    {kop && <h2 class="rslaap__kop">{kop}</h2>}
    {intro && <p class="rslaap__intro">{intro}</p>}
    {vol.length > 0 && (
    <div class="rslaap__grid">
      {vol.map((it) => {
        const href = accommodatieBookingDeeplink(it.naam, '', it.bookingUrl, `route-${context}`, locale);
        // LAT-13527: een Booking-zoekopdracht (searchresults) is geen hotelpagina; de knop zegt dat eerlijk.
        const zoek = /searchresults/i.test(href);
        // LAT-14550: staat het adres in de gecureerde selectie, dan het tierlabel als badge;
        // het redactielabel (bv. "Goede basis") schuift naar de meta-regel.
        const key = stayNaamKey(it.naam);
        const rec = stayRecords[key] ?? null;
        const tier = rec?.tier ?? null;
        const recFoto = rec?.foto ?? null;
        const nacht = eersteNacht[key];
        const meta = [it.plaats, it.type].filter(Boolean).join(' · ');
        return (
        <PoiCard
          locale={locale}
          poi={{
            naam: it.naam,
            routeStay: key,
            accRecord: Boolean(rec),
            accRecordFoto: Boolean(rec?.foto),
            cardId: nacht != null ? undefined : routeStayAnchor(key),
            verwijzing: nacht != null ? { tekst: ui.t('route.stay.zelfdeAdres').replace('{n}', String(nacht)), href: `#${routeStayAnchor(key)}` } : null,
            foto: recFoto ?? it.foto,
            fotoId: recFoto ? null : it.fotoId,
            fotoAlt: recFoto ? rec?.fotoAlt ?? null : null,
            hideMediaWhenEmpty: false,
            tier,
            badge: tier ? null : it.label ?? meta,
            beschrijving: tier ? [it.label, meta].filter(Boolean).join(' · ') || null : it.label ? meta : null,
            whyRegel: it.why,
            boeklink: href,
            cta: ui.t(zoek ? 'route.cta.zoekBooking' : 'streekkaart.cta.overnachten'),
            ctaKey: zoek ? 'zoek-booking' : 'bekijk-boek',
            partner: 'booking',
            placement: 'route-slaapoverzicht',
            context: `route-${context}`,
          }}
        />
        );
      })}
    </div>
    )}
    {refs.length > 0 && (
    <div class="rslaap__refs">
      {refs.map((it) => {
        const key = stayNaamKey(it.naam);
        return (
        <PoiCard
          locale={locale}
          poi={{
            naam: it.naam,
            routeStay: key,
            verwijzing: { tekst: ui.t('route.stay.zelfdeAdres').replace('{n}', String(eersteNacht[key])), href: `#${routeStayAnchor(key)}` },
          }}
        />
        );
      })}
    </div>
    )}
    <div class="rslaap__disclosure" set:html={disclosure} />
  </section>
)}

<style>
  .rslaap { margin: var(--space-12) 0; scroll-margin-top: var(--space-6); }
  .rslaap__kop { font-family: var(--font-display); font-size: 1.75rem; font-weight: 500; margin: 0 0 var(--space-3); }
  .rslaap__intro { font-family: var(--font-body); color: var(--inkSoft); line-height: 1.6; margin: 0 0 var(--space-5); max-width: var(--article-body-max); }
  .rslaap__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-4);
    align-items: stretch;
  }
  .rslaap__grid > :global(*) { min-width: 0; }
  .rslaap__refs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-2) var(--space-4);
    align-items: start;
    margin-top: var(--space-4);
  }
  .rslaap__refs > :global(*) { min-width: 0; }
  .rslaap__disclosure { margin-top: var(--space-4); }
  .rslaap__disclosure :global(p) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.5;
    letter-spacing: 0.03em;
    color: var(--inkFaint);
    margin: 0;
  }
</style>
