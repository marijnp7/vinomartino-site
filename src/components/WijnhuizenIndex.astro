---
// LAT-2693 — gedeeld wijnhuizen-overzicht (listing-index). NL-route
// (src/pages/wijnhuizen/index.astro) + /en/-tegenhanger renderen dit component;
// `locale` stuurt de loader (no-translation-guard) en de UI-dictionary. NL is
// byte-identiek via de NL-defaults in UI_STRING_DEFAULTS.
import SiteLayout from '../layouts/SiteLayout.astro';
import SmartImg from '../components/SmartImg.astro';
import { loadWijnhuizen } from '../lib/wijnhuizen';
import { organizationSchema, breadcrumbSchema } from '../lib/seo';
import { loadUiStrings } from '../lib/ui-strings';
import { DEFAULT_LOCALE, localizePath, type Locale } from '../lib/i18n';
import { loadStrekenNav } from '../lib/streken';
import { loadLandenNav } from '../lib/landen';
import { loadRoutes } from '../lib/routes';
import { foldText, canonicalDruif, druifZoektermen, type DruifRef } from '../lib/wijnhuis-filter';

interface Props {
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale = DEFAULT_LOCALE, alternates } = Astro.props;
const ui = await loadUiStrings(locale);

const entries = await loadWijnhuizen(locale);

// LAT-13075 — keuzehulp. Land komt uit de CMS-relatie wijnhuis → streek → land
// (zelfde lichte loaders als de header); geen land afgeleid uit tekst.
const [strekenNav, landenNav, routes] = await Promise.all([
  loadStrekenNav(locale), loadLandenNav(locale), loadRoutes(locale).catch(() => []),
]);
const landBySlug = new Map(landenNav.map((l) => [l.slug, l.name]));
const landSlugByStreek = new Map(strekenNav.map((s) => [s.slug, s.landSlug]));
const streekNaamBySlug = new Map(strekenNav.map((s) => [s.slug, s.name]));
const routeSlugs = new Set(routes.map((r) => r.slug));

const cards = entries.map((e) => {
  const landSlug = (e.streekSlug && landSlugByStreek.get(e.streekSlug)) || '';
  const land = (landSlug && landBySlug.get(landSlug)) || e.country || '';
  const streek = (e.streekSlug && streekNaamBySlug.get(e.streekSlug)) || e.region;
  // Volledige CMS-druivenlijst (niet de eerste drie kaarttags), plus portretdruiven.
  const namen = [...e.grapes, ...e.portret.druiven.map((d) => d.naam)].filter(Boolean);
  const druiven: (DruifRef & { naam: string })[] = [];
  const seen = new Set<string>();
  for (const n of namen) {
    const ref = canonicalDruif(n);
    if (seen.has(ref.id)) continue;
    seen.add(ref.id);
    druiven.push({ ...ref, naam: n });
  }
  const zoek = foldText([e.name, streek, e.region, land, landSlug, e.streekSlug, e.address, e.winemaker, ...namen.flatMap(druifZoektermen)].join(' '));
  const route = e.portret.routeSlugs.find((r) => routeSlugs.has(r)) || null;
  return { e, landSlug, land, streek, druiven, zoek, route };
});

// Bestemmingen: land → streken, met aantallen; alleen wat echt gekoppeld is.
const landen = new Map<string, { naam: string; n: number; streken: Map<string, { naam: string; n: number }> }>();
for (const c of cards) {
  if (!c.landSlug) continue;
  const l = landen.get(c.landSlug) ?? { naam: c.land, n: 0, streken: new Map() };
  l.n++;
  if (c.e.streekSlug) {
    const st = l.streken.get(c.e.streekSlug) ?? { naam: c.streek, n: 0 };
    st.n++;
    l.streken.set(c.e.streekSlug, st);
  }
  landen.set(c.landSlug, l);
}
const collator = new Intl.Collator(locale);
const landOpties = [...landen.entries()].sort((a, b) => collator.compare(a[1].naam, b[1].naam));
// Streken zonder land-relatie in het CMS (bv. Kakheti) blijven kiesbaar in een
// neutrale groep; we verzinnen geen land.
const losseStreken = new Map<string, { naam: string; n: number }>();
for (const c of cards) {
  if (c.landSlug || !c.e.streekSlug) continue;
  const st = losseStreken.get(c.e.streekSlug) ?? { naam: c.streek, n: 0 };
  st.n++;
  losseStreken.set(c.e.streekSlug, st);
}
const druifTelling = new Map<string, { label: string; n: number }>();
for (const c of cards) for (const d of c.druiven) {
  const t = druifTelling.get(d.id) ?? { label: d.label, n: 0 };
  t.n++;
  druifTelling.set(d.id, t);
}
const druifOpties = [...druifTelling.entries()].sort((a, b) => collator.compare(a[1].label, b[1].label));
const zonderDruif = cards.filter((c) => c.druiven.length === 0).length;
const i18n = {
  een: ui.t('wijnhuizen.filter.telling.een'),
  meer: ui.t('wijnhuizen.filter.telling.meer'),
  van: ui.t('wijnhuizen.filter.telling.van'),
  verwijder: ui.t('wijnhuizen.filter.chip.verwijder'),
  zoekOveral: ui.t('wijnhuizen.filter.leeg.zoekOveral'),
  zoek: ui.t('wijnhuizen.filter.zoek.label'),
  bestemming: ui.t('wijnhuizen.filter.bestemming.label'),
  druif: ui.t('wijnhuizen.filter.druif.label'),
};

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: ui.t('streek.breadcrumb.home'), url: localizePath('/', locale) },
    { name: ui.t('wijnhuis.breadcrumb.index'), url: localizePath('/wijnhuizen/', locale) },
  ]),
];
---

<SiteLayout
  title={ui.t('wijnhuizen.index.meta.title')}
  description={ui.t('wijnhuizen.index.meta.description')}
  schema={schema}
  activeNav="wijnhuizen"
  locale={locale}
  alternates={alternates}
>
  <section class="hero-sm">
    <div class="container">
      <span class="section-label">{ui.t('wijnhuizen.index.hero.label')}</span>
      <h1 set:html={ui.t('wijnhuizen.index.hero.h1')} />
      <p class="hero-desc">{ui.t('wijnhuizen.index.hero.desc')}</p>
    </div>
  </section>

  <section class="section container">
    {entries.length > 0 ? (
      <div class="wh-keuzehulp" data-wh-root data-i18n={JSON.stringify(i18n)} data-totaal={cards.length}>
        <form class="wh-filters" role="search" aria-label={ui.t('wijnhuizen.filter.label')} hidden data-wh-form>
          <div class="wh-field wh-field-zoek">
            <label for="wh-zoek">{ui.t('wijnhuizen.filter.zoek.label')}</label>
            <input id="wh-zoek" name="q" type="search" autocomplete="off" enterkeyhint="search" placeholder={ui.t('wijnhuizen.filter.zoek.placeholder')} />
          </div>
          <div class="wh-field">
            <label for="wh-bestemming">{ui.t('wijnhuizen.filter.bestemming.label')}</label>
            <select id="wh-bestemming" name="bestemming">
              <option value="">{ui.t('wijnhuizen.filter.bestemming.alle')}</option>
              {landOpties.map(([slug, l]) => (
                <optgroup label={l.naam}>
                  <option value={`land:${slug}`} data-label={l.naam} data-base={ui.t('wijnhuizen.filter.land.alle').replace('{land}', l.naam)}>{ui.t('wijnhuizen.filter.land.alle').replace('{land}', l.naam)} ({l.n})</option>
                  {[...l.streken.entries()].sort((a, b) => collator.compare(a[1].naam, b[1].naam)).map(([ss, st]) => (
                    <option value={`streek:${ss}`} data-label={st.naam} data-base={st.naam}>{st.naam} ({st.n})</option>
                  ))}
                </optgroup>
              ))}
              {losseStreken.size > 0 && (
                <optgroup label={ui.t('wijnhuizen.filter.overigeStreken')}>
                  {[...losseStreken.entries()].sort((a, b) => collator.compare(a[1].naam, b[1].naam)).map(([ss, st]) => (
                    <option value={`streek:${ss}`} data-label={st.naam} data-base={st.naam}>{st.naam} ({st.n})</option>
                  ))}
                </optgroup>
              )}
            </select>
          </div>
          <details class="wh-meer" data-wh-meer>
            <summary>{ui.t('wijnhuizen.filter.meer')} <span class="wh-meer-n" data-wh-meer-n hidden></span></summary>
            <div class="wh-field">
              <label for="wh-druif">{ui.t('wijnhuizen.filter.druif.label')}</label>
              <select id="wh-druif" name="druif">
                <option value="">{ui.t('wijnhuizen.filter.druif.alle')}</option>
                {druifOpties.map(([id, d]) => (
                  <option value={id} data-label={d.label} data-base={d.label}>{d.label} ({d.n})</option>
                ))}
              </select>
            </div>
          </details>
          <div class="wh-status">
            <p class="wh-telling" data-wh-telling aria-live="polite" aria-atomic="true"></p>
            <ul class="wh-chips" data-wh-chips aria-label={ui.t('wijnhuizen.filter.actief')}></ul>
            <button type="button" class="wh-wis" data-wh-wis hidden>{ui.t('wijnhuizen.filter.wis')}</button>
          </div>
        </form>

        <div class="wh-leeg" data-wh-leeg hidden>
          <h2>{ui.t('wijnhuizen.filter.leeg.titel')}</h2>
          <p>{ui.t('wijnhuizen.filter.leeg.tekst')}{zonderDruif > 0 && ` ${ui.t('wijnhuizen.filter.leeg.zonderDruif').replace('{n}', String(zonderDruif))}`}</p>
          <div class="wh-leeg-acties">
            <button type="button" data-wh-overal hidden></button>
            <button type="button" data-wh-wis-leeg>{ui.t('wijnhuizen.filter.wis')}</button>
          </div>
        </div>

        <div class="grid" data-wh-grid>
          {cards.map(({ e, landSlug, land, streek, druiven, zoek, route }) => (
            <article class="card wh-card" data-wh-card data-zoek={zoek} data-streek={e.streekSlug} data-land={landSlug} data-druiven={druiven.map((d) => d.id).join(' ')}>
              <div class="card-img-wrap">
                <SmartImg src={e.heroImage || undefined} alt={e.name} theme="winery" class="card-img" />
              </div>
              <div class="card-body">
                <span class="card-region">{[streek, land].filter(Boolean).join(', ')}</span>
                <h2 class="card-title"><a href={localizePath(`/wijnhuizen/${e.slug}/`, locale)} class="wh-portret" data-wh-portret>{e.name}</a></h2>
                {e.description && <p class="card-desc">{e.description}</p>}
                {druiven.length > 0 ? (
                  <ul class="card-tags" aria-label={ui.t('wijnhuizen.filter.druif.label')}>
                    {druiven.map((d) => (
                      <li><button type="button" class="tag wh-tag" data-wh-druif={d.id} aria-label={ui.t('wijnhuizen.card.druifFilter').replace('{druif}', d.label)}>{d.naam}</button></li>
                    ))}
                  </ul>
                ) : (
                  <p class="wh-onbekend">{ui.t('wijnhuizen.card.druivenOnbekend')}</p>
                )}
                <p class="wh-meta">
                    {e.portret.bezoekType
                      ? <span>{ui.t('wijnhuis.bezoek.eyebrow')}: {ui.t(`wijnhuis.bezoek.${e.portret.bezoekType}`)}</span>
                      : <span class="wh-onbekend">{ui.t('wijnhuizen.card.bezoekOnbekend')}</span>}
                    {route && <a href={localizePath(`/wijnroutes/${route}/`, locale)} class="wh-route" data-wh-route>{ui.t('wijnhuis.cta.route')}</a>}
                  </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    ) : (
      <div class="empty-state">
        <h2>{ui.t('wijnhuizen.index.empty.title')}</h2>
        <p>{ui.t('wijnhuizen.index.empty.descPre')}<a href={localizePath('/artikelen/', locale)}>{ui.t('wijnhuizen.index.empty.descLink')}</a>{ui.t('wijnhuizen.index.empty.descPost')}</p>
      </div>
    )}
  </section>
</SiteLayout>

<script>
  // LAT-13075 — keuzehulp. Filtert de statisch gerenderde kaarten; status leeft in het
  // URL-fragment (#q=…&bestemming=…&druif=…): deelbaar, niet indexeerbaar, en via
  // replaceState zodat "terug" naar de vorige pagina gaat met selectie en scroll intact.
  import { trackEvent } from '../lib/site-events';

  const root = document.querySelector<HTMLElement>('[data-wh-root]');
  if (root) {
    const t = JSON.parse(root.dataset.i18n || '{}') as Record<string, string>;
    const totaal = Number(root.dataset.totaal || 0);
    const form = root.querySelector<HTMLFormElement>('[data-wh-form]')!;
    const zoek = form.querySelector<HTMLInputElement>('#wh-zoek')!;
    const best = form.querySelector<HTMLSelectElement>('#wh-bestemming')!;
    const druif = form.querySelector<HTMLSelectElement>('#wh-druif')!;
    const meer = form.querySelector<HTMLDetailsElement>('[data-wh-meer]')!;
    const meerN = form.querySelector<HTMLElement>('[data-wh-meer-n]')!;
    const telling = form.querySelector<HTMLElement>('[data-wh-telling]')!;
    const chips = form.querySelector<HTMLElement>('[data-wh-chips]')!;
    const wis = form.querySelector<HTMLButtonElement>('[data-wh-wis]')!;
    const leeg = root.querySelector<HTMLElement>('[data-wh-leeg]')!;
    const overal = leeg.querySelector<HTMLButtonElement>('[data-wh-overal]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-wh-card]')];
    const scrollKey = `wh-scroll:${location.pathname}`;

    const fold = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()
      .replace(/ß/g, 'ss').replace(/['’`]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
    const optLabel = (sel: HTMLSelectElement) => sel.selectedOptions[0]?.dataset.label || '';
    const hasOption = (sel: HTMLSelectElement, v: string) => [...sel.options].some((o) => o.value === v);

    form.hidden = false;
    const desktop = window.matchMedia('(min-width: 721px)');
    const syncMeer = () => { if (desktop.matches) meer.open = true; };
    syncMeer();
    desktop.addEventListener('change', syncMeer);

    const matches = (c: HTMLElement, q: string[], b: string, d: string) => {
      if (b) {
        const [kind, slug] = b.split(':');
        if ((kind === 'land' ? c.dataset.land : c.dataset.streek) !== slug) return false;
      }
      if (d && !(c.dataset.druiven || '').split(' ').includes(d)) return false;
      const hay = c.dataset.zoek || '';
      return q.every((w) => hay.includes(w));
    };

    const updateOptionCounts = (q: string[]) => {
      for (const o of best.options) {
        if (!o.value) continue;
        const n = cards.filter((c) => matches(c, q, o.value, druif.value)).length;
        o.textContent = `${o.value.startsWith('land:') ? o.textContent!.replace(/ \(\d+\)$/, '') : o.dataset.label} (${n})`;
      }
      for (const o of druif.options) {
        if (!o.value) continue;
        const n = cards.filter((c) => matches(c, q, best.value, o.value)).length;
        o.textContent = `${o.dataset.base} (${n})`;
      }
    };

    const chip = (label: string, onRemove: () => void) => {
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = `${label} ×`;
      btn.setAttribute('aria-label', `${t.verwijder}: ${label}`);
      btn.addEventListener('click', () => { onRemove(); apply(true); zoek.focus(); });
      li.append(btn);
      return li;
    };

    function apply(push = false) {
      const raw = zoek.value.trim();
      const q = fold(raw).split(' ').filter(Boolean);
      const b = best.value, d = druif.value;
      let n = 0;
      for (const c of cards) { const ok = matches(c, q, b, d); c.hidden = !ok; if (ok) n++; }
      updateOptionCounts(q);
      const actief = (q.length ? 1 : 0) + (b ? 1 : 0) + (d ? 1 : 0);
      telling.textContent = actief === 0
        ? (totaal === 1 ? t.een : t.meer.replace('{n}', String(totaal)))
        : t.van.replace('{n}', String(n)).replace('{totaal}', String(totaal));
      chips.replaceChildren(
        ...(raw ? [chip(`${t.zoek}: ${raw}`, () => { zoek.value = ''; })] : []),
        ...(b ? [chip(optLabel(best), () => { best.value = ''; })] : []),
        ...(d ? [chip(optLabel(druif), () => { druif.value = ''; })] : []),
      );
      wis.hidden = actief === 0;
      meerN.hidden = !d;
      meerN.textContent = d ? '1' : '';
      for (const tag of root!.querySelectorAll<HTMLElement>('[data-wh-druif]')) {
        tag.setAttribute('aria-pressed', String(tag.dataset.whDruif === d));
      }
      leeg.hidden = n > 0;
      // Alleen een uitweg tonen die zelf resultaat geeft.
      overal.hidden = !(raw && (b || d) && cards.some((c) => matches(c, q, '', '')));
      overal.textContent = t.zoekOveral.replace('{q}', raw);
      const params = new URLSearchParams();
      if (raw) params.set('q', raw);
      if (b) params.set('bestemming', b);
      if (d) params.set('druif', d);
      const hash = params.toString();
      if (push || hash !== location.hash.slice(1)) {
        history.replaceState(history.state, '', hash ? `#${hash}` : location.pathname + location.search);
      }
    }

    const readHash = () => {
      const p = new URLSearchParams(location.hash.slice(1));
      zoek.value = p.get('q') || '';
      const b = p.get('bestemming') || '', d = p.get('druif') || '';
      best.value = hasOption(best, b) ? b : '';
      druif.value = hasOption(druif, d) ? d : '';
      if (druif.value && !desktop.matches) meer.open = true;
    };

    readHash();
    apply();

    let zoekTimer: number | undefined;
    zoek.addEventListener('input', () => {
      apply();
      window.clearTimeout(zoekTimer);
      zoekTimer = window.setTimeout(() => { if (zoek.value.trim()) trackEvent('cta_click', { cta_id: 'wijnhuizen_zoek' }); }, 1500);
    });
    best.addEventListener('change', () => { apply(); if (best.value) trackEvent('cta_click', { cta_id: `wijnhuizen_bestemming:${best.value}` }); });
    druif.addEventListener('change', () => { apply(); if (druif.value) trackEvent('cta_click', { cta_id: `wijnhuizen_druif:${druif.value}` }); });
    form.addEventListener('submit', (ev) => { ev.preventDefault(); zoek.blur(); });
    const wisAlles = () => { zoek.value = ''; best.value = ''; druif.value = ''; apply(true); zoek.focus(); };
    wis.addEventListener('click', wisAlles);
    leeg.querySelector('[data-wh-wis-leeg]')!.addEventListener('click', wisAlles);
    overal.addEventListener('click', () => { best.value = ''; druif.value = ''; apply(true); zoek.focus(); });
    window.addEventListener('hashchange', () => { readHash(); apply(); });

    root.addEventListener('click', (ev) => {
      const target = ev.target as HTMLElement;
      const tag = target.closest<HTMLElement>('[data-wh-druif]');
      if (tag) {
        const id = tag.dataset.whDruif || '';
        druif.value = druif.value === id ? '' : id;
        apply(true);
        if (druif.value) trackEvent('cta_click', { cta_id: `wijnhuizen_druiftag:${id}` });
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
      if (target.closest('[data-wh-portret]')) trackEvent('cta_click', { cta_id: 'wijnhuizen_portret' });
      if (target.closest('[data-wh-route]')) trackEvent('cta_click', { cta_id: 'wijnhuizen_route' });
    });

    // Scrollpositie bij terugkeren (ook zonder bfcache): opslaan bij verlaten, herstellen bij back/forward.
    window.addEventListener('pagehide', () => sessionStorage.setItem(scrollKey, String(window.scrollY)));
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    const saved = Number(sessionStorage.getItem(scrollKey));
    if (nav?.type === 'back_forward' && saved > 0) requestAnimationFrame(() => window.scrollTo(0, saved));
  }
</script>

<style>
  .hero-sm {
    background: var(--paperDeep);
    padding: var(--space-12) 0 var(--space-8);
    text-align: center;
  }
  .hero-sm h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 1.5vw, 3rem);
    font-weight: 400;
    font-style: italic;
    color: var(--ink);
    margin-top: var(--space-3);
  }
  .hero-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--inkSoft);
    margin-top: var(--space-3);
    max-width: 36rem;
    margin-inline: auto;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }
  /* LAT-1118 (M5-hardening): voorkom horizontale overflow op smalle telefoons
     (<=360px Android / 320px iPhone SE) waar de track de viewport overschrijdt. */
  @media (max-width: 420px) {
    .grid { grid-template-columns: 1fr; }
  }
  /* LAT-13075 — kaart is een <article>; de titellink is uitgerekt over de kaart
     (geen geneste links), druiftags en routelink liggen erboven als eigen doelen. */
  .wh-card { position: relative; }
  .wh-portret { color: inherit; text-decoration: none; }
  .wh-portret::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .wh-portret:focus-visible { outline: none; }
  .wh-card:has(.wh-portret:focus-visible) { outline: 2px solid var(--rust); outline-offset: 3px; }
  .wh-tag, .wh-route { position: relative; z-index: 2; }
  .wh-tag { border: 1px solid transparent; cursor: pointer; min-height: 32px; }
  .wh-tag:hover, .wh-tag[aria-pressed='true'] { border-color: var(--rust); color: var(--rust); }
  .wh-tag:focus-visible, .wh-route:focus-visible, .wh-filters :focus-visible, .wh-leeg button:focus-visible { outline: 2px solid var(--rust); outline-offset: 2px; }
  .card-tags { list-style: none; margin: 0; padding: 0; }
  .wh-onbekend { font-size: 0.8125rem; color: var(--inkSoft); font-style: italic; margin: 0; }
  .wh-meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; margin: var(--space-3) 0 0; font-size: 0.8125rem; color: var(--inkSoft); }
  .wh-route { color: var(--rust); text-decoration: underline; text-underline-offset: 3px; padding: 0.25rem 0; }
  .wh-filters {
    display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-4); align-items: end; margin-bottom: var(--space-8);
    padding-bottom: var(--space-6); border-bottom: 1px solid var(--paperShade);
  }
  .wh-filters[hidden] { display: none; }
