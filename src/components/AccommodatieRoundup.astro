---
import { plaatsKort } from '../lib/plaats-kort';
// LAT-1332 — Per-regio accommodatie-roundup (reisjunk-model, EPIC LAT-1330).
// Sprong-navigatie (pills per sub-bestemming) + sectie-headers
// "LEUKE HOTELS IN [PLAATS]" + responsive kaart-grid + disclosure-blok.
// VinoMartino-huisstijl op tokens.css (DESIGN_SPECS.md / LAT-784).

import type { AccommodatieRoundup } from '../lib/accommodaties';
import AccommodatieKaart from './AccommodatieKaart.astro';
import StayTierIcon from './StayTierIcon.astro';
import { STAY_TIER_ORDER } from '../lib/stay-tier';
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import { loadUiStrings } from '../lib/ui-strings';

interface Props {
  roundup: AccommodatieRoundup;
  /** Context-slug voor affiliate-tracking, bv. de regio-slug. */
  context?: string;
  /** LAT-2575: NL byte-identiek op DEFAULT_LOCALE; /en/ geeft "en" mee. */
  locale?: Locale;
  /**
   * Onderdruk de eigen kop/intro wanneer de pagina al een hero met dezelfde
   * boodschap levert (bv. de dedicated /accommodaties/<streek>/-pagina), om
   * dubbele koppen te voorkomen. Sprong-nav, groepen en disclosure blijven.
   */
  hideHead?: boolean;
  /** Bron-valuta van de prijzen (bv. 'ZAR' voor Zuid-Afrika). Leeg = EUR (LAT-1664). */
  bronValuta?: string | null;
  /** Display-valuta; default EUR. Hook voor een latere valuta-switcher (LAT-1664). */
  displayValuta?: string;
  /**
   * LAT-13771: 'index' = platte resultatengrid voor /accommodaties/<streek>/ met
   * compacte kaarten en data-plaats/data-klasse voor de keuzehulp; zonder
   * sprong-nav en groepskoppen. 'default' groepeert de kaarten per CMS-categorie binnen elk cluster.
   */
  variant?: 'default' | 'index';
}

const { roundup, context, hideHead = false, bronValuta, displayValuta = 'EUR', locale = DEFAULT_LOCALE, variant = 'default' } = Astro.props;
const ui = await loadUiStrings(locale);

// Alleen clusters met daadwerkelijke kaarten tonen (LAT-1406).
const groepen = roundup.clusters.filter((c) => c.kaarten.length > 0);
const heeftNav = groepen.length > 1;
const sectionId = `acc-roundup-${(context || roundup.regio).toLowerCase().replace(/[^a-z0-9-]/gi, '-')}`;
const isIndex = variant === 'index';
// LAT-13771 — platte lijst in dezelfde volgorde als de groepen; de klasse is de CMS-tier.
const platteKaarten = isIndex ? groepen.flatMap((g) => g.kaarten) : [];
const categorieGroepen = groepen.map((groep) => ({
  ...groep,
  categorieen: STAY_TIER_ORDER.map((tier) => ({
    tier,
    kaarten: groep.kaarten.filter((kaart) => kaart.tier === tier),
    id: `${sectionId}-${groep.slug}-${tier}`,
    label: ui.t(`stay.tier.${tier}`),
    description: ui.t(`stay.tier.${tier}.description`),
  })).filter((categorie) => categorie.kaarten.length > 0),
  // Unclassified records remain visible without inventing a category.
  overig: groep.kaarten.filter((kaart) => !STAY_TIER_ORDER.includes(kaart.tier!)),
}));
---

{groepen.length > 0 && (
  <section
    class:list={['acc-roundup', { 'acc-roundup--headless': hideHead }]}
    id={sectionId}
    aria-labelledby={hideHead ? undefined : `${sectionId}-title`}
    aria-label={hideHead ? `${ui.t('acc.ariaVerblijvenPrefix')} ${roundup.regio}` : undefined}
  >
    {!hideHead && (
      <header class="acc-roundup__head">
        <span class="acc-roundup__kicker">{ui.t('acc.kicker')}</span>
        <h2 id={`${sectionId}-title`} class="acc-roundup__title">{`${ui.t('acc.hotelsInPrefix')} ${roundup.regio}`}</h2>
        <p class="acc-roundup__intro">{ui.t('acc.intro')}</p>
      </header>
    )}

    {isIndex ? (
      <div class="acc-roundup__grid acc-roundup__grid--index" data-kh-grid>
        {platteKaarten.map((kaart) => (
          <div class="acc-roundup__item" data-kh-card data-plaats={plaatsKort(kaart.plaats)} data-klasse={kaart.tier || ''}>
            <AccommodatieKaart kaart={kaart} context={context || roundup.regio} bronValuta={bronValuta} displayValuta={displayValuta} locale={locale} variant="compact" />
          </div>
        ))}
      </div>
    ) : (<>
    {heeftNav && (
      <nav class="acc-roundup__nav" aria-label={ui.t('acc.navAria')}>
        <span class="acc-roundup__nav-label">{ui.t('acc.navLabel')}</span>
        <ul class="acc-roundup__pills">
          {groepen.map((g) => (
            <li>
              <a class="acc-roundup__pill" href={`#${sectionId}-${g.slug}`}>{g.titel}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {categorieGroepen.map((g) => (
      <div class="acc-roundup__groep" id={`${sectionId}-${g.slug}`}>
        <p class="acc-roundup__groep-title">
          {g.plaatsen.length > 1 ? `${ui.t('acc.hotelsRondPrefix')} ${g.titel}` : `${ui.t('acc.hotelsInPrefix')} ${g.titel}`}
        </p>
        {g.plaatsen.length > 1 && (
          <p class="acc-roundup__groep-note">{ui.t('acc.groepNote')}</p>
        )}
        {g.categorieen.length > 1 && (
          <nav class="acc-roundup__categories" aria-label={ui.t('acc.categoryNavAria')}>
            <ul>
              {g.categorieen.map((categorie) => (
                <li><a href={`#${categorie.id}`}>
                  <span class="acc-roundup__category-label"><span class="acc-roundup__category-name"><StayTierIcon tier={categorie.tier} />{categorie.label}</span><span aria-hidden="true">↘</span></span>
                  <span class="acc-roundup__category-description">{categorie.description}</span>
                </a></li>
              ))}
            </ul>
          </nav>
        )}
        {g.categorieen.map((categorie) => (
          <section class="acc-roundup__category" id={categorie.id} aria-labelledby={`${categorie.id}-title`}>
            <header class="acc-roundup__category-head">
              <h3 id={`${categorie.id}-title`}><StayTierIcon tier={categorie.tier} size={32} />{categorie.label}</h3>
              <p>{categorie.description}</p>
            </header>
            <div class="acc-roundup__grid acc-roundup__grid--editorial">
              {categorie.kaarten.map((kaart) => (
                <AccommodatieKaart kaart={kaart} context={context || roundup.regio} bronValuta={bronValuta} displayValuta={displayValuta} locale={locale} />
              ))}
            </div>
          </section>
        ))}
        {g.overig.length > 0 && (
          <div class="acc-roundup__grid acc-roundup__grid--editorial">
            {g.overig.map((kaart) => (
              <AccommodatieKaart kaart={kaart} context={context || roundup.regio} bronValuta={bronValuta} displayValuta={displayValuta} locale={locale} />
            ))}
          </div>
        )}
      </div>
    ))}
    </>)}

    <p class="acc-roundup__disclosure">{ui.t('acc.disclosure')}</p>
  </section>
)}

<style>
  .acc-roundup {
    margin: 3rem 0;
  }
  /* Geen eigen kop → de pagina-hero levert de bovenruimte al. */
  .acc-roundup--headless {
    margin-top: 0;
  }
  .acc-roundup__kicker {
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--burgundyInk, #5A1A1F);
  }
  .acc-roundup__title {
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.875rem, 1.2rem + 2.4vw, 2.75rem);
    font-weight: 500;
    color: var(--ink, #1F1A16);
    margin: 0.4rem 0 0.6rem;
  }
  .acc-roundup__intro {
    font-family: var(--font-body, Georgia, serif);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--inkSoft, #5A4F45);
    max-width: 54ch;
    margin: 0 0 1.75rem;
  }

  /* Sprong-navigatie — sticky pill-rij. */
  .acc-roundup__nav {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--paper, #FAF5E9);
    padding: 0.85rem 0;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--ruleSoft, #E0D2B0);
  }
  .acc-roundup__nav-label {
    display: block;
    font-family: var(--font-ui, sans-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink, #1F1A16);
    margin-bottom: 0.6rem;
  }
  .acc-roundup__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .acc-roundup__pill {
    display: inline-block;
    font-family: var(--font-ui, sans-serif);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--burgundyInk, #5A1A1F);
    background: var(--burgundy-10, #F2EAEB);
    border: 1px solid var(--burgundy-20, #E4D4D5);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .acc-roundup__pill:hover,
  .acc-roundup__pill:focus-visible {
    background: var(--burgundy, #5A1A1F);
    color: var(--fixed-cream, #FAF5E9);
    outline: none;
  }

  .acc-roundup__groep {
    margin-bottom: 2.5rem;
    scroll-margin-top: 6rem;
  }
  .acc-roundup__groep-title {
    font-family: var(--font-ui, sans-serif);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink, #1F1A16);
    margin: 0 0 0.4rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--rule, #C9B98F);
  }
  .acc-roundup__groep-note {
    font-family: var(--font-body, Georgia, serif);
    font-style: italic;
    font-size: 0.8125rem;
    color: var(--inkFaint, #6B6054);
    margin: 0 0 1.1rem;
  }
  .acc-roundup__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }


  .acc-roundup__categories { margin: 1.5rem 0 2.5rem; }
  .acc-roundup__categories ul {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0; list-style: none; padding: 0; margin: 0;
    border: 1px solid var(--rule, #C9B98F); border-radius: 4px; overflow: hidden;
  }
  .acc-roundup__categories li { margin: 0; padding: 0; min-width: 0; }
  .acc-roundup__categories li + li { border-left: 1px solid var(--rule, #C9B98F); }
  .acc-roundup__categories a {
    display: flex; flex-direction: column; gap: 0.5rem; height: 100%;
    padding: 1rem; color: var(--ink, #1F1A16); text-decoration: none;
    background: var(--paper, #FAF5E9); box-sizing: border-box;
  }
  .acc-roundup__categories a:hover { background: var(--paperDeep, #F0E6D0); }
  .acc-roundup__categories a:focus-visible { outline: 3px solid var(--burgundyInk, #5A1A1F); outline-offset: -4px; }
  .acc-roundup__category-label {
    display: flex; justify-content: space-between; gap: 0.5rem;
    font-family: var(--font-ui, sans-serif); font-weight: 600; font-size: 0.9375rem;
    color: var(--burgundyInk, #5A1A1F);
  }
  .acc-roundup__category-name { display: flex; align-items: center; gap: 0.55rem; min-width: 0; }
  .acc-roundup__category-name :global(svg),
  .acc-roundup__category-head :global(svg) { flex: 0 0 auto; }
  .acc-roundup__category-head h3 { display: flex; align-items: center; gap: 0.7rem; }
  .acc-roundup__category-description { font-family: var(--font-body, Georgia, serif); font-size: 0.875rem; line-height: 1.5; }
  .acc-roundup__category { scroll-margin-top: 7rem; margin: 0 0 2.75rem; }
  .acc-roundup__category-head { border-top: 1px solid var(--rule, #C9B98F); padding: 1rem 0 1.25rem; }
  .acc-roundup__category-head h3 {
    font-family: var(--font-display, Georgia, serif); font-size: clamp(1.8rem, 3vw, 2.25rem);
    font-weight: 400; line-height: 1.15; color: var(--burgundyInk, #5A1A1F); margin: 0 0 0.4rem;
  }
  .acc-roundup__category-head p { font-family: var(--font-body, Georgia, serif); font-size: 1rem; line-height: 1.5; color: var(--inkSoft, #5A4F45); margin: 0; }
  .acc-roundup__grid--editorial { grid-template-columns: repeat(auto-fit, minmax(min(270px, 100%), 1fr)); align-items: start; }
  .acc-roundup__grid--editorial :global(.poi-card) { box-shadow: none; transform: none; }
  .acc-roundup__grid--editorial :global(.poi-card__head) { display: flex; flex-direction: column; align-items: flex-start; gap: 0.65rem; }
  .acc-roundup__grid--editorial :global(.poi-card__name) { font-size: 1.5rem; font-weight: 400; line-height: 1.2; }
  .acc-roundup__grid--editorial :global(.poi-card__badge) { font-size: 0.75rem; letter-spacing: 0.04em; }
  /* The full CMS text remains readable; no inaccessible line clamping. */
  .acc-roundup__grid--editorial :global(.poi-card__why),
  .acc-roundup__grid--editorial :global(.poi-card__desc) { display: block; -webkit-line-clamp: unset; overflow: visible; font-style: normal; }
  .acc-roundup__grid--editorial :global(.poi-card__foot) { padding-top: 0.75rem; }
  .acc-roundup__grid--editorial :global(.poi-card__cta) { display: inline-flex; align-items: center; min-height: 44px; box-sizing: border-box; }
  @media (max-width: 640px) {
    .acc-roundup__categories ul { grid-template-columns: 1fr; }
    .acc-roundup__categories li + li { border-left: 0; border-top: 1px solid var(--rule, #C9B98F); }
    .acc-roundup__categories a { padding: 0.9rem 1rem; gap: 0.25rem; }
  }

  /* LAT-13771 — platte resultatengrid (variant index). */
  .acc-roundup__grid--index { grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); margin-bottom: 1.5rem; }
  .acc-roundup__item[hidden] { display: none; }

  .acc-roundup__disclosure {
    font-family: var(--font-body, Georgia, serif);
    font-style: italic;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--inkFaint, #6B6054);
    margin: 0.5rem 0 0;
    max-width: 60ch;
  }

  @media (max-width: 640px) {
    .acc-roundup__grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    html { scroll-behavior: smooth; }
  }
</style>
