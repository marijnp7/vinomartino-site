<script>
  // LAT-13057 blok 2: "Vandaag" naar de weekdag in Europa/Berlijn (de huizen liggen in CET).
  const DAG = { Mon: 'ma', Tue: 'di', Wed: 'wo', Thu: 'do', Fri: 'vr', Sat: 'za', Sun: 'zo' } as const;
  const vandaag = DAG[new Intl.DateTimeFormat('en-GB', { weekday: 'short', timeZone: 'Europe/Berlin' }).format(new Date()) as keyof typeof DAG];
  document.querySelectorAll<HTMLElement>('.wp-kort__vandaag').forEach((el) => {
    const uren = JSON.parse(el.dataset.uren || '{}') as Record<string, string>;
    if (!(vandaag in uren)) return;
    el.querySelector('dd')!.textContent = uren[vandaag] || el.dataset.dicht || '';
    el.hidden = false;
  });

  // LAT-13057 blok 4: pijlen schuiven één kaart; swipe en toetsenbord werken native.
  document.querySelectorAll<HTMLElement>('[data-wp-reeks]').forEach((sec) => {
    const track = sec.querySelector<HTMLElement>('.wp-reeks');
    const kaart = track?.querySelector<HTMLElement>('.wp-reeks__kaart');
    if (!track || !kaart) return;
    sec.querySelectorAll<HTMLButtonElement>('.wp-reeks__pijl').forEach((btn) => {
      btn.addEventListener('click', () => track.scrollBy({ left: Number(btn.dataset.dir) * (kaart.offsetWidth + 16), behavior: 'smooth' }));
    });
  });
</script>
