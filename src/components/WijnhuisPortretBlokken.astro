---
// LAT-12769 — Wijnhuis-portret 2.0: blokken "Waarom je hier heen gaat", "De wijngaarden"
// (extra foto's), "Wat te drinken", "Bezoek", "Combineer met" en "Snel antwoord". Elk blok rendert alleen als
// zijn data gevuld is; nooit een leeg kader.
import { DEFAULT_LOCALE, type Locale, localizeHref } from '../lib/i18n';
import { loadUiStrings } from '../lib/ui-strings';
import { DAGEN, WIJN_ROLLEN, eurLabel, heeftBezoek as bezoekGevuld, heeftBezoekKort, safeUrl, urenPerDag, type WijnhuisPortret } from '../lib/wijnhuis-portret';
import { getImageCredit } from '../lib/image-credits';
import type { WijnhuisGalerijBeeld } from '../lib/wijnhuizen';

type Blok = 'kort' | 'waarom' | 'galerij' | 'drinken' | 'bezoek' | 'combineer' | 'faq';

interface Props {
  blok: Blok;
  portret: WijnhuisPortret;
  galerij?: WijnhuisGalerijBeeld[];
  name: string;
  address?: string;
  website?: string;
  routeHref?: string;
  routeLabel?: string;
  region?: string;
  streekSlug?: string;
  locale?: Locale;
}

const { blok, portret: p, galerij = [], name, address = '', website = '', routeHref, routeLabel, region, streekSlug, locale = DEFAULT_LOCALE } = Astro.props;
const ui = await loadUiStrings(locale);
const lh = (href: string) => localizeHref(href, locale);

const websiteUrl = safeUrl(website);
const mapsUrl = address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${name}, ${address}`)}`
  : null;

const dagen = p.openingstijden
  ? DAGEN.filter((d) => p.openingstijden!.dagen[d] !== undefined).map((d) => ({
      dag: ui.t(`wijnhuis.dag.${d}`),
      tijden: p.openingstijden!.dagen[d]!,
    }))
  : [];
const ps = p.proeverij;
const heeftBezoek = bezoekGevuld(p, address, website);

const wijnen = WIJN_ROLLEN.map((r) => p.wijnen.find((w) => w.rol === r)).filter((w): w is NonNullable<typeof w> => Boolean(w));

// LAT-13057 blok 2 — "Bezoek in het kort": één strook, één primaire knop. Zonder
// bevestigde prijs geen prijs; reserveren alleen met een echte proeverij-URL.
const kortProeverij = ps
  ? [
      ps.prijs !== null ? `€${ps.prijs}` : null,
      ps.duur !== null ? `${ps.duur} ${ui.t('wijnhuis.bezoek.min')}` : null,
      ps.talen.length ? ps.talen.map((t) => t.toUpperCase()).join(', ') : null,
    ].filter(Boolean).join(' · ')
  : '';
const kortUren = urenPerDag(p.openingstijden);
const kortKnop = ps?.url
  ? { href: ps.url, label: ui.t('wijnhuis.bezoek.reserveer'), extern: true }
  : heeftBezoek
    ? { href: '#bezoek', label: ui.t('wijnhuis.cta.plan'), extern: false }
    : null;

// LAT-13057 blok 4 — beeldreeks: credit per kaart. Licentie-credit als die er is; anders
// "Foto: <huis>" bij een redactiegids-portret (producentenbeeld, REGEL 64). Bij een
// zelf-geweest-portret claimen we geen bron die we niet kennen.
const reeks = blok === 'galerij'
  ? await Promise.all(galerij.map(async (b) => {
      const c = b.id ? await getImageCredit(b.id) : null;
      const credit = c?.author ? `${ui.t('wijnhuis.reeks.foto')}: ${c.author}` : !p.zelfGeweest ? `${ui.t('wijnhuis.reeks.foto')}: ${name}` : '';
      return { ...b, credit };
    }))
  : [];

const nabije = p.nabije.slice(0, 4);
const heeftCombineer = Boolean(nabije.length || (routeHref && routeLabel) || (streekSlug && region));
---

{blok === 'kort' && (heeftBezoekKort(p) || !p.zelfGeweest) && (
  <section class="wp wp--kort" aria-labelledby="wp-kort-title">
    <div class="container">
      <div class="wp-kort">
        <h2 class="wp__eyebrow wp-kort__label" id="wp-kort-title">{ui.t('wijnhuis.kort.label')}</h2>
        <dl class="wp-kort__feiten">
          {p.bezoekType && (
            <div><dt>{ui.t('wijnhuis.kort.type')}</dt><dd>{ui.t(`wijnhuis.bezoek.${p.bezoekType}`)}</dd></div>
          )}
          {kortProeverij && (
            <div><dt>{ui.t('wijnhuis.bezoek.proeverij')}</dt><dd>{kortProeverij}</dd></div>
          )}
          {Object.keys(kortUren).length > 0 && (
            <div class="wp-kort__vandaag" data-uren={JSON.stringify(kortUren)} data-dicht={ui.t('wijnhuis.bezoek.gesloten')} hidden>
              <dt>{ui.t('wijnhuis.kort.vandaag')}</dt><dd></dd>
            </div>
          )}
        </dl>
        {/* LAT-13066 (Marketing): "Redactiegids" op de chip is jargon; hier staat het in gewone taal. */}
        {!p.zelfGeweest && <p class="wp-kort__noot">{ui.t('wijnhuis.kort.redactiegidsNoot')}</p>}
        {kortKnop && (
          <a class="btn btn--primary wp-kort__knop" href={kortKnop.href} {...(kortKnop.extern ? { target: '_blank', rel: 'noopener' } : {})}>{kortKnop.label}</a>
        )}
      </div>
    </div>
  </section>
)}

{blok === 'waarom' && p.waaromHier.length > 0 && (
  <section class="wp wp--waarom" aria-labelledby="wp-waarom-title">
    <div class="container">
      <h2 class="wp__eyebrow" id="wp-waarom-title">{ui.t('wijnhuis.waarom.eyebrow')}</h2>
      <ol class="wp-waarom">
        {p.waaromHier.map((regel) => <li>{regel}</li>)}
      </ol>
    </div>
  </section>
)}

{/* LAT-13057 blok 4: swipe-reeks zoals de IG-carrousel (scroll-snap, teller, credit).
    Eén foto is geen reeks en blijft een los beeld. */}
{blok === 'galerij' && reeks.length === 1 && (
  <section class="wp wp--galerij" aria-label={name}>
    <div class="container">
      <figure class="wp-galerij__item">
        <img src={reeks[0].src} alt={reeks[0].alt} loading="lazy" decoding="async" width={reeks[0].width ?? undefined} height={reeks[0].height ?? undefined} />
        {reeks[0].credit && <figcaption class="wp-reeks__credit">{reeks[0].credit}</figcaption>}
      </figure>
    </div>
  </section>
)}

{blok === 'galerij' && reeks.length >= 2 && (
  <section class="wp wp--reeks" aria-roledescription="carousel" aria-label={`${ui.t('wijnhuis.reeks.label')}: ${name}`} data-wp-reeks>
    <div class="container wp-reeks__kop">
      <p class="wp__eyebrow">{ui.t('wijnhuis.reeks.label')}</p>
      <div class="wp-reeks__pijlen">
        <button type="button" class="wp-reeks__pijl" data-dir="-1" aria-label={ui.t('wijnhuis.reeks.vorige')}>←</button>
        <button type="button" class="wp-reeks__pijl" data-dir="1" aria-label={ui.t('wijnhuis.reeks.volgende')}>→</button>
      </div>
    </div>
    <ol class="wp-reeks" tabindex="0">
      {reeks.map((b, i) => (
        <li class="wp-reeks__kaart" aria-roledescription="slide" aria-label={`${i + 1}/${reeks.length}`}>
          <figure>
            <img src={b.src} alt={b.alt} loading="lazy" decoding="async" width={b.width ?? undefined} height={b.height ?? undefined} />
            <figcaption class="wp-reeks__onder">
              {/* LAT-13073: alt is een NL-bestandstitel uit Directus; op /en/ niet als zichtbare tekst tonen (i18n-nl gate). */}
              {locale === DEFAULT_LOCALE && <span class="wp-reeks__titel">{b.alt}</span>}
              <span class="wp-reeks__meta"><span>{i + 1}/{reeks.length}</span>{b.credit && <span>{b.credit}</span>}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ol>
  </section>
)}

{blok === 'drinken' && wijnen.length > 0 && (
  <section class="wp wp--drinken" id="wat-te-drinken" aria-labelledby="wp-drinken-title">
    <div class="container">
      <p class="wp__eyebrow">{ui.t('wijnhuis.drinken.eyebrow')}</p>
      <h2 class="wp__title" id="wp-drinken-title">{ui.t('wijnhuis.drinken.title')}</h2>
      <ul class="wp-fles">
        {wijnen.map((w) => {
          const koop = w.koopUrl;
          return (
            <li class={`wp-fles__kaart wp-fles__kaart--${w.rol}`}>
              <span class="wp-fles__rol">{ui.t(`wijnhuis.rol.${w.rol}`)}</span>
              <h3 class="wp-fles__naam">{w.naam}</h3>
              {w.prijsband && <span class="wp-fles__prijs" aria-label={`${w.prijsband}/4`}>{eurLabel(w.prijsband)}</span>}
              {(w.van || w.tot) && (
                <p class="wp-fles__venster">
                  {[w.van ? `${ui.t('wijnhuis.drink.vanaf')} ${w.van}` : null, w.tot ? `${ui.t('wijnhuis.drink.tot')} ${w.tot}` : null].filter(Boolean).join(' ')}
                </p>
              )}
              {koop && (
                <a class="btn btn--outline" href={koop} rel="sponsored noopener" target="_blank">{ui.t('wijnhuis.drink.koop')}</a>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}

{blok === 'bezoek' && heeftBezoek && (
  <section class="wp wp--bezoek" id="bezoek" aria-labelledby="wp-bezoek-title">
    <div class="container">
      <p class="wp__eyebrow">{ui.t('wijnhuis.bezoek.eyebrow')}</p>
      <h2 class="wp__title" id="wp-bezoek-title">{ui.t('wijnhuis.bezoek.title')}</h2>
      <div class="wp-bezoek">
        <dl class="wp-bezoek__lijst">
          {address && (
            <div class="wp-bezoek__rij">
              <dt>{ui.t('wijnhuis.bezoek.adres')}</dt>
              <dd>{address}{mapsUrl && <> · <a href={mapsUrl} target="_blank" rel="noopener">Google Maps</a></>}</dd>
            </div>
          )}
          {websiteUrl && (
            <div class="wp-bezoek__rij">
              <dt>{ui.t('wijnhuis.bezoek.website')}</dt>
              <dd><a href={websiteUrl} target="_blank" rel="noopener">{new URL(websiteUrl).hostname.replace(/^www\./, '')}</a></dd>
            </div>
          )}
          {dagen.length > 0 && (
            <div class="wp-bezoek__rij">
              <dt>{ui.t('wijnhuis.bezoek.openingstijden')}</dt>
              <dd>
                <ul class="wp-uren">
                  {dagen.map((d) => (
                    <li><span>{d.dag}</span><span>{d.tijden.length ? d.tijden.join(', ') : ui.t('wijnhuis.bezoek.gesloten')}</span></li>
                  ))}
                </ul>
                {p.openingstijden?.opmerking && <p class="wp-uren__noot">{p.openingstijden.opmerking}</p>}
              </dd>
            </div>
          )}
          {dagen.length === 0 && p.openingstijden?.opmerking && (
            <div class="wp-bezoek__rij">
              <dt>{ui.t('wijnhuis.bezoek.openingstijden')}</dt>
              <dd>{p.openingstijden.opmerking}</dd>
            </div>
          )}
          {ps && (
            <div class="wp-bezoek__rij">
              <dt>{ui.t('wijnhuis.bezoek.proeverij')}</dt>
              <dd>
                {[
                  ps.prijs !== null ? `${ui.t('wijnhuis.bezoek.prijs')} €${ps.prijs}` : null,
                  ps.duur !== null ? `${ui.t('wijnhuis.bezoek.duur')} ${ps.duur} ${ui.t('wijnhuis.bezoek.min')}` : null,
                  ps.talen.length ? `${ui.t('wijnhuis.bezoek.taal')} ${ps.talen.map((t) => t.toUpperCase()).join(', ')}` : null,
                ].filter(Boolean).join(' · ')}
                {ps.url && <p><a class="btn btn--primary" href={ps.url} target="_blank" rel="noopener">{ui.t('wijnhuis.bezoek.reserveer')}</a></p>}
              </dd>
            </div>
          )}
        </dl>
        {p.zelfGeweest && p.onzeErvaring && (
          <aside class="wp-ervaring">
            <h3 class="wp-ervaring__titel">{ui.t('wijnhuis.ervaring.title')}</h3>
            <p>{p.onzeErvaring}</p>
          </aside>
        )}
      </div>
    </div>
  </section>
)}

{blok === 'combineer' && heeftCombineer && (
  <section class="wp wp--combineer" aria-labelledby="wp-combineer-title">
    <div class="container">
      <p class="wp__eyebrow">{ui.t('wijnhuis.combineer.eyebrow')}</p>
      <h2 class="wp__title" id="wp-combineer-title">{ui.t('wijnhuis.combineer.title')}</h2>
      <ul class="wp-combineer">
        {routeHref && routeLabel && (
          <li><a href={routeHref}><span>{ui.t('wijnhuis.combineer.route')}</span>{routeLabel}</a></li>
        )}
        {streekSlug && region && (
          <li><a href={lh(`/streken/${streekSlug}/`)}><span>{ui.t('wijnhuis.combineer.streek')}</span>{region}</a></li>
        )}
        {nabije.map((n) => (
          <li><a href={lh(`/wijnhuizen/${n.slug}/`)}><span>{ui.t('wijnhuis.related.label')}</span>{n.name}</a></li>
        ))}
        <li><a href={lh('/de-brief/')}><span>{ui.t('wijnhuis.combineer.brief')}</span>{ui.t('wijnhuis.combineer.briefTekst')}</a></li>
      </ul>
    </div>
  </section>
)}

{blok === 'faq' && p.faq.length > 0 && (
  <section class="wp wp--faq" id="snel-antwoord" aria-labelledby="wp-faq-title">
    <div class="container">
      <p class="wp__eyebrow">{ui.t('wijnhuis.faq.eyebrow')}</p>
      <h2 class="wp__title" id="wp-faq-title">{ui.t('wijnhuis.faq.title')}</h2>
      <dl class="wp-faq">
        {p.faq.map((f) => (
          <div class="wp-faq__item">
            <dt>{f.vraag}</dt>
            <dd>{f.antwoord}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}

<style>
  .wp { padding: 2.5rem 0; }
  /* .btn is scoped in WijnhuisPageContent en bereikt deze component niet. */
  .btn { display: inline-block; padding: 0.75rem 1.25rem; font-family: var(--font-ui); font-size: 0.8125rem; font-weight: 600; text-decoration: none; }
  .btn:hover { opacity: 0.85; }
  .btn--primary { background: var(--burgundy); color: var(--fixed-cream); }
  .btn--outline { background: var(--paper); color: var(--ink); border: 1px solid var(--rule); }
  .wp__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rust);
    margin: 0 0 0.5rem;
  }
  .wp__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    color: var(--ink);
    margin: 0 0 1.5rem;
  }

  .wp-galerij { display: grid; gap: 0.75rem; }
  .wp-galerij--2 { grid-template-columns: repeat(2, 1fr); }
  .wp-galerij--3 { grid-template-columns: repeat(3, 1fr); }
  .wp-galerij__item { margin: 0; }
  .wp-galerij__item img { display: block; width: 100%; height: auto; background: var(--paperDeep); }

  .wp-fles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .wp-fles__kaart {
    background: var(--paperDeep);
    border: 1px solid var(--rule);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .wp-fles__rol { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--burgundy); }
  .wp-fles__naam { font-family: var(--font-display); font-weight: 400; font-size: 1.375rem; line-height: 1.2; margin: 0; color: var(--ink); }
  .wp-fles__prijs { font-family: var(--font-mono); color: var(--inkSoft); }
  .wp-fles__venster { margin: 0; font-family: var(--font-ui); font-size: 0.875rem; color: var(--inkSoft); }
  .wp-fles__kaart .btn { margin-top: auto; align-self: flex-start; }

  .wp-bezoek { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem; align-items: start; }
  .wp-bezoek__lijst { margin: 0; }
  .wp-bezoek__rij { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding: 0.75rem 0; border-top: 1px solid var(--ruleSoft); }
  .wp-bezoek__rij dt { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--inkSoft); }
  .wp-bezoek__rij dd { margin: 0; font-family: var(--font-body); color: var(--ink); }
  .wp-bezoek__rij a:not(.btn) { color: var(--burgundy); }
  .wp-uren { list-style: none; margin: 0; padding: 0; }
  .wp-uren li { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.9375rem; padding: 0.125rem 0; }
  .wp-uren__noot { margin: 0.5rem 0 0; font-size: 0.875rem; color: var(--inkSoft); }
  .wp-ervaring { background: var(--paperShade); border-left: 3px solid var(--burgundy); padding: 1.25rem 1.5rem; }
  .wp-ervaring__titel { font-family: var(--font-display); font-weight: 400; font-size: 1.25rem; margin: 0 0 0.5rem; color: var(--ink); }
  .wp-ervaring p { margin: 0; line-height: 1.6; }

  .wp-combineer { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 0.75rem; }
  /* LAT-13057 blok 6: bordeaux contrastvlak, zoals de IG-slotkaart. */
  .wp--combineer { background: var(--burgundy); color: var(--fixed-cream); padding: 3.5rem 0; }
  .wp--combineer .wp__eyebrow { color: var(--fixed-cream); opacity: 0.75; }
  .wp--combineer .wp__title { color: var(--fixed-cream); }
  .wp-combineer a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: transparent;
    color: var(--fixed-cream);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.25rem;
  }
  .wp-combineer a:hover, .wp-combineer a:focus-visible { border-color: var(--fixed-cream); background: rgba(255, 255, 255, 0.06); }
  .wp-combineer a span { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--fixed-cream); opacity: 0.75; }

  /* ── Bezoek in het kort (LAT-13057 blok 2) ── */
  .wp--kort { padding: 1.25rem 0 2rem; }
  .wp-kort {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1rem 1.25rem;
    background: var(--paperDeep);
    border-top: 2px solid var(--burgundy);
  }
  .wp-kort__label { margin: 0; }
  .wp-kort__noot { grid-column: 1 / -1; margin: 0; font-family: var(--font-ui); font-size: 0.875rem; color: var(--inkSoft); }
  .wp-kort__feiten { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin: 0; }
  .wp-kort__feiten div { display: flex; flex-direction: column; gap: 0.125rem; }
  .wp-kort__feiten div[hidden] { display: none; }
  .wp-kort__feiten dt { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--inkSoft); }
  .wp-kort__feiten dd { margin: 0; font-family: var(--font-ui); font-size: 0.9375rem; color: var(--ink); }

  /* ── Beeldreeks (LAT-13057 blok 4) ── */
  .wp-reeks__kop { display: flex; justify-content: space-between; align-items: end; }
  .wp-reeks__pijlen { display: flex; gap: 0.5rem; margin-bottom: 0.5rem; }
  .wp-reeks__pijl {
    width: 2.5rem; height: 2.5rem;
    border: 1px solid var(--rule); background: var(--paper); color: var(--ink);
    font-size: 1rem; cursor: pointer;
  }
  .wp-reeks__pijl:hover { border-color: var(--burgundy); }
  .wp-reeks {
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((min(100vw, var(--max-width, 1280px)) - 2 * var(--gutter) - 2rem) / 3);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 var(--gutter);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .wp-reeks::-webkit-scrollbar { display: none; }
  .wp-reeks__kaart { scroll-snap-align: start; }
  .wp-reeks__kaart figure { position: relative; margin: 0; aspect-ratio: 4 / 5; overflow: hidden; background: var(--ink); }
  .wp-reeks__kaart img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .wp-reeks__onder {
    position: absolute; inset: auto 0 0 0;
    padding: 2.5rem 1rem 0.75rem;
    background: linear-gradient(to top, rgba(20, 12, 10, 0.8), rgba(20, 12, 10, 0));
    color: var(--fixed-cream);
    display: flex; flex-direction: column; gap: 0.375rem;
  }
  .wp-reeks__titel {
    font-family: var(--font-display); font-size: 1.25rem; line-height: 1.2;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .wp-reeks__meta { display: flex; justify-content: space-between; gap: 1rem; font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.1em; opacity: 0.85; }
  .wp-reeks__credit { font-family: var(--font-mono); font-size: 0.625rem; color: var(--inkSoft); margin-top: 0.375rem; }

  .wp--waarom { padding-top: 0; }
  .wp-waarom {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    counter-reset: waarom;
  }
  .wp-waarom li {
    counter-increment: waarom;
