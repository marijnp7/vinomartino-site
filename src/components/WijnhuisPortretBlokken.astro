    color: var(--ink);
  }
  .wp-waarom li::before {
    content: counter(waarom, decimal-leading-zero);
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    color: var(--burgundy);
    margin-bottom: 0.375rem;
  }

  .wp-faq { margin: 0; max-width: 46rem; }
