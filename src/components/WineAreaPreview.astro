---
import type { WineGeography } from '../lib/wine-geography';
import { locatorSvgUrl, locatorSize } from '../lib/wine-area-svg';
interface Props { geography: WineGeography; label: string; overview?: boolean }
const { geography, label, overview = false } = Astro.props;
const size = overview ? locatorSize(geography) : null;
---
{overview
  ? <img class="wine-area-preview" src={locatorSvgUrl(geography.feature.properties.slug)} alt={label} width={size!.width} height={size!.height} loading="lazy" decoding="async" />
  : <svg class="wine-area-preview" viewBox={geography.detail.viewBox} role="img" aria-label={label} xmlns="http://www.w3.org/2000/svg">
  <title>{label}</title>
  <path d={geography.detail.d} class="wine-area-preview__area" fill-rule="evenodd" vector-effect="non-scaling-stroke" />
</svg>}
<style>
.wine-area-preview { width:100%; height:100%; display:block; background:var(--paperDeep,#F0E6D0); }
.wine-area-preview__context { fill:#8A7E70; fill-opacity:.08; stroke:#8A7E70; stroke-opacity:.35; stroke-width:.6; }
.wine-area-preview__area { fill:#5A1A1F; fill-opacity:.26; stroke:#5A1A1F; stroke-width:1.2; }
.wine-area-preview__anchor { fill:#5A1A1F; stroke:#F0E6D0; stroke-width:2; }
</style>
