---
// LAT-1098: forward cross-link block onderaan article-pages. Mengt vier
// gerelateerde-entiteit lijsten in vaste volgorde (streken → wijnhuizen →
// wijnroutes → landen), cap op 6 cards. Section verschijnt niet als alle vier
// leeg zijn (per spec acceptance: geen lege "Gerelateerd"-kop).
import type { RelatedRef } from '../lib/articles';
import { DEFAULT_LOCALE, type Locale, localizeHref } from '../lib/i18n';
import { loadUiStrings } from '../lib/ui-strings';

interface Props {
  /** LAT-2704 — locale van de renderende pagina; stuurt de interne hrefs. */
  locale?: Locale;
  streken?: RelatedRef[];
  wijnhuizen?: RelatedRef[];
  wijnroutes?: RelatedRef[];
  landen?: RelatedRef[];
  title?: string;
  maxItems?: number;
}

const {
  streken = [],
  wijnhuizen = [],
  wijnroutes = [],
  landen = [],
  title,
  maxItems = 6,
  locale = DEFAULT_LOCALE,
} = Astro.props;

// LAT-2704 — interne hrefs locale-aware; NL blijft byte-identiek.
const lh = (href: string) => localizeHref(href, locale);

// LAT-4911 — de kop en de vier kaart-labels stonden hier als kale NL-literals en
// renderden daardoor Nederlands op /en/artikelen/ (20 pagina's voor `streek`,
// 9 voor `wijnhuis`). Geen enkele call-site geeft `title` mee, dus de default
// loopt nu via de dictionary; een expliciete `title`-prop wint nog steeds.
const ui = await loadUiStrings(locale);
const heading = title ?? ui.t('related.title');

type Card = { slug: string; name: string; type: 'streek' | 'wijnhuis' | 'wijnroute' | 'land' };

const href: Record<Card['type'], (slug: string) => string> = {
  streek: (s) => `/streken/${s}/`,
  wijnhuis: (s) => `/wijnhuizen/${s}/`,
  wijnroute: (s) => `/wijnroutes/${s}/`,
  land: (s) => `/landen/${s}/`,
};

const label: Record<Card['type'], string> = {
  streek: ui.t('related.kind.streek'),
  wijnhuis: ui.t('related.kind.wijnhuis'),
  wijnroute: ui.t('related.kind.wijnroute'),
  land: ui.t('related.kind.land'),
};

const cards: Card[] = [
  ...streken.map((r) => ({ ...r, type: 'streek' as const })),
  ...wijnhuizen.map((r) => ({ ...r, type: 'wijnhuis' as const })),
  ...wijnroutes.map((r) => ({ ...r, type: 'wijnroute' as const })),
  ...landen.map((r) => ({ ...r, type: 'land' as const })),
].slice(0, maxItems);
---

{cards.length > 0 && (
  <section class="related-entities">
    <div class="container">
      <span class="related-label">{ui.t('related.label')}</span>
      <h2 class="related-title">{heading}</h2>
      <div class="related-grid">
        {cards.map((card) => (
          <a href={lh(href[card.type](card.slug))} class="related-card">
            <span class="related-meta">{label[card.type]}</span>
            <span class="related-name">{card.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .related-entities {
    padding: 3rem 0;
    border-top: 1px solid var(--rule);
  }
  .related-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--burgundy);
    display: block;
    margin-bottom: 0.5rem;
  }
  .related-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0 0 1.5rem;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .related-card {
    text-decoration: none;
    color: inherit;
    background: var(--paperDeep);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-sm);
    transition: box-shadow var(--duration-fast) var(--ease-out);
  }
  .related-card:hover {
    box-shadow: var(--shadow-card-hover);
  }
  .related-meta {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--rust);
    display: block;
    margin-bottom: 0.25rem;
  }
  .related-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .related-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
