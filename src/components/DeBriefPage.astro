---
// LAT-13354: gedeelde /de-brief/-pagina voor NL en EN. Alle copy komt uit Directus
// `ui_strings` (keys `debrief.*`, defaults in src/lib/ui-strings.ts), HARDE REGEL 3.
// De editielijst is genummerd: debrief.editie.1.*, .2.*, ... Een nieuwe editie is
// een nieuwe N met meta/titel/url in Directus (beide talen) plus een rebuild, geen code.
import SiteLayout from '../layouts/SiteLayout.astro';
import Briefkaart from './Briefkaart.astro';
import SubstackCta from './SubstackCta.astro';
import { organizationSchema, breadcrumbSchema } from '../lib/seo';
import { INSTAGRAM_URL, SUBSTACK_URL } from '../lib/social';
import { loadUiStrings } from '../lib/ui-strings';
import type { Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = await loadUiStrings(locale);
const t = (k: string) => ui.t(k);
const prefix = locale === 'en' ? '/en' : '';

// Kanaal-URLs komen uit src/lib/social.ts (een bron, geen drift). Substack is
// het enige nieuwsbriefkanaal (LAT-12309).
const edities: { meta: string; titel: string; url: string }[] = [];
for (let i = 1; i <= 100; i++) {
  const key = `debrief.editie.${i}.url`;
  const url = t(key);
  if (!url || url === key) break;
  edities.push({ meta: t(`debrief.editie.${i}.meta`), titel: t(`debrief.editie.${i}.titel`), url });
}
const suffix = t('debrief.edities.suffix');
// De brief is Nederlandstalig (LAT-13196): op /en/ wijzen de editielinks naar NL-tekst.
const hreflang = locale === 'en' ? 'nl' : undefined;

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: 'Home', url: `${prefix}/` },
    { name: t('debrief.breadcrumb'), url: `${prefix}/de-brief/` },
  ]),
];
---

<SiteLayout
  title={t('debrief.meta.title')}
  description={t('debrief.meta.description')}
  schema={schema}
  activeNav="de-brief"
  locale={locale}
  alternates={{ nl: '/de-brief/', en: '/en/de-brief/' }}
>
  <section class="hero">
    <div class="container container-narrow">
      <span class="kicker">{t('debrief.kicker')}</span>
      <h1>{t('debrief.h1')}</h1>
      <p class="lede">{t('debrief.lede')}</p>

      <div class="signup">
        <SubstackCta placement="de-brief" ctaId="newsletter_signup" label={t('debrief.cta.label')} />
      </div>

      <p class="follow">
        {t('debrief.follow.lead')}{' '}
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener">{t('debrief.follow.instagram')}</a>{SUBSTACK_URL ? (
          <>{t('debrief.follow.substack.lead')} <a href={SUBSTACK_URL} target="_blank" rel="noopener" data-cta-id="substack_link">{t('debrief.follow.substack')}</a></>
        ) : null}{t('debrief.follow.tail')}
      </p>
    </div>
  </section>

  <section class="voorbeeld">
    <div class="container container-narrow">
      <Briefkaart dateline={t('debrief.edities.dateline')}>
        <p>{t('debrief.edities.intro')}</p>
        <ul class="edities">
          {edities.map((e) => (
            <li>{e.meta}: <a href={e.url} target="_blank" rel="noopener" hreflang={hreflang}>{e.titel}</a>{suffix ? ` ${suffix}` : ''}</li>
          ))}
        </ul>
        <p>{t('debrief.edities.outro')}</p>
      </Briefkaart>
    </div>
  </section>
</SiteLayout>

<style>
  .container { max-width: 1280px; margin: 0 auto; padding-inline: var(--gutter); }
  .container-narrow { max-width: 760px; }

  .hero {
    padding: clamp(56px, 10vw, 112px) 0;
    text-align: center;
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-rust, #A14F2A);
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5vw + 1rem, 5rem);
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
    line-height: 0.95;
  }
  .lede {
    font-family: var(--font-serif, var(--font-body));
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--color-text-soft, var(--color-text));
    margin: 1.5rem auto 0;
    max-width: 600px;
  }
  .signup {
    margin: 2rem auto 0;
    max-width: 480px;
  }
  .follow {
    font-family: var(--font-serif, var(--font-body));
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-faint, var(--color-text-soft, var(--color-text)));
    margin: 1.25rem auto 0;
    max-width: 480px;
  }
  .follow a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .edities { padding-left: 1.2rem; }
  .edities li { margin-bottom: 0.5rem; }
  /* Briefkaart blijft crème in kelder-modus; de globale linkkleur (goud) valt daar weg. */
  .edities a { color: var(--fixed-ink); text-decoration: underline; text-underline-offset: 3px; }
  .edities a:hover { color: #5A1A1F; }

  .voorbeeld {
    padding: 0 0 clamp(56px, 10vw, 112px);
  }
</style>
