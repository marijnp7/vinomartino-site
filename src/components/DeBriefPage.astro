---
// LAT-13354: gedeelde /de-brief/-pagina voor NL en EN. Alle copy komt uit Directus
// `ui_strings` (keys `debrief.*`, defaults in src/lib/ui-strings.ts), HARDE REGEL 3.
// LAT-14779: doorverwijspagina. Substack is de enige plek voor brief en archief
// (mandaat Marijn 24-10, LAT-12605); de site toont geen edities meer.
import SiteLayout from '../layouts/SiteLayout.astro';
import Briefkaart from './Briefkaart.astro';
import SubstackCta from './SubstackCta.astro';
import { organizationSchema, breadcrumbSchema } from '../lib/seo';
import { SUBSTACK_URL } from '../lib/social';
import { loadUiStrings } from '../lib/ui-strings';
import { DEFAULT_LOCALE, HREFLANG, localePrefix, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = await loadUiStrings(locale);
const t = (k: string) => ui.t(k);
const prefix = localePrefix(locale);

// Kanaal-URLs komen uit src/lib/social.ts (een bron, geen drift). Substack is
// het enige nieuwsbriefkanaal (LAT-12309).
const archiveUrl = SUBSTACK_URL ? new URL('archive', SUBSTACK_URL).toString() : '';

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: 'Home', url: `${prefix}/` },
    { name: t('debrief.breadcrumb'), url: `${prefix}/de-brief/` },
  ]),
];
---

<SiteLayout
  title={t('debrief.meta.title')}
  description={t('debrief.meta.description')}
  schema={schema}
  activeNav="de-brief"
  locale={locale}
  alternates={{ nl: '/de-brief/', en: '/en/de-brief/' }}
>
  <section class="hero">
    <div class="container container-narrow">
      <span class="kicker">{t('debrief.kicker')}</span>
      <h1>{t('debrief.h1')}</h1>
      <p class="lede">{t('debrief.lede')}</p>

      <div class="signup">
        <SubstackCta placement="de-brief" ctaId="newsletter_signup" label={t('debrief.cta.label')} />
      </div>

      {archiveUrl && (
        <p class="archief">
          <a href={archiveUrl} target="_blank" rel="noopener" data-cta-id="substack_archive" hreflang={locale && locale !== DEFAULT_LOCALE ? HREFLANG[DEFAULT_LOCALE] : undefined}>{t('debrief.archief.label')}</a>
        </p>
      )}
    </div>
  </section>

  <section class="voorbeeld">
    <div class="container container-narrow">
      <Briefkaart dateline={t('debrief.waarde.dateline')}>
        <ul class="waarde">
          <li>{t('debrief.waarde.1')}</li>
          <li>{t('debrief.waarde.2')}</li>
          <li>{t('debrief.waarde.3')}</li>
        </ul>
        <p>{t('debrief.waarde.outro')}</p>
      </Briefkaart>
    </div>
  </section>
</SiteLayout>

<style>
  .container { max-width: 1280px; margin: 0 auto; padding-inline: var(--gutter); }
  .container-narrow { max-width: 760px; }

  .hero {
    padding: clamp(56px, 10vw, 112px) 0;
    text-align: center;
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-rust, #A14F2A);
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5vw + 1rem, 5rem);
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
    line-height: 0.95;
  }
  .lede {
    font-family: var(--font-serif, var(--font-body));
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--color-text-soft, var(--color-text));
    margin: 1.5rem auto 0;
    max-width: 600px;
  }
  .signup {
    margin: 2rem auto 0;
    max-width: 480px;
  }
  .archief {
    font-family: var(--font-serif, var(--font-body));
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-faint, var(--color-text-soft, var(--color-text)));
    margin: 1.25rem auto 0;
    max-width: 480px;
  }
  .archief a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .waarde { padding-left: 1.2rem; }
  .waarde li { margin-bottom: 0.5rem; }

  .voorbeeld {
    padding: 0 0 clamp(56px, 10vw, 112px);
  }
</style>
