---
import { DEFAULT_LOCALE, type Locale, localizeHref } from '../lib/i18n';
import { loadAtlasCopy } from '../lib/atlas-copy';
import { layoutAtlasLabels } from '../lib/atlas-labels';

// Administrative background and wine geography are separate layers. Generated
// from provenance-bearing geographic data by scripts/gen-country-regions.mjs.
interface RegionEntry { name: string; d: string; wine: boolean; labelAt: { x: number; y: number }; source?: string; resolution?: string }
interface RegionsFile {
  _meta: { viewBox: string; geometryVersion: string; wineResolution: string; wineSource: string };
  regions: Record<string, RegionEntry>;
}
const regionGeo = import.meta.glob<{ default: RegionsFile }>('../data/atlas/regions/*.json', { eager: true });
export interface RegionMeta { name?: string; color?: string; badge?: string; linkable?: boolean }
export interface Props { locale?: Locale; landSlug: string; landName: string; meta?: Record<string, RegionMeta>; kicker?: string; title?: string; intro?: string; class?: string }
const { landSlug, landName, meta = {}, kicker, title, intro, class: className, locale = DEFAULT_LOCALE } = Astro.props;
const file = regionGeo[`../data/atlas/regions/${landSlug}.json`]?.default;
const copy = file ? await loadAtlasCopy(locale) : {};
const t = (key: string) => (copy[`atlas.${key}`] ?? '').replace('{country}', landName);
const lh = (href: string) => localizeHref(href, locale);
const palette = ['#5A1A1F', '#A14F2A', '#5C6B3F'];
const box = (file?._meta.viewBox ?? '0 0 1000 1000').split(/\s+/).map(Number);
const radius = Math.max(box[2], box[3]) * .021;
const regions = Object.entries(file?.regions ?? {})
  .filter(([key, entry]) => entry.wine && meta[key])
  .map(([key, entry], i) => ({ key, entry, n: i + 1, name: meta[key].name || entry.name,
    color: meta[key].color || palette[i % palette.length],
    // Card fallback badges may be the country name rather than a grape.
    badge: meta[key].badge === landName ? undefined : meta[key].badge,
    linkable: meta[key].linkable !== false }));
const labels = layoutAtlasLabels(regions.map(r => r.entry.labelAt), box, radius);
const context = Object.values(file?.regions ?? {}).filter(e => !e.wine);
const sourceKey = landSlug === 'georgie' ? 'ge' : file?._meta.wineResolution === 'wine-origin' ? 'za' : 'eu';
---
{file && regions.length > 0 && (
  <section class:list={['crm', className]} data-geometry-version={file._meta.geometryVersion}>
    <div class="crm-intro">
      <p class="crm-kicker">{kicker ?? t('kicker')}</p>
      <h2 class="crm-title">{title ?? t('title')}</h2>
      <p class="crm-lede">{intro ?? t('intro')}</p>
      <ul class="crm-legend">
        {regions.map(r => {
          const Tag = r.linkable ? 'a' : 'span';
          return <li><Tag {...(r.linkable ? { href: lh(`/streken/${r.key}/`) } : {})}
            class="crm-legend__link" data-region={r.key} style={`--c:${r.color}`}>
            <span class="crm-number" aria-hidden="true">{r.n}</span>
            <span class="crm-legend__name">{r.name}</span>
            {r.badge && <span class="crm-legend__badge">{r.badge}</span>}
          </Tag></li>;
        })}
      </ul>
    </div>
    <div class="crm-mapcolumn">
      <nav class="crm-mapwrap" aria-label={t('mapLabel')}>
        <svg viewBox={file._meta.viewBox} class="crm-map" aria-label={t('mapLabel')} xmlns="http://www.w3.org/2000/svg">
          <title>{t('mapLabel')}</title>
          <g class="crm-context" aria-hidden="true">
            {context.map(entry => <path d={entry.d} />)}
          </g>
          <g class="crm-regions">
            {regions.map(r => {
              const Tag = r.linkable ? 'a' : 'g';
              return <Tag {...(r.linkable ? { href: lh(`/streken/${r.key}/`) } : {})}
                class="crm-region" style={`--c:${r.color}`} data-region={r.key} data-name={r.name} aria-label={r.name}>
                <title>{r.badge ? `${r.name}, ${r.badge}` : r.name}</title>
                <path d={r.entry.d} class="crm-fill" fill-rule="evenodd" />
              </Tag>;
            })}
          </g>
          <g class="crm-labels">
            {regions.map((r,i) => {
              const Tag = r.linkable ? 'a' : 'g';
              const p = labels[i], anchor = r.entry.labelAt;
              return <Tag {...(r.linkable ? { href: lh(`/streken/${r.key}/`), tabindex: '-1' } : {})}
                class="crm-pin" data-region={r.key} style={`--c:${r.color}`} aria-label={r.name}>
                <title>{r.name}</title>
                <line x1={anchor.x} y1={anchor.y} x2={p.x} y2={p.y} class="crm-leader" />
                <circle cx={p.x} cy={p.y} r={radius * 1.25} fill="transparent" />
                <circle cx={p.x} cy={p.y} r={radius} class="crm-dot" />
                <text x={p.x} y={p.y} text-anchor="middle" dominant-baseline="central" font-size={radius * 1.05}>{r.n}</text>
              </Tag>;
            })}
          </g>
        </svg>
      </nav>
      <p class="crm-method">{t(sourceKey === 'ge' ? 'region.method.ge' : file._meta.wineResolution === 'wine-origin' ? 'method.wineOrigin' : 'method.municipality')}</p>
      <details class="crm-sources"><summary>{t('sources')}</summary>
        <a href={file._meta.wineSource}>{t(`source.${sourceKey}`)}</a>
        <a href="https://www.naturalearthdata.com/">{t('source.base')}</a>
      </details>
    </div>
  </section>
)}
<style>
  .crm { display:grid; grid-template-columns:minmax(0,1fr); gap:1.5rem; margin-bottom:var(--space-8); }
  .crm-intro,.crm-mapcolumn { min-width:0; }
  .crm-kicker { margin:0 0 .5rem; font-family:var(--font-mono,monospace); font-size:.7rem; letter-spacing:.14em; text-transform:uppercase; color:var(--inkSoft); }
  .crm-title { margin:0 0 .7rem; font-family:var(--font-display,'Cormorant Garamond',serif); font-size:clamp(1.8rem,3vw,2.5rem); line-height:1.1; color:var(--ink); }
  .crm-lede { margin:0 0 1.2rem; max-width:40ch; color:var(--inkSoft); line-height:1.55; }
  .crm-legend { list-style:none; margin:0; padding:0; }
  .crm-legend li { margin:0; }
  .crm-legend__link { display:flex; align-items:center; gap:.7rem; min-height:44px; padding:.55rem .25rem; border-bottom:1px solid var(--ruleSoft); color:var(--ink); text-decoration:none; border-radius:3px; }
  .crm-legend li:last-child .crm-legend__link { border-bottom:0; }
  .crm-number { flex:none; display:inline-flex; align-items:center; justify-content:center; width:1.5rem; height:1.5rem; border-radius:50%; background:var(--c); color:#fffaf0; font-family:var(--font-mono,monospace); font-size:.72rem; font-weight:600; }
  .crm-legend__name { font-family:var(--font-display,'Cormorant Garamond',serif); font-size:1.2rem; line-height:1.2; }
  .crm-legend__badge { margin-left:auto; max-width:45%; text-align:right; font-family:var(--font-mono,monospace); font-size:.62rem; letter-spacing:.04em; text-transform:uppercase; color:var(--inkSoft); }
  .crm-legend__link:is(:hover,:focus-visible,[data-active]) { background:var(--paperDeep); }
  .crm-legend__link:focus-visible { outline:2px solid var(--c); outline-offset:2px; }
  .crm-mapwrap { border:1px solid var(--ruleSoft); background:var(--paperDeep); overflow:hidden; }
  .crm-map { display:block; width:100%; height:auto; max-height:720px; }
  .crm-context { fill:var(--inkFaint,#8A7E70); fill-opacity:.08; stroke:var(--inkFaint,#8A7E70); stroke-width:.65; stroke-opacity:.4; pointer-events:none; }
  .crm-fill { fill:var(--c); fill-opacity:.3; stroke:var(--c); stroke-width:1.2; stroke-opacity:.85; transition:fill-opacity .16s; }
  .crm-region:is(:hover,:focus-visible,[data-active]) .crm-fill { fill-opacity:.65; stroke-opacity:1; stroke-width:2.5; }
  .crm-region:focus-visible { outline:none; }
  .crm-pin { cursor:pointer; }
  .crm-dot { fill:var(--c); stroke:var(--paperDeep,#F0E6D0); stroke-width:3; }
  .crm-pin:is(:hover,[data-active]) .crm-dot { stroke:var(--ink); stroke-width:3; }
  .crm-pin text { font-family:var(--font-mono,monospace); font-weight:600; fill:#fffaf0; pointer-events:none; }
  .crm-leader { stroke:var(--c); stroke-width:1.5; pointer-events:none; }
  .crm-method { color:var(--inkSoft); font-size:.78rem; line-height:1.5; margin:.75rem 0 .45rem; }
  .crm-sources { color:var(--inkSoft); font-size:.72rem; line-height:1.6; }
  .crm-sources summary { cursor:pointer; }
  .crm-sources a { display:block; color:inherit; text-underline-offset:2px; }
  @media(min-width:960px) { .crm { grid-template-columns:minmax(0,1fr) minmax(330px,520px); gap:var(--space-8); align-items:start; } }
  @media(max-width:759px) { .crm-mapcolumn { grid-row:2; } .crm-legend__badge { font-size:.58rem; } }
  @media(prefers-reduced-motion:reduce) { .crm-fill { transition:none; } }
</style>
<script>
  // Links work without JS. Hover/focus synchronises the legend and SVG layers.
  document.querySelectorAll<HTMLElement>('.crm').forEach(root => {
    const items = [...root.querySelectorAll<HTMLElement>('[data-region]')];
    const activate = (key?: string) => items.forEach(item => item.toggleAttribute('data-active', Boolean(key && item.dataset.region === key)));
    items.forEach(item => {
      item.addEventListener('pointerenter', () => activate(item.dataset.region));
      item.addEventListener('pointerleave', () => activate());
      item.addEventListener('focus', () => activate(item.dataset.region));
      item.addEventListener('blur', () => activate());
    });
  });
</script>
