---
// LAT-2022: Langhe capture block. Variant: A = mid-article, C = homepage-style.
// CTA gaat naar de Substack-aanmeldpagina (LAT-12309).

// LAT-2868 — locale-aware via de UI-dictionary: de NL-varianten staan als
// `langhe.capture.<variant>.*`-defaults in ui-strings.ts; /en/ overlayt via
// loadUiStrings(locale). NL blijft byte-identiek (t() valt terug op de defaults).
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import { loadUiStrings } from '../lib/ui-strings';
import SubstackCta from './SubstackCta.astro';

export interface Props {
  variant?: 'a' | 'c';
  /** LAT-2868 — locale van de renderende pagina; stuurt de dictionary-overlay. */
  locale?: Locale;
}

const { variant = 'a', locale = DEFAULT_LOCALE } = Astro.props;
const ui = await loadUiStrings(locale);

const copy = {
  koptekst: ui.t(`langhe.capture.${variant}.koptekst`),
  body: ui.t(`langhe.capture.${variant}.body`),
  ctaText: ui.t(`langhe.capture.${variant}.ctaText`),
  subCopy: ui.t(`langhe.capture.${variant}.subCopy`),
};
---

<section class:list={['langhe-capture-block', `langhe-capture-block--${variant}`]}>
  <div class="capture-inner">
    <h2 class="capture-koptekst">{copy.koptekst}</h2>
    <p class="capture-body">{copy.body}</p>

    <div class="capture-form">
      <SubstackCta placement={`langhe-capture-${variant}`} ctaId="langhe_pdf_signup" label={copy.ctaText} />
    </div>

    <p class="capture-subtext">{copy.subCopy}</p>
  </div>
</section>

<style>
  .langhe-capture-block {
    margin: var(--space-12) 0;
    padding: var(--space-8) var(--space-6);
    background: var(--paperDeep);
    border-radius: 4px;
  }

  .langhe-capture-block--c {
    background: var(--paper);
    padding: var(--space-12) var(--space-8);
    margin: var(--space-16) 0;
  }

  .capture-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .capture-koptekst {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.5rem, 2vw, 2rem);
    line-height: 1.1;
    color: var(--ink);
    margin: 0 0 var(--space-4);
  }

  .capture-body {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--inkSoft);
    margin: 0 0 var(--space-6);
  }

  .capture-form {
    margin-bottom: var(--space-4);
  }

  .capture-subtext {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--inkFaint);
    margin: 0;
  }
</style>
