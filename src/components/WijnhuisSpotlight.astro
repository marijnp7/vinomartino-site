---
// LAT-13075 — "Wijnhuis in de spotlight": precies één redactioneel uitgelicht huis.
// Data en regels: src/lib/wijnhuis-spotlight.ts. Naam, regio, bezoekstatus en beeld
// komen uit het gekoppelde huis; teaser uit `wijnhuis_spotlight`; labels uit ui_strings.
import SmartImg from './SmartImg.astro';
import { localizePath, type Locale } from '../lib/i18n';
import type { SpotlightEntry } from '../lib/wijnhuis-spotlight';
import { loadStrekenNav } from '../lib/streken';
import { loadLandenNav } from '../lib/landen';

interface Props {
  entries: SpotlightEntry[];
  locale: Locale;
  ui: { t: (key: string) => string };
  plaats: 'home' | 'index';
  buildNow?: number;
}
const { entries, locale, ui, plaats, buildNow = Date.now() } = Astro.props;
// Buildtijd-winnaar zichtbaar zonder JS; het script hieronder herkiest op de klok van nu.
const winnerId = entries.find((e) => e.start <= buildNow && buildNow < e.end)?.id ?? null;
// LAT-13464 — "Langhe, Italië": `wijnhuizen.country` is vaak leeg; dan het land van de
// gekoppelde streek (streek.land_id → landen, taalbewust). Lichte nav-loaders, geen assets.
const needsLand = entries.some((e) => !e.huis.country && e.huis.streekSlug);
const [strekenNav, landenNav] = needsLand
  ? await Promise.all([loadStrekenNav(locale).catch(() => []), loadLandenNav(locale).catch(() => [])])
  : [[], []];
const landVan = (e: SpotlightEntry) => {
  if (e.huis.country) return e.huis.country;
  const landSlug = strekenNav.find((s) => s.slug === e.huis.streekSlug)?.landSlug;
  return landenNav.find((l) => l.slug === landSlug)?.name ?? '';
};
---
{entries.length > 0 && (
  <section class={`whs whs--${plaats} container`} data-whs data-whs-plaats={plaats} aria-label={ui.t('wijnhuis.spotlight.aria')} hidden={winnerId === null}>
    {entries.map((e) => {
      const href = localizePath(`/wijnhuizen/${e.huis.slug}/`, locale);
      const bezoek = e.huis.portret.bezoekType
        ? `${ui.t('wijnhuis.bezoek.eyebrow')}: ${ui.t(`wijnhuis.bezoek.${e.huis.portret.bezoekType}`)}`
        : ui.t('wijnhuizen.card.bezoekOnbekend');
      return (
        <article class="whs-item" data-whs-item data-start={e.start} data-end={e.end} data-huis={e.huis.slug} data-campagne={e.campagneId} hidden={e.id !== winnerId}>
          <div class="whs-media">
            <SmartImg src={e.huis.heroImage || undefined} alt={e.huis.name} theme="winery" class="whs-img" />
            {/^https?:\/\//.test(e.huis.website)
              ? <a class="whs-credit" href={e.huis.website} target="_blank" rel="noopener">{ui.t('wijnhuis.reeks.foto')}: {e.huis.name}</a>
              : <span class="whs-credit">{ui.t('wijnhuis.reeks.foto')}: {e.huis.name}</span>}
          </div>
          <div class="whs-body">
            <span class="whs-kicker">{ui.t('wijnhuis.spotlight.kicker')}</span>
            <h2 class="whs-title">{e.huis.name}</h2>
            <p class="whs-meta">{(e.huis.region || landVan(e)) && <span class="whs-region">{[e.huis.region, landVan(e)].filter(Boolean).join(', ')}</span>}<span class="whs-bezoek">{bezoek}</span></p>
            <p class="whs-teaser">{e.teaser}</p>
            <a href={href} class="whs-cta" data-whs-cta>{ui.t('wijnhuis.spotlight.cta')}</a>
          </div>
        </article>
      );
    })}
  </section>
)}

<script is:inline>
  (function () {
    // Kiest op de klok van nu en plant een herberekening op de eerstvolgende
    // start/einde, zodat een open tabblad niet blijft hangen op een verlopen
    // spotlight. Ook na terugkeer uit bfcache en bij weer zichtbaar worden.
    var timer = null;
    function apply() {
      var now = Date.now(), next = Infinity;
      document.querySelectorAll('[data-whs]').forEach(function (sec) {
        var items = Array.prototype.slice.call(sec.querySelectorAll('[data-whs-item]'));
        // HTML-volgorde = prioriteit (laatst gestart eerst, dan laagste id): eerste actieve wint.
        var win = items.filter(function (el) { return +el.dataset.start <= now && now < +el.dataset.end; })[0] || null;
        items.forEach(function (el) {
          el.hidden = el !== win;
          [+el.dataset.start, +el.dataset.end].forEach(function (t) { if (t > now && t < next) next = t; });
        });
        sec.hidden = !win;
      });
      clearTimeout(timer);
      // setTimeout loopt over bij > 2^31-1 ms; daarna gewoon opnieuw rekenen.
      if (next !== Infinity) timer = setTimeout(apply, Math.min(next - now + 50, 2147483647));
    }
    apply();
    window.addEventListener('pageshow', apply);
    document.addEventListener('visibilitychange', function () { if (!document.hidden) apply(); });
  })();
</script>

<script>
  import { trackEvent } from '../lib/site-events';
  document.querySelectorAll<HTMLElement>('[data-whs]').forEach((sec) => {
    sec.addEventListener('click', (ev) => {
      const cta = (ev.target as HTMLElement).closest('[data-whs-cta]');
      const item = cta?.closest<HTMLElement>('[data-whs-item]');
      if (!item) return;
      // cta_id = spotlight:<plaats>:<huis-slug>:<campagne>; taal en pad zet site-events zelf,
      // intern/bot-verkeer sluit site-events zelf uit.
      trackEvent('cta_click', { cta_id: `spotlight:${sec.dataset.whsPlaats}:${item.dataset.huis}:${item.dataset.campagne}` });
    });
  });
</script>

<style>
  .whs { margin-block: 1.5rem; padding-inline: var(--gutter); }
  .whs[hidden], .whs-item[hidden] { display: none; }
  .whs-item { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); background: #fff; border: 0; border-top: 3px solid var(--burgundy); box-shadow: var(--shadow-sm); border-radius: var(--radius-card); overflow: hidden; }
  .whs-media { display: block; position: relative; aspect-ratio: 4 / 3; overflow: hidden; }
  .whs-credit { position: absolute; right: 0; bottom: 0; padding: .2rem .5rem; font: .7rem/1.3 var(--font-sans, Inter, sans-serif); color: #fff; background: rgba(0, 0, 0, .75); text-decoration: none; }
  /* .75 zwart: ook op een witte foto blijft wit-op-#404040 ≥10:1 (eis ≥4.5:1). */
  a.whs-credit:hover { text-decoration: underline; }
  .whs-media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .whs-body { padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: .35rem; justify-content: center; }
  .whs-kicker { font: 600 .75rem/1.2 var(--font-sans, Inter, sans-serif); letter-spacing: .08em; text-transform: uppercase; color: var(--burgundy); }
  .whs-title { font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: clamp(1.6rem, 3vw, 2.2rem); line-height: 1.1; margin: 0; color: var(--ink, #2a1f1a); }
  .whs-meta { margin: 0; display: flex; flex-direction: column; gap: .35rem; font-size: .9rem; color: var(--inkSoft, #5a4d44); }
  .whs-teaser { margin: .25rem 0; }
  .whs-cta { align-self: flex-start; margin-top: .5rem; padding: .6rem 1.1rem; background: var(--burgundy); color: var(--fixed-cream, #f7f1e8); text-decoration: none; border-radius: 3px; min-height: 44px; display: inline-flex; align-items: center; box-sizing: border-box; font: 600 .9rem/1.2 var(--font-sans, Inter, sans-serif); }
  .whs-cta:hover { filter: brightness(1.1); }
  .whs-cta:focus-visible, a.whs-credit:focus-visible { outline: 3px solid var(--accent-apricot); outline-offset: 2px; box-shadow: var(--focus-ring); }
  /* Home: kleinere versie. Index: compact zodat filters op 320/390 direct bereikbaar blijven. */
  /* LAT-13468 #1: ook de index smal (1/3 beeld, 3:2) en teaser op twee regels, zodat het
     blok op 1280 ≤ 280 px blijft en het filterpaneel bij 1280×800 boven de vouw staat. */
  .whs--home .whs-item, .whs--index .whs-item { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }
  .whs--index .whs-media { aspect-ratio: 3 / 2; }
  @media (min-width: 721px) {
    .whs-teaser { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }
  }
  @media (max-width: 720px) {
    .whs { margin-block: 1rem; }
    /* LAT-13473: .whs--index-regels hierboven zijn specifieker; zonder deze selectors wonnen 1fr/2fr en 3:2 op mobiel. */
    .whs-item, .whs--home .whs-item, .whs--index .whs-item { grid-template-columns: 88px minmax(0, 1fr); }
    .whs-media, .whs--index .whs-media { aspect-ratio: auto; height: 100%; }
    .whs-body { padding: .75rem .9rem; gap: .2rem; }
    .whs-title { font-size: 1.35rem; }
    .whs-teaser { display: none; }
    .whs-meta { flex-direction: row; flex-wrap: wrap; gap: 0 .4rem; font-size: .85rem; }
    .whs-region + .whs-bezoek::before { content: '·'; margin-right: .4rem; }
    .whs-credit { left: 0; font-size: .6rem; padding: .1rem .3rem; text-align: right; }
    .whs-cta { padding: .5rem .9rem; }
  }
  /* LAT-13468 #2: op 320 brak "· Visit: …" af met de punt vooraan; smal = twee regels zonder punt. */
  @media (max-width: 360px) {
    .whs-meta { flex-direction: column; gap: 0; }
    .whs-region + .whs-bezoek::before { content: none; }
  }
</style>
