---
// LAT-2009 (VIS-BL-10) — Streek-feitenblok "In het kort 2.0". Vervangt de oude
// WijnFactBox (LAT-1676) en de dubbele druivenlijst in de hero-sidebar: druiven
// staan nu nog maar op één plek, hier. Monospace labels, scanbare feiten.
//
// Kernrijen (VIS-BL-10): druiven, beste seizoen, rijdagen, dichtstbijzijnd
// vliegveld, aantal adressen. Plus de bestaande wijndetailrijen (appellatie,
// jaargangen, oogst, bezoektijd, budget). Elke rij verschijnt alleen als de
// waarde gevuld is — geen lege box, geen "coming soon".
//
// Content komt uit Directus (streken-loader); `aantalAdressen` is afgeleid uit de
// gerenderde POI-telling. De tier-badge komt uit het twee-tier model (LAT-1958):
// Tier 1 = zelf gereisd, Tier 2 = redactiegids. Feitlabels komen voor beide
// talen rechtstreeks uit Directus via overview-copy; de bestaande badges blijven staan.
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import AtAGlance from './AtAGlance.astro';
import { loadOverviewCopy } from '../lib/overview-copy';
import { loadUiStrings } from '../lib/ui-strings';

interface Props {
  dominantGrapes?: string[];
  bestSeason?: string;
  driveDays?: string;
  nearestAirport?: string;
  aantalAdressen?: number;
  appellations?: string[];
  bestVintages?: string;
  harvestPeriod?: string;
  minVisitTime?: string;
  tastingBudget?: string;
  visited?: boolean;
  bezoekjaar?: number | null;
  locale?: Locale;
}

const {
  dominantGrapes = [],
  bestSeason = '',
  driveDays = '',
  nearestAirport = '',
  aantalAdressen = 0,
  appellations = [],
  bestVintages = '',
  harvestPeriod = '',
  minVisitTime = '',
  tastingBudget = '',
  visited = false,
  bezoekjaar = null,
  locale = DEFAULT_LOCALE,
} = Astro.props;

const ui = await loadUiStrings(locale);
const factsCopy = await loadOverviewCopy(locale);

const rows: Array<{ label: string; value: string }> = [];
if (dominantGrapes.length) rows.push({ label: factsCopy.t('streek.feit.druiven'), value: dominantGrapes.join(', ') });
if (bestSeason.trim()) rows.push({ label: factsCopy.t('streek.feit.besteSeizoen'), value: bestSeason.trim() });
if (driveDays.trim()) rows.push({ label: factsCopy.t('streek.feit.rijdagen'), value: driveDays.trim() });
if (nearestAirport.trim()) rows.push({ label: factsCopy.t('streek.feit.vliegveld'), value: nearestAirport.trim() });
if (aantalAdressen > 0) rows.push({ label: factsCopy.t('streek.feit.aantalAdressen'), value: String(aantalAdressen) });
if (appellations.length) rows.push({ label: factsCopy.t('streek.feit.appellatieniveau'), value: appellations.join(', ') });
if (bestVintages.trim()) rows.push({ label: factsCopy.t('streek.feit.besteJaargangen'), value: bestVintages.trim() });
if (harvestPeriod.trim()) rows.push({ label: factsCopy.t('streek.feit.oogstperiode'), value: harvestPeriod.trim() });
if (minVisitTime.trim()) rows.push({ label: factsCopy.t('streek.feit.minBezoektijd'), value: minVisitTime.trim() });
if (tastingBudget.trim()) rows.push({ label: factsCopy.t('streek.feit.budgetProeverij'), value: tastingBudget.trim() });

const tierLabel = visited ? ui.t('ui.badge.zelfGereisd') : ui.t('ui.badge.redactiegids');
const tierTitle = visited ? ui.t('ui.badge.zelfGereisd.title') : ui.t('ui.badge.redactiegids.title');
---

{rows.length > 0 && (
  <aside class="vm-feitenblok" aria-label={factsCopy.t('streek.feit.ariaLabel')}>
    <div class="vm-feitenblok__head">
      <h2 class="vm-feitenblok__heading">{factsCopy.t('streek.feit.heading')}</h2>
      <span
        class:list={['vm-feitenblok__tier', visited ? 'vm-feitenblok__tier--visited' : 'vm-feitenblok__tier--redactie']}
        title={tierTitle}
      >
        <span class="vm-feitenblok__tier-dot" aria-hidden="true"></span>
        {tierLabel}{visited && bezoekjaar ? <span class="vm-feitenblok__tier-year"> &middot; {bezoekjaar}</span> : null}
      </span>
    </div>
    <AtAGlance facts={rows} />
  </aside>
)}

<style>
  .vm-feitenblok {
    color: var(--ink);
  }

  .vm-feitenblok__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }

  .vm-feitenblok__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.1;
    color: var(--ink);
  }

  .vm-feitenblok__tier {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: #f2ede2;
    border: 1px solid #d8cdb4;
    color: #6b5a34;
  }

  .vm-feitenblok__tier--redactie {
    background: #eef1f4;
    border-color: #cdd6df;
    color: #47555f;
  }

  .vm-feitenblok__tier-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #9a7d2e;
  }

  .vm-feitenblok__tier--redactie .vm-feitenblok__tier-dot {
    background: #6b7b88;
  }

  .vm-feitenblok__tier-year {
    opacity: 0.75;
  }

</style>
