---
/**
 * LAT-13056 — Variant A "Vlot": gedeelde, beeld-gedreven artikelkaart voor de
 * homepage-feed en de artikellijst. Puur presentatie: de aanroeper levert het
 * beeld via de `media`-slot (eigen <img>/SmartImg, zodat beeldherkomst en
 * loaders ongewijzigd blijven) en alle data uit het bestaande artikel-record.
 * Alle zichtbare copy komt uit de UI-dictionary (`card.*`).
 */
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import { loadUiStrings } from '../lib/ui-strings';

interface Props {
  href: string;
  title: string;
  kicker?: string | null;
  zelfGereisd?: boolean;
  bezoekjaar?: number | null;
  /** Optioneel label linksboven op het beeld (bv. "Nieuw"). */
  tag?: string | null;
  /** 'feed' = staand 4:5, 'hero' = groter staand 3:4. */
  variant?: 'feed' | 'hero';
  headingLevel?: 'h2' | 'h3';
  locale?: Locale;
  /** Extra attributen op de <a> (bv. data-* voor de facet-filter). */
  attrs?: Record<string, string>;
}

const {
  href,
  title,
  kicker = null,
  zelfGereisd = false,
  bezoekjaar = null,
  tag = null,
  variant = 'feed',
  headingLevel = 'h3',
  locale = DEFAULT_LOCALE,
  attrs = {},
} = Astro.props;
const ui = await loadUiStrings(locale);
const Heading = headingLevel;
---
<a href={href} class:list={['vm-card', `vm-card--${variant}`]} {...attrs}>
  <div class="vm-card__media">
    <slot name="media" />
    {tag && <span class="vm-card__tag">{tag}</span>}
    {zelfGereisd && (
      <span class="vm-card__sticker">
        {ui.t('card.sticker.zelfGereisd')}{bezoekjaar ? ` · ${bezoekjaar}` : ''}
      </span>
    )}
  </div>
  <div class="vm-card__body">
    {kicker && <span class="vm-card__kicker">{kicker}</span>}
    <Heading class="vm-card__title">{title}</Heading>
    <span class="vm-card__more">{ui.t('card.leesVerder')}</span>
  </div>
</a>

<style>
  .vm-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    color: var(--fixed-ink);
    border-radius: var(--radius-card);
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }
  .vm-card[hidden] { display: none; }
  .vm-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--paperDeep);
  }
  .vm-card--hero .vm-card__media { aspect-ratio: 3 / 4; }
  .vm-card__media :global(img),
  .vm-card__media :global(.smart-img-placeholder),
  .vm-card__media :global(.card-placeholder) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-image) var(--ease-out);
  }
  .vm-card__tag,
  .vm-card__sticker {
    position: absolute;
    left: 0.75rem;
    z-index: 1;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }
  .vm-card__tag {
    top: 0.75rem;
    background: var(--fixed-ink);
    color: var(--fixed-cream);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  /* Apricot is alleen vulling: tekst altijd --fixed-ink (5.2:1). */
  .vm-card__sticker {
    bottom: 0.75rem;
    background: var(--accent-apricot);
    color: var(--fixed-ink);
  }
  .vm-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.1rem 1.2rem;
    flex: 1;
  }
  .vm-card__kicker {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5A4F45;
  }
  .vm-card__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.45rem;
    line-height: 1.15;
    margin: 0;
    color: var(--fixed-ink);
  }
  .vm-card--hero .vm-card__title { font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem); }
  .vm-card__more {
    margin-top: auto;
    padding-top: 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--fixed-ink);
  }
  .vm-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-lift);
  }
  .vm-card:hover .vm-card__media :global(img) { transform: scale(1.06); }
  .vm-card:hover .vm-card__more { text-decoration: underline; text-underline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .vm-card,
    .vm-card__media :global(img) { transition: none; }
    .vm-card:hover { transform: none; }
    .vm-card:hover .vm-card__media :global(img) { transform: none; }
  }
</style>
