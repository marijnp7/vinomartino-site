---
// LAT-12710 — hero van de één-pagina-route: grote foto, H1, tagline, badge "Zelf gereisd"
// en twee ankerknoppen (slapen / route).
interface Props {
  h1: string;
  tagline?: string | null;
  badge?: string | null;
  foto?: string | null;
  fotoAlt?: string | null;
  /** Credit-regel onder de foto (HTML-veilig: alleen tekst). */
  credit?: string | null;
  knopSlapen?: string | null;
  knopRoute?: string | null;
  slapenHref?: string;
  routeHref?: string;
}
const { h1, tagline, badge, foto, fotoAlt, credit, knopSlapen, knopRoute, slapenHref = '#slapen', routeHref = '#route' } = Astro.props;
---

<header class:list={['rhero', !foto && 'rhero--plain']}>
  {foto && <img class="rhero__img" src={foto} alt={fotoAlt || h1} loading="eager" fetchpriority="high" />}
  <div class="rhero__shade" aria-hidden="true"></div>
  <div class="container rhero__inner">
    {badge && <span class="rhero__badge">{badge}</span>}
    <h1 class="rhero__h1">{h1}</h1>
    {tagline && <p class="rhero__tagline">{tagline}</p>}
    {(knopSlapen || knopRoute) && (
      <div class="rhero__cta">
        {knopSlapen && <a class="rhero__btn rhero__btn--primary" href={slapenHref}>{knopSlapen}</a>}
        {knopRoute && <a class="rhero__btn" href={routeHref}>{knopRoute}</a>}
      </div>
    )}
  </div>
  {credit && foto && <p class="rhero__credit">{credit}</p>}
</header>

<style>
  .rhero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(26rem, 62vh, 40rem);
    overflow: hidden;
    background: var(--ink);
    color: #fff;
  }
  .rhero--plain { background: var(--burgundy); min-height: 18rem; }
  .rhero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rhero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.45) 45%, rgba(0, 0, 0, 0.1) 100%);
  }
  .rhero__inner {
    position: relative;
    padding-top: var(--space-10);
    padding-bottom: var(--space-8);
    max-width: 52rem;
    margin-left: 0;
  }
  .rhero__badge {
    display: inline-block;
    margin-bottom: var(--space-3);
    padding: 0.25rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 1px;
  }
  .rhero__h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2.6vw, 3.25rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.12;
    color: #fff;
    margin: 0 0 var(--space-4);
    overflow-wrap: anywhere;
  }
  .rhero__tagline {
    font-family: var(--font-body);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.25rem);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.92);
    margin: 0 0 var(--space-6);
    max-width: 38rem;
  }
  .rhero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .rhero__btn {
    display: inline-block;
    padding: 0.8rem 1.4rem;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: var(--radius-sm);
  }
  .rhero__btn--primary { background: var(--burgundy); border-color: var(--burgundy); }
  .rhero__btn:hover { text-decoration: underline; }
  .rhero__credit {
    position: absolute;
    right: 0;
    bottom: 0;
    max-width: 100%;
    margin: 0;
    padding: 0.25rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1.3;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
  }
  @media (max-width: 640px) {
    .rhero { min-height: 30rem; }
    .rhero__btn { flex: 1 1 100%; text-align: center; }
  }
</style>
