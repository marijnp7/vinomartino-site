---
import AtAGlance from './AtAGlance.astro';
import { loadOverviewCopy } from '../lib/overview-copy';
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
interface Props { duration?: string; transport?: string; style?: string; stopsCount?: number; wijnhuisCount?: number; locale?: Locale; }
const { duration, transport, style, stopsCount, wijnhuisCount, locale = DEFAULT_LOCALE } = Astro.props;
const copy = await loadOverviewCopy(locale);
const cells = [
 { label: copy.t('overview.duration'), value: duration ?? '' },
 { label: copy.t('overview.transport'), value: transport ?? '' },
 { label: copy.t('overview.stops'), value: stopsCount && stopsCount > 0 ? String(stopsCount) : '' },
 { label: copy.t('overview.wineries'), value: wijnhuisCount && wijnhuisCount > 0 ? String(wijnhuisCount) : '' },
 { label: copy.t('overview.style'), value: style ?? '' },
];
---
<div class="route-overview"><AtAGlance facts={cells} /></div>
<style>.route-overview { margin-bottom: var(--space-8); }</style>
