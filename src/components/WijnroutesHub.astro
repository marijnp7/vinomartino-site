---
// WijnroutesHub — het ene overzicht van alle wijnroutes (NL /wijnroutes/, EN /en/wijnroutes/).
//
// Besluit 2026-10-05 (Marijn, analyse Claude): "Reizen" (/reizen-nareizen/) en
// "Wijnroutes" bestonden naast elkaar met grotendeels dezelfde inhoud. De bezoeker
// zoekt één ding: een plan met slaapadres en wijnhuizen. Daarom is er nog één hub,
// /wijnroutes/, met het ontwerp van de oude Reizen-hub (LAT-12451): de verhalen van
// Marijn bovenaan, filters op land en duur, en het label Zelf gereisd/Redactiegids.
// De verhalen (reispakketten) hebben geen eigen pagina meer; ze staan als blok
// "Zo reisden wij hem" op de routepagina van dezelfde streek (ReisVerhaal.astro).
// /reizen-nareizen/* gaat met een 301 naar de routes (nginx-prod.conf).
import SiteLayout from '../layouts/SiteLayout.astro';
import SmartImg from '../components/SmartImg.astro';
import AccommodatieKaart from '../components/AccommodatieKaart.astro';
import HomeRoutesMap from '../components/HomeRoutesMap.astro';
import NewsletterFooter from '../components/NewsletterFooter.astro';
import { loadReispakketten, type ReisPakket } from '../lib/reispakketten';
import { loadRoutes } from '../lib/routes';
import { loadStreken } from '../lib/streken';
import { routeDagen, dagenBucket, routeWijnhuizen, routeLand, orderRoutes } from '../lib/reizen-hub';
import { organizationSchema, breadcrumbSchema } from '../lib/seo';
import { loadUiStrings } from '../lib/ui-strings';
import { DEFAULT_LOCALE, localizePath, type Locale } from '../lib/i18n';
import { VERHAAL_ANCHOR, verhaalInRouteBody } from '../lib/reis-verhaal';

interface Props {
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale = DEFAULT_LOCALE, alternates } = Astro.props;
const ui = await loadUiStrings(locale);

const routes = await loadRoutes(locale);
const streken = await loadStreken(locale);
const landByStreek = new Map(streken.filter((s) => s.country).map((s) => [s.slug, s.country]));

// Koppeling verhaal <-> route via de gedeelde streek (geen nieuw Directus-veld nodig).
function routeFor(entry: ReisPakket) {
  return entry.streekSlug ? routes.find((r) => r.streekSlug === entry.streekSlug) : undefined;
}
// Een verhaal zonder route in dezelfde streek heeft geen landingsplek meer en valt af.
const entries = (await loadReispakketten(locale)).filter((e) => routeFor(e));
const verhaalHref = (entry: ReisPakket) => {
  const slug = routeFor(entry)!.slug;
  return localizePath(`/wijnroutes/${slug}/${verhaalInRouteBody(slug) ? '' : `#${VERHAAL_ANCHOR}`}`, locale);
};
const routeHref = (entry: ReisPakket) => localizePath(`/wijnroutes/${routeFor(entry)!.slug}/`, locale);

function timestamp(entry: ReisPakket): number {
  const t = entry.pubDate ? Date.parse(entry.pubDate) : NaN;
  return Number.isNaN(t) ? -Infinity : t;
}
const sorted = [...entries].sort((a, b) => timestamp(b) - timestamp(a) || a.titel.localeCompare(b.titel));
// Feature volgens het goedgekeurde ontwerp (LAT-12451): de Mosel-reis (Marijn zelf in beeld); anders de nieuwste.
const featured = sorted.find((e) => e.streekSlug.startsWith('mosel')) ?? sorted[0];
const restNareizen = sorted.filter((e) => e !== featured);

// Hero: het Langhe-beeld (eigen foto), anders het nieuwste verhaal met beeld, anders een route-hero.
const heroEntry =
  sorted.find((e) => e.streekSlug.startsWith('langhe') && e.heroImage) ?? sorted.find((e) => e.heroImage);
const heroImage = heroEntry?.heroImage ?? routes.find((r) => r.zelfGereisd && r.heroImage)?.heroImage ?? null;

const enriched = orderRoutes(routes).map((route) => {
  const dagen = routeDagen(route);
  return {
    route,
    dagen,
    bucket: dagenBucket(dagen),
    wijnhuizen: routeWijnhuizen(route),
    land: routeLand(route, landByStreek),
  };
});
// LAT-13062 — korte routetitel = streeknaam uit het CMS (NL/EN), zolang die uniek is
// binnen de routes; anders de redactionele titel. Geen hardcoded copy.
const streekNaam = new Map(streken.map((s) => [s.slug, s.name]));
const perStreek = new Map<string, number>();
for (const { route } of enriched) if (route.streekSlug) perStreek.set(route.streekSlug, (perStreek.get(route.streekSlug) ?? 0) + 1);
const kortVoor = (route: (typeof routes)[number]) =>
  (route.streekSlug && perStreek.get(route.streekSlug) === 1 && streekNaam.get(route.streekSlug)) || route.title;
const fold = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
const zelfRoutes = enriched.filter((r) => r.route.zelfGereisd);
const redactieRoutes = enriched.filter((r) => !r.route.zelfGereisd);
const landen = [...new Set(enriched.map((r) => r.land).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'nl'));
const buckets = (['1-2', '3-4', '5+'] as const).filter((b) => enriched.some((r) => r.bucket === b));
const bucketLabel = (b: string) => ui.t(`reizen.chip.dagen.${b}`);
const lijst = [...zelfRoutes, ...redactieRoutes];
const telling = (n: number) => (n === 1 ? ui.t('wijnroutes.hub.lijst.een') : ui.t('wijnroutes.hub.lijst.meer').replace('{n}', String(n)));
const rzI18n = {
  titel: ui.t('wijnroutes.hub.lijst.titel'),
  titelLand: ui.t('wijnroutes.hub.lijst.titelLand'),
  een: ui.t('wijnroutes.hub.lijst.een'),
  meer: ui.t('wijnroutes.hub.lijst.meer'),
  verwijder: ui.t('wijnhuizen.filter.chip.verwijder'),
};

// Band "Slapen waar wij sliepen": alleen accommodaties mét booking_url (CJ-wrapper in
// AccommodatieKaart); zonder data blijft de band verborgen.
const slaap = [
  ...new Map(
    sorted.flatMap((e) => e.accommodaties).filter((a) => a.bookingUrl).map((a) => [a.slug, a] as const),
  ).values(),
].slice(0, 3);

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: ui.t('streek.breadcrumb.home'), url: localizePath('/', locale) },
    { name: ui.t('route.breadcrumb.index'), url: localizePath('/wijnroutes/', locale) },
  ]),
];
---

<SiteLayout
  title={ui.t('wijnroutes.hub.meta.title')}
  description={ui.t('wijnroutes.hub.meta.description')}
  schema={schema}
  activeNav="wijnroutes"
  locale={locale}
  alternates={alternates}
  noindex={routes.length === 0}
>
  <header class="rz-hero">
    <div class="container rz-hero__in">
      <span class="rz-kick">{ui.t('wijnroutes.hub.hero.label')}</span>
      <h1>{ui.t('wijnroutes.hub.hero.h1')}</h1>
      <p>{ui.t('wijnroutes.hub.hero.desc')}</p>
    </div>
  </header>

  {routes.length > 0 && (
    <section class="rz-sec rz-sec--routes container" id="wijnroutes" data-rz-root data-i18n={JSON.stringify(rzI18n)}>
      <form class="rz-filters" role="search" aria-label={ui.t('reizen.chip.aria')} data-rz-form hidden>
        <div class="rz-field rz-field--q">
          <label for="rz-q" class="rz-sr">{ui.t('wijnroutes.hub.filter.zoek')}</label>
          <input id="rz-q" name="q" type="search" autocomplete="off" enterkeyhint="search" placeholder={ui.t('wijnroutes.hub.filter.zoek')} />
        </div>
        <div class="rz-field">
          <label for="rz-land" class="rz-sr">{ui.t('reizen.chip.land')}</label>
          <select id="rz-land" name="land">
            <option value="">{ui.t('wijnroutes.hub.filter.landAlle')}</option>
            {landen.map((l) => <option value={l}>{l}</option>)}
          </select>
        </div>
        <div class="rz-field">
          <label for="rz-duur" class="rz-sr">{ui.t('reizen.chip.dagen')}</label>
          <select id="rz-duur" name="duur">
            <option value="">{ui.t('wijnroutes.hub.filter.duurAlle')}</option>
            {buckets.map((b) => <option value={b}>{bucketLabel(b)}</option>)}
          </select>
        </div>
        <div class="rz-status">
          <ul class="rz-chiplist" data-rz-chips aria-label={ui.t('reizen.chip.aria')}></ul>
          <button type="button" class="rz-wis" data-rz-wis hidden>{ui.t('wijnroutes.hub.filter.wis')}</button>
        </div>
      </form>

      <div class="rz-lh">
        <div>
          <h2 data-rz-titel>{ui.t('wijnroutes.hub.lijst.titel')}</h2>
          <p class="rz-count" data-rz-count aria-live="polite" aria-atomic="true">{telling(lijst.length)}</p>
        </div>
        <div class="rz-view" role="group" aria-label={ui.t('wijnroutes.hub.weergave.aria')} data-rz-view hidden>
          <button type="button" data-view="lijst" aria-pressed="true"><span aria-hidden="true">&#9776;</span> {ui.t('wijnroutes.hub.weergave.lijst')}</button>
          <button type="button" data-view="kaart" aria-pressed="false"><span aria-hidden="true">&#9673;</span> {ui.t('wijnroutes.hub.weergave.kaart')}</button>
        </div>
      </div>

      <div class="rz-body" data-rz-body>
        <div class="rz-list" data-rz-list>
          {lijst.map(({ route, dagen, bucket, wijnhuizen, land }, i) => {
            const kort = kortVoor(route);
            const meta = [
              land,
              dagen ? `${dagen} ${dagen === 1 ? ui.t('reizen.meta.dag') : ui.t('reizen.meta.dagen')}` : '',
              wijnhuizen ? `${wijnhuizen} ${ui.t('reizen.meta.wijnhuizen')}` : '',
            ].filter(Boolean);
            const zoek = fold([kort, route.title, land, route.streekSlug ? streekNaam.get(route.streekSlug) ?? '' : '', route.description ?? ''].join(' '));
            return (
              <a href={localizePath(`/wijnroutes/${route.slug}/`, locale)} class="rz-card" data-rz-card data-slug={route.slug} data-land={land} data-dagen={bucket ?? ''} data-zoek={zoek} title={route.title !== kort ? route.title : undefined}>
                <div class="rz-ph">
                  <SmartImg src={route.heroImage || undefined} alt={route.title} theme="region" width={560} loading={i < 4 ? 'eager' : 'lazy'} fetchpriority={i < 2 ? 'high' : undefined} />
                  <span class:list={['rz-badge', !route.zelfGereisd && 'rz-badge--soft']}>
                    {route.zelfGereisd ? ui.t('reizen.label.zelfGereisd') : ui.t('reizen.label.redactiegids')}
                  </span>
                </div>
                <div class="rz-cb">
                  <h3>{kort}</h3>
                  {meta.length > 0 && <div class="rz-meta">{meta.map((m) => <span>{m}</span>)}</div>}
                  {route.description && <p>{route.description}</p>}
                  <span class="rz-cta">{ui.t('reizen.index.routes.moreCta')} <span aria-hidden="true">&rarr;</span></span>
                </div>
              </a>
            );
          })}
          <div class="rz-empty" data-rz-empty hidden>
            <p>{ui.t('reizen.chip.empty')}</p>
            <button type="button" class="rz-wis" data-rz-wis-leeg>{ui.t('wijnroutes.hub.filter.wis')}</button>
          </div>
        </div>
        <aside class="rz-map" data-rz-map hidden>
          <HomeRoutesMap routes={routes} title={ui.t('wijnroutes.hub.kaart.titel')} locale={locale} legend={false} neutral />
        </aside>
      </div>

      {sorted.length > 0 && (
        <p class="rz-inspiratie">
          <span>{ui.t('wijnroutes.hub.inspiratie')}</span>
          <a class="rz-lnk" href="#nareizen">{ui.t('wijnroutes.hub.hero.ctaStories')} <span aria-hidden="true">&rarr;</span></a>
        </p>
      )}
    </section>
  )}

  {featured && (
    <section class="rz-sec container" id="nareizen">
      <div class="rz-sh">
        <div>
          <span class="rz-kick">{ui.t('reizen.index.nareizen.kicker')}</span>
          <h2>{ui.t('reizen.index.nareizen.title')}</h2>
        </div>
        <p>{ui.t('reizen.index.nareizen.intro')}</p>
      </div>
      {(() => {
        return (
          <div class="rz-feat">
            <a class="rz-feat__img" href={verhaalHref(featured)} tabindex="-1" aria-hidden="true">
              <SmartImg src={featured.heroImage || undefined} alt="" width={960} loading="eager" />
              {featured.streekName && <span class="rz-tag">{featured.streekName}</span>}
            </a>
            <div class="rz-feat__txt">
              <span class="rz-kick">{ui.t('reizen.index.nareizen.newest')}{featured.streekName ? ` · ${featured.streekName}` : ''}</span>
              <h3>{featured.titel}</h3>
              {(featured.tagline || featured.metaDescription) && <p>{featured.tagline || featured.metaDescription}</p>}
              <div class="rz-two">
                <a class="rz-btn" href={verhaalHref(featured)}>{ui.t('reizen.index.readStory')}</a>
                <a class="rz-lnk" href={routeHref(featured)}>{ui.t('reizen.index.driveRoute')}</a>
              </div>
            </div>
          </div>
        );
      })()}
      {restNareizen.length > 0 && (
        <div class="rz-sub">
          {restNareizen.map((entry) => {
            return (
              <article class="rz-n">
                <a class="rz-ph" href={verhaalHref(entry)} tabindex="-1" aria-hidden="true">
                  <SmartImg src={entry.heroImage || undefined} alt="" width={480} />
                  {entry.streekName && <span class="rz-tag">{entry.streekName}</span>}
                </a>
                <div class="rz-nb">
                  <span class="rz-kick">{ui.t('reizen.index.nareizen.kickerCard')}{entry.streekName ? ` · ${entry.streekName}` : ''}</span>
                  <h4><a href={verhaalHref(entry)}>{entry.titel}</a></h4>
                  {(entry.tagline || entry.metaDescription) && <p>{entry.tagline || entry.metaDescription}</p>}
                  <div class="rz-links">
                    <a class="rz-lnk" href={verhaalHref(entry)}>{ui.t('reizen.index.readStory')}</a>
                    <a class="rz-lnk rz-lnk--soft" href={routeHref(entry)}>{ui.t('reizen.index.driveRoute')}</a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </section>
  )}

  {slaap.length > 0 && (
    <section class="rz-sleep">
      <div class="container">
        <span class="rz-kick">{ui.t('reizen.index.sleep.kicker')}</span>
        <h2>{ui.t('reizen.index.sleep.title')}</h2>
        <p class="rz-sleep__intro">{ui.t('reizen.index.sleep.intro')}</p>
        <div class="rz-sleep__grid">
          {slaap.map((kaart) => <AccommodatieKaart kaart={kaart} context="wijnroutes-hub" locale={locale} />)}
        </div>
      </div>
    </section>
  )}

  {routes.length === 0 && (
    <section class="section container">
      <div class="rz-emptystate">
        <h2>{ui.t('wijnroutes.index.empty.title')}</h2>
        <p>
          {ui.t('wijnroutes.index.empty.descPre')}<a href={localizePath('/artikelen/', locale)}>{ui.t('wijnroutes.index.empty.descLink')}</a>{ui.t('wijnroutes.index.empty.descPost')}
        </p>
      </div>
    </section>
  )}

  <div class="rz-news"><NewsletterFooter locale={locale} /></div>
</SiteLayout>

<script>
  // LAT-13062 — keuzehulp direct boven de resultaten (ontwerpplaat 02/03): zoeken, land,
  // duur, telling, chips en wissen. Kaarten worden alleen verborgen (hidden), nooit uit de
  // DOM gehaald; zonder JS blijven alle routes zichtbaar en blijven filters verborgen.
  // De selectie staat in de querystring (replaceState): deelbaar, en "terug" vanaf een
  // route landt op dezelfde selectie. Lijst en kaart delen dezelfde selectie via het
  // `hrm:filter`-event dat HomeRoutesMap (neutral) beluistert.
  const root = document.querySelector<HTMLElement>('[data-rz-root]');
  const form = root?.querySelector<HTMLFormElement>('[data-rz-form]');
  if (root && form) {
    const t = JSON.parse(root.dataset.i18n || '{}');
    const q = form.querySelector<HTMLInputElement>('#rz-q')!;
    const land = form.querySelector<HTMLSelectElement>('#rz-land')!;
    const duur = form.querySelector<HTMLSelectElement>('#rz-duur')!;
    const chips = form.querySelector<HTMLElement>('[data-rz-chips]')!;
    const wis = form.querySelector<HTMLButtonElement>('[data-rz-wis]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-rz-card]')];
    const empty = root.querySelector<HTMLElement>('[data-rz-empty]');
    const titel = root.querySelector<HTMLElement>('[data-rz-titel]');
    const count = root.querySelector<HTMLElement>('[data-rz-count]');
    const view = root.querySelector<HTMLElement>('[data-rz-view]');
    const body = root.querySelector<HTMLElement>('[data-rz-body]');
    const mapEl = root.querySelector<HTMLElement>('[data-rz-map]');
    const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    const has = (sel: HTMLSelectElement, v: string) => [...sel.options].some((o) => o.value === v);

    form.hidden = false;
    form.addEventListener('submit', (e) => e.preventDefault());
    let filter: { visible: string[] | null; active?: string | null; refit?: boolean } = { visible: null };
    const send = (d: typeof filter) => {
      (window as any).__hrmFilter = d;
      document.dispatchEvent(new CustomEvent('hrm:filter', { detail: d }));
    };

    const chip = (label: string, clear: () => void) => {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'rz-chip';
      b.textContent = label;
      const x = document.createElement('span');
      x.setAttribute('aria-hidden', 'true');
      x.textContent = '×';
      b.append(x);
      b.setAttribute('aria-label', `${t.verwijder}: ${label}`);
      b.addEventListener('click', () => { clear(); apply(); q.focus(); });
      li.append(b);
      return li;
    };

    function apply() {
      const raw = q.value.trim();
      const toks = fold(raw).split(' ').filter(Boolean);
      const visible: string[] = [];
      for (const c of cards) {
        const ok = (!land.value || c.dataset.land === land.value)
          && (!duur.value || c.dataset.dagen === duur.value)
          && toks.every((tk) => (c.dataset.zoek || '').includes(tk));
        c.hidden = !ok;
        if (ok) visible.push(c.dataset.slug || '');
      }
      const n = visible.length;
      if (count) count.textContent = n === 1 ? t.een : String(t.meer).replace('{n}', String(n));
      if (titel) titel.textContent = land.value ? String(t.titelLand).replace('{land}', land.value) : t.titel;
      chips.replaceChildren(
        ...(land.value ? [chip(land.value, () => { land.value = ''; })] : []),
        ...(duur.value ? [chip(duur.selectedOptions[0]?.textContent || duur.value, () => { duur.value = ''; })] : []),
        ...(raw ? [chip(`“${raw}”`, () => { q.value = ''; })] : []),
      );
      const actief = Boolean(raw || land.value || duur.value);
      wis.hidden = !actief;
      if (empty) empty.hidden = n > 0;
      filter = { visible: actief ? visible : null, refit: true };
      send(filter);
      const p = new URLSearchParams(location.search);
      for (const [k, v] of [['q', raw], ['land', land.value], ['duur', duur.value]] as const) v ? p.set(k, v) : p.delete(k);
      const qs = p.toString();
      history.replaceState(history.state, '', `${location.pathname}${qs ? `?${qs}` : ''}${location.hash}`);
    }

    const reset = () => { q.value = ''; land.value = ''; duur.value = ''; apply(); q.focus(); };
    wis.addEventListener('click', reset);
    root.querySelector('[data-rz-wis-leeg]')?.addEventListener('click', reset);
    let timer = 0;
    q.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(apply, 120); });
    q.addEventListener('keydown', (e) => { if (e.key === 'Escape' && q.value) { q.value = ''; apply(); } });
    land.addEventListener('change', apply);
    duur.addEventListener('change', apply);

    // Actieve route (hover/focus) wordt bordeaux op de kaart; de rest blijft neutraal.
    for (const c of cards) {
      const on = () => send({ ...filter, active: c.dataset.slug, refit: false });
      const off = () => send({ ...filter, active: null, refit: false });
      c.addEventListener('mouseenter', on);
      c.addEventListener('focus', on);
      c.addEventListener('mouseleave', off);
      c.addEventListener('blur', off);
    }

    // Lijst/kaart: desktop toont de kaart ondergeschikt naast de lijst, mobiel alleen op verzoek.
    const setView = (kaart: boolean) => {
      if (!view || !mapEl || !body) return;
      mapEl.hidden = !kaart;
      body.classList.toggle('rz-body--kaart', kaart);
      view.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.view === 'kaart') === kaart)));
      if (kaart) requestAnimationFrame(() => document.dispatchEvent(new Event('hrm:resize')));
    };
    if (view && mapEl?.querySelector('[data-hrm]')) {
      view.hidden = false;
      view.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-view]');
        if (b) setView(b.dataset.view === 'kaart');
      });
      setView(window.matchMedia('(min-width: 1024px)').matches);
    }

    const p = new URLSearchParams(location.search);
    q.value = p.get('q') || '';
    const l = p.get('land') || '';
    if (l && has(land, l)) land.value = l;
    const d = p.get('duur') || '';
    if (d && has(duur, d)) duur.value = d;
    apply();
  }
</script>

<style>
  .rz-mono, .rz-kick, .rz-chips__lbl, .rz-badge, .rz-tag, .rz-cta {
    font-family: var(--font-mono);
    text-transform: uppercase;
  }
  .rz-kick { display: block; font-size: 0.6875rem; letter-spacing: 0.18em; color: var(--rust, #A14F2A); margin-bottom: var(--space-2); }
  .rz-hero {
    position: relative; min-height: clamp(420px, 62vh, 640px); display: flex; align-items: flex-end;
    color: #fff; background: var(--burgundyDark, #3D1115); overflow: hidden;
  }
  .rz-hero :global(.rz-hero__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 78%; }
