---
// WijnroutesHub — het ene overzicht van alle wijnroutes (NL /wijnroutes/, EN /en/wijnroutes/).
//
// Besluit 2026-10-05 (Marijn, analyse Claude): "Reizen" (/reizen-nareizen/) en
// "Wijnroutes" bestonden naast elkaar met grotendeels dezelfde inhoud. De bezoeker
// zoekt één ding: een plan met slaapadres en wijnhuizen. Daarom is er nog één hub,
// /wijnroutes/, met het ontwerp van de oude Reizen-hub (LAT-12451): de verhalen van
// Marijn bovenaan, filters op land en duur, en het label Zelf gereisd/Redactiegids.
// De verhalen (reispakketten) hebben geen eigen pagina meer; ze staan als blok
// "Zo reisden wij hem" op de routepagina van dezelfde streek (ReisVerhaal.astro).
// /reizen-nareizen/* gaat met een 301 naar de routes (nginx-prod.conf).
//
// LAT-13075 (goedgekeurd ontwerp 2026-10-10, paneel 02 Wijnroutes / 03 Mobiel): de hub
// opent met de keuzehulp (zoeken, land, reisduur) direct boven de resultaten; een kaart
// is ondergeschikt (zijpaneel op desktop, op verzoek op mobiel) en deelt de selectie met
// de lijst. De reisverhalen staan erna. Status in het URL-fragment; zonder JS blijft het
// een statische lijst met links.
import SiteLayout from '../layouts/SiteLayout.astro';
import SmartImg from '../components/SmartImg.astro';
import AccommodatieKaart from '../components/AccommodatieKaart.astro';
import NewsletterFooter from '../components/NewsletterFooter.astro';
import { loadReispakketten, type ReisPakket } from '../lib/reispakketten';
import { loadRoutes } from '../lib/routes';
import { loadStreken } from '../lib/streken';
import { routeDagen, dagenBucket, routeLand, orderRoutes } from '../lib/reizen-hub';
import { organizationSchema, breadcrumbSchema } from '../lib/seo';
import { loadUiStrings } from '../lib/ui-strings';
import { DEFAULT_LOCALE, localizePath, type Locale } from '../lib/i18n';
import { VERHAAL_ANCHOR, verhaalInRouteBody } from '../lib/reis-verhaal';
import { foldText } from '../lib/wijnhuis-filter';
import { kaartTitel, kaartLijn } from '../lib/wijnroutes-keuze';

interface Props {
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale = DEFAULT_LOCALE, alternates } = Astro.props;
const ui = await loadUiStrings(locale);

const routes = await loadRoutes(locale);
const streken = await loadStreken(locale);
const landByStreek = new Map(streken.filter((s) => s.country).map((s) => [s.slug, s.country]));

// Koppeling verhaal <-> route via de gedeelde streek (geen nieuw Directus-veld nodig).
function routeFor(entry: ReisPakket) {
  return entry.streekSlug ? routes.find((r) => r.streekSlug === entry.streekSlug) : undefined;
}
// Een verhaal zonder route in dezelfde streek heeft geen landingsplek meer en valt af.
const entries = (await loadReispakketten(locale)).filter((e) => routeFor(e));
const verhaalHref = (entry: ReisPakket) => {
  const slug = routeFor(entry)!.slug;
  return localizePath(`/wijnroutes/${slug}/${verhaalInRouteBody(slug) ? '' : `#${VERHAAL_ANCHOR}`}`, locale);
};
const routeHref = (entry: ReisPakket) => localizePath(`/wijnroutes/${routeFor(entry)!.slug}/`, locale);

function timestamp(entry: ReisPakket): number {
  const t = entry.pubDate ? Date.parse(entry.pubDate) : NaN;
  return Number.isNaN(t) ? -Infinity : t;
}
const sorted = [...entries].sort((a, b) => timestamp(b) - timestamp(a) || a.titel.localeCompare(b.titel));
// Feature volgens het goedgekeurde ontwerp (LAT-12451): de Mosel-reis (Marijn zelf in beeld); anders de nieuwste.
const featured = sorted.find((e) => e.streekSlug.startsWith('mosel')) ?? sorted[0];
const restNareizen = sorted.filter((e) => e !== featured);

// Hero: het Langhe-beeld (eigen foto), anders het nieuwste verhaal met beeld, anders een route-hero.
const heroEntry =
  sorted.find((e) => e.streekSlug.startsWith('langhe') && e.heroImage) ?? sorted.find((e) => e.heroImage);
const heroImage = heroEntry?.heroImage ?? routes.find((r) => r.zelfGereisd && r.heroImage)?.heroImage ?? null;

const streekNaam = new Map(streken.map((s) => [s.slug, s.name]));
const landSlug = (l: string) => foldText(l).replace(/\s+/g, '-');
// Streeknaam als korte titel alleen als die naam uniek is; anders zouden twee kaarten
// "Toscane" heten en valt de kaart terug op de volledige CMS-titel.
const naamTelling = new Map<string, number>();
for (const r of routes) {
  const n = r.streekSlug ? streekNaam.get(r.streekSlug) || '' : '';
  if (n) naamTelling.set(n, (naamTelling.get(n) ?? 0) + 1);
}
const enriched = orderRoutes(routes).map((route) => {
  const dagen = routeDagen(route);
  const land = routeLand(route, landByStreek);
  const streek = route.streekSlug ? streekNaam.get(route.streekSlug) || '' : '';
  const titel = kaartTitel(route, naamTelling.get(streek) === 1 ? streek : '');
  return {
    route,
    dagen,
    bucket: dagenBucket(dagen),
    land,
    landKey: land ? landSlug(land) : '',
    titel,
    line: kaartLijn(route.stopsGeo),
    zoek: foldText([titel, route.title, streek, land, route.slug, ...route.stops, ...route.stopsGeo.map((g) => g.naam)].join(' ')),
  };
});
const landen = [...new Map(enriched.filter((r) => r.land).map((r) => [r.landKey, r.land])).entries()]
  .sort((a, b) => a[1].localeCompare(b[1], locale));
const buckets = (['1-2', '3-4', '5+'] as const).filter((b) => enriched.some((r) => r.bucket === b));
const bucketLabel = (b: string) => ui.t(`reizen.chip.dagen.${b}`);
const opKaart = enriched.filter((r) => r.line.length >= 2);
const kaartData = {
  routes: opKaart.map((r) => ({
    slug: r.route.slug,
    href: localizePath(`/wijnroutes/${r.route.slug}/`, locale),
    titel: r.titel,
    meta: [r.land, r.dagen ? `${r.dagen} ${r.dagen === 1 ? ui.t('wijnroutes.keuze.dag') : ui.t('wijnroutes.keuze.dagen')}` : ''].filter(Boolean).join(' · '),
    line: r.line,
  })),
  cta: ui.t('wijnroutes.keuze.cta'),
};
const i18n = {
  een: ui.t('wijnroutes.keuze.telling.een'),
  meer: ui.t('wijnroutes.keuze.telling.meer'),
  van: ui.t('wijnroutes.keuze.telling.van'),
  verwijder: ui.t('wijnroutes.keuze.verwijder'),
  alle: ui.t('wijnroutes.keuze.results.alle'),
  in: ui.t('wijnroutes.keuze.results.in'),
  duur: ui.t('wijnroutes.keuze.results.duur'),
  zoek: ui.t('wijnroutes.keuze.results.zoek'),
  filters: ui.t('wijnroutes.keuze.filters'),
};

// Band "Slapen waar wij sliepen": alleen accommodaties mét booking_url (CJ-wrapper in
// AccommodatieKaart); zonder data blijft de band verborgen.
const slaap = [
  ...new Map(
    sorted.flatMap((e) => e.accommodaties).filter((a) => a.bookingUrl).map((a) => [a.slug, a] as const),
  ).values(),
].slice(0, 3);

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: ui.t('streek.breadcrumb.home'), url: localizePath('/', locale) },
    { name: ui.t('route.breadcrumb.index'), url: localizePath('/wijnroutes/', locale) },
  ]),
];
---

<SiteLayout
  title={ui.t('wijnroutes.hub.meta.title')}
  description={ui.t('wijnroutes.hub.meta.description')}
  schema={schema}
  activeNav="wijnroutes"
  locale={locale}
  alternates={alternates}
  noindex={routes.length === 0}
>
  <header class="wk-head container">
    <h1>{ui.t('wijnroutes.keuze.h1')}</h1>
    <p>{ui.t('wijnroutes.keuze.sub')}</p>
  </header>

  {routes.length > 0 && (
    <section class="wk container" id="wijnroutes" data-wk-root data-i18n={JSON.stringify(i18n)} data-totaal={enriched.length}>
      <form class="wk-form" role="search" aria-label={ui.t('wijnroutes.keuze.label')} hidden data-wk-form>
        <div class="wk-fields">
          <div class="wk-field wk-field--zoek">
            <label for="wk-zoek" class="sr-only">{ui.t('wijnroutes.keuze.zoek.label')}</label>
            <svg class="wk-ico" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M13 13l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <input id="wk-zoek" name="q" type="search" autocomplete="off" enterkeyhint="search" placeholder={ui.t('wijnroutes.keuze.zoek.placeholder')} />
          </div>
          <div class="wk-sels" id="wk-sels" data-wk-sels>
            <div class="wk-field">
              <label for="wk-land" class="sr-only">{ui.t('wijnroutes.keuze.land.label')}</label>
              <select id="wk-land" name="land">
                <option value="">{ui.t('wijnroutes.keuze.land.label')}</option>
                {landen.map(([key, naam]) => <option value={key}>{naam}</option>)}
              </select>
            </div>
            <div class="wk-field">
              <label for="wk-duur" class="sr-only">{ui.t('wijnroutes.keuze.duur.label')}</label>
              <select id="wk-duur" name="duur">
                <option value="">{ui.t('wijnroutes.keuze.duur.label')}</option>
                {buckets.map((bk) => <option value={bk}>{bucketLabel(bk)}</option>)}
              </select>
            </div>
          </div>
        </div>
        <div class="wk-status">
          <ul class="wk-chips" data-wk-chips aria-label={ui.t('wijnroutes.keuze.actief')}></ul>
          <button type="button" class="wk-wis" data-wk-wis hidden>{ui.t('wijnroutes.keuze.wis')}</button>
          <button type="button" class="wk-filters" data-wk-filters aria-controls="wk-sels" aria-expanded="true">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M6 10h8M8.5 14h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <span data-wk-filters-label>{ui.t('wijnroutes.keuze.filters')}</span>
          </button>
        </div>
      </form>

      <div class="wk-rh">
        <h2 data-wk-titel>{ui.t('wijnroutes.keuze.results.alle')}</h2>
        <p class="wk-telling" data-wk-telling aria-live="polite" aria-atomic="true">{enriched.length === 1 ? ui.t('wijnroutes.keuze.telling.een') : ui.t('wijnroutes.keuze.telling.meer').replace('{n}', String(enriched.length))}</p>
        {opKaart.length > 0 && (
          <div class="wk-view" role="group" aria-label={ui.t('wijnroutes.keuze.weergave')} hidden data-wk-view>
            <button type="button" class="wk-vbtn" data-wk-mode="lijst" aria-pressed="true">
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 6h12M4 10h12M4 14h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              {ui.t('wijnroutes.keuze.lijst')}
            </button>
            <button type="button" class="wk-vbtn" data-wk-mode="kaart" aria-pressed="false">
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M2.5 5l5-2 5 2 5-2v12l-5 2-5-2-5 2z M7.5 3v12 M12.5 5v12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
              <span class="wk-vbtn__d">{ui.t('wijnroutes.keuze.kaart')}</span><span class="wk-vbtn__m">{ui.t('wijnroutes.keuze.bekijkKaart')}</span>
            </button>
          </div>
        )}
      </div>

      <div class="wk-body" data-wk-body data-mode="lijst">
        <ul class="wk-list" data-wk-list>
          {enriched.map(({ route, dagen, bucket, land, landKey, titel, zoek }, i) => {
            const eager = i < 2;
            const meta = [land, dagen ? `${dagen} ${dagen === 1 ? ui.t('wijnroutes.keuze.dag') : ui.t('wijnroutes.keuze.dagen')}` : ''].filter(Boolean);
            const href = localizePath(`/wijnroutes/${route.slug}/`, locale);
            return (
              <li class="wk-card" data-wk-card data-slug={route.slug} data-land={landKey} data-duur={bucket ?? ''} data-zoek={zoek}>
                <div class="wk-ph">
                  <SmartImg src={route.heroImage || undefined} alt="" theme="region" width={480} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
                  <span class:list={['wk-badge', !route.zelfGereisd && 'wk-badge--soft']}>
                    {route.zelfGereisd ? ui.t('reizen.label.zelfGereisd') : ui.t('reizen.label.redactiegids')}
                  </span>
                </div>
                <div class="wk-cb">
                  <h3>{titel}</h3>
                  {meta.length > 0 && <p class="wk-meta">{meta.map((m) => <span>{m}</span>)}</p>}
                  {route.description && <p class="wk-teaser">{route.description}</p>}
                  <a class="wk-btn" href={href} aria-label={`${ui.t('wijnroutes.keuze.cta')}: ${titel}`}>{ui.t('wijnroutes.keuze.cta')} <span aria-hidden="true">&rarr;</span></a>
                </div>
              </li>
            );
          })}
        </ul>
        {opKaart.length > 0 && (
          <aside class="wk-map" aria-labelledby="wk-map-t" hidden data-wk-map>
            <p class="wk-map__t" id="wk-map-t">{ui.t('wijnroutes.keuze.kaart.titel')}</p>
            <div class="wk-map__c" data-wk-canvas role="region" aria-label={ui.t('wijnroutes.keuze.kaart.titel')}></div>
            {opKaart.length < enriched.length && <p class="wk-map__n">{ui.t('wijnroutes.keuze.kaart.nietOpKaart')}</p>}
            <script type="application/json" data-wk-data set:html={JSON.stringify(kaartData)} />
          </aside>
        )}
      </div>

      <div class="wk-leeg" data-wk-leeg hidden>
        <h3>{ui.t('wijnroutes.keuze.leeg.titel')}</h3>
        <p>{ui.t('wijnroutes.keuze.leeg.tekst')}</p>
        <button type="button" class="wk-wis" data-wk-wis-leeg>{ui.t('wijnroutes.keuze.wis')}</button>
      </div>

      {sorted.length > 0 && (
        <div class="wk-insp">
          <p class="wk-insp__t">{ui.t('wijnroutes.keuze.inspiratie.titel')}</p>
          <a class="wk-insp__l" href="#nareizen">{ui.t('wijnroutes.keuze.inspiratie.link')} <span aria-hidden="true">&rarr;</span></a>
        </div>
      )}
    </section>
  )}

  {featured && (
    <section class="rz-sec container" id="nareizen">
      <div class="rz-sh">
        <div>
          <span class="rz-kick">{ui.t('reizen.index.nareizen.kicker')}</span>
          <h2>{ui.t('reizen.index.nareizen.title')}</h2>
        </div>
        <p>{ui.t('reizen.index.nareizen.intro')}</p>
      </div>
      {(() => {
        return (
          <div class="rz-feat">
            <a class="rz-feat__img" href={verhaalHref(featured)} tabindex="-1" aria-hidden="true">
              <SmartImg src={featured.heroImage || undefined} alt="" width={960} loading="eager" />
              {featured.streekName && <span class="rz-tag">{featured.streekName}</span>}
            </a>
            <div class="rz-feat__txt">
              <span class="rz-kick">{ui.t('reizen.index.nareizen.newest')}{featured.streekName ? ` · ${featured.streekName}` : ''}</span>
              <h3>{featured.titel}</h3>
              {(featured.tagline || featured.metaDescription) && <p>{featured.tagline || featured.metaDescription}</p>}
              <div class="rz-two">
                <a class="rz-btn" href={verhaalHref(featured)}>{ui.t('reizen.index.readStory')}</a>
                <a class="rz-lnk" href={routeHref(featured)}>{ui.t('reizen.index.driveRoute')}</a>
              </div>
            </div>
          </div>
        );
      })()}
      {restNareizen.length > 0 && (
        <div class="rz-sub">
          {restNareizen.map((entry) => {
            return (
              <article class="rz-n">
                <a class="rz-ph" href={verhaalHref(entry)} tabindex="-1" aria-hidden="true">
                  <SmartImg src={entry.heroImage || undefined} alt="" width={480} />
                  {entry.streekName && <span class="rz-tag">{entry.streekName}</span>}
                </a>
                <div class="rz-nb">
                  <span class="rz-kick">{ui.t('reizen.index.nareizen.kickerCard')}{entry.streekName ? ` · ${entry.streekName}` : ''}</span>
                  <h4><a href={verhaalHref(entry)}>{entry.titel}</a></h4>
                  {(entry.tagline || entry.metaDescription) && <p>{entry.tagline || entry.metaDescription}</p>}
                  <div class="rz-links">
                    <a class="rz-lnk" href={verhaalHref(entry)}>{ui.t('reizen.index.readStory')}</a>
                    <a class="rz-lnk rz-lnk--soft" href={routeHref(entry)}>{ui.t('reizen.index.driveRoute')}</a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </section>
  )}

  {slaap.length > 0 && (
    <section class="rz-sleep">
      <div class="container">
        <span class="rz-kick">{ui.t('reizen.index.sleep.kicker')}</span>
        <h2>{ui.t('reizen.index.sleep.title')}</h2>
        <p class="rz-sleep__intro">{ui.t('reizen.index.sleep.intro')}</p>
        <div class="rz-sleep__grid">
          {slaap.map((kaart) => <AccommodatieKaart kaart={kaart} context="wijnroutes-hub" locale={locale} />)}
        </div>
      </div>
    </section>
  )}

  {routes.length === 0 && (
    <section class="section container">
      <div class="rz-emptystate">
        <h2>{ui.t('wijnroutes.index.empty.title')}</h2>
        <p>
          {ui.t('wijnroutes.index.empty.descPre')}<a href={localizePath('/artikelen/', locale)}>{ui.t('wijnroutes.index.empty.descLink')}</a>{ui.t('wijnroutes.index.empty.descPost')}
        </p>
      </div>
    </section>
  )}

  <div class="rz-news"><NewsletterFooter locale={locale} /></div>
</SiteLayout>

<script>
  // LAT-13075 — keuzehulp. Filtert de statisch gerenderde kaarten; status in het
  // URL-fragment (#q=…&land=…&duur=…) via replaceState: deelbaar, niet indexeerbaar,
  // en "terug" landt met selectie en scroll intact. Lijst en kaart delen de selectie.
  import { foldText } from '../lib/wijnhuis-filter';
  import { parseKeuzeHash, serializeKeuze, matchesKeuze } from '../lib/wijnroutes-keuze';
  import { trackEvent } from '../lib/site-events';
  import { whenUserIntent } from '../lib/map-base';

  const root = document.querySelector<HTMLElement>('[data-wk-root]');
  if (root) {
    const t = JSON.parse(root.dataset.i18n || '{}') as Record<string, string>;
    const totaal = Number(root.dataset.totaal || 0);
    const form = root.querySelector<HTMLFormElement>('[data-wk-form]')!;
    const zoek = form.querySelector<HTMLInputElement>('#wk-zoek')!;
    const land = form.querySelector<HTMLSelectElement>('#wk-land')!;
    const duur = form.querySelector<HTMLSelectElement>('#wk-duur')!;
    const chips = form.querySelector<HTMLElement>('[data-wk-chips]')!;
    const wis = form.querySelector<HTMLButtonElement>('[data-wk-wis]')!;
    const filtersBtn = form.querySelector<HTMLButtonElement>('[data-wk-filters]')!;
    const filtersLbl = form.querySelector<HTMLElement>('[data-wk-filters-label]')!;
    const sels = form.querySelector<HTMLElement>('[data-wk-sels]')!;
    const titel = root.querySelector<HTMLElement>('[data-wk-titel]')!;
    const telling = root.querySelector<HTMLElement>('[data-wk-telling]')!;
    const leeg = root.querySelector<HTMLElement>('[data-wk-leeg]')!;
    const body = root.querySelector<HTMLElement>('[data-wk-body]')!;
    const view = root.querySelector<HTMLElement>('[data-wk-view]');
    const mapEl = root.querySelector<HTMLElement>('[data-wk-map]');
    const cards = [...root.querySelectorAll<HTMLElement>('[data-wk-card]')];
    const scrollKey = `wk-scroll:${location.pathname}`;
    const desktop = window.matchMedia('(min-width: 1024px)');
    const hasOption = (sel: HTMLSelectElement, v: string) => [...sel.options].some((o) => o.value === v);
    const optLabel = (sel: HTMLSelectElement) => (sel.value ? sel.selectedOptions[0]?.textContent?.trim() || '' : '');

    form.hidden = false;
    if (view) view.hidden = false;

    // ---- kaart (lazy; alleen bestaande stopsGeo, zie wijnroutes-keuze.ts) ----
    let kaart: { setVisible(slugs: Set<string>): void; select(slug: string | null): void; resize(): void } | null = null;
    let kaartLaden: Promise<void> | null = null;
    let zichtbaar = new Set(cards.map((c) => c.dataset.slug || ''));
    let gekozen: string | null = null;
    const ensureKaart = () => {
      if (!mapEl || kaartLaden) return kaartLaden;
      kaartLaden = import('../lib/wijnroutes-keuze-kaart').then(async (m) => {
        kaart = await m.mountKeuzeKaart(mapEl, (slug) => selectRoute(slug, true));
        kaart.setVisible(zichtbaar);
        kaart.select(gekozen);
      });
      return kaartLaden;
    };
    function selectRoute(slug: string | null, fromMap = false) {
      gekozen = slug;
      for (const c of cards) c.classList.toggle('is-sel', !!slug && c.dataset.slug === slug);
      kaart?.select(slug);
      if (fromMap && slug && body.dataset.mode === 'lijst') {
        cards.find((c) => c.dataset.slug === slug)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }
    const syncMap = () => {
      if (!mapEl) return;
      const mode = body.dataset.mode;
      // Desktop: kaart als ondergeschikt zijpaneel naast de lijst; mobiel alleen op verzoek.
      const show = mode === 'kaart' || desktop.matches;
      mapEl.hidden = !show;
      if (!show) return;
      // Zijpaneel pas na de eerste gebruikersactie laden (TBT, LAT-12592); op verzoek meteen.
      const go = () => ensureKaart()?.then(() => kaart?.resize());
      if (mode === 'kaart') go(); else whenUserIntent().then(go);
    };
    const setMode = (mode: 'lijst' | 'kaart') => {
      body.dataset.mode = mode;
      view?.querySelectorAll<HTMLButtonElement>('[data-wk-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.wkMode === mode)));
      syncMap();
    };
    view?.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-wk-mode]');
      if (!b) return;
      setMode(b.dataset.wkMode === 'kaart' ? 'kaart' : 'lijst');
      if (b.dataset.wkMode === 'kaart') trackEvent('cta_click', { cta_id: 'wijnroutes_kaart' });
    });

    const chip = (label: string, onRemove: () => void) => {
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = label;
      const x = document.createElement('span');
      x.className = 'wk-chip-x';
      x.setAttribute('aria-hidden', 'true');
      x.textContent = '×';
      btn.append(x);
      btn.setAttribute('aria-label', `${t.verwijder}: ${label}`);
      btn.addEventListener('click', () => { onRemove(); apply(); zoek.focus(); });
      li.append(btn);
      return li;
    };

    function apply() {
      const raw = zoek.value.trim();
      const q = foldText(raw).split(' ').filter(Boolean);
      const s = { land: land.value, duur: duur.value };
      let n = 0;
      zichtbaar = new Set();
      for (const c of cards) {
        const ok = matchesKeuze({ zoek: c.dataset.zoek || '', land: c.dataset.land || '', duur: c.dataset.duur || '' }, q, s);
        c.hidden = !ok;
        if (ok) { n++; zichtbaar.add(c.dataset.slug || ''); }
      }
      if (gekozen && !zichtbaar.has(gekozen)) selectRoute(null);
      kaart?.setVisible(zichtbaar);
      const actief = (raw ? 1 : 0) + (s.land ? 1 : 0) + (s.duur ? 1 : 0);
      telling.textContent = actief === 0
        ? (totaal === 1 ? t.een : t.meer.replace('{n}', String(totaal)))
        : t.van.replace('{n}', String(n)).replace('{totaal}', String(totaal));
      const lLabel = optLabel(land), dLabel = optLabel(duur);
      titel.textContent = lLabel
        ? t.in.replace('{sel}', dLabel ? `${lLabel}, ${dLabel}` : lLabel)
        : dLabel ? t.duur.replace('{duur}', dLabel)
        : raw ? t.zoek.replace('{q}', `“${raw}”`) : t.alle;
      chips.replaceChildren(
        ...(raw ? [chip(`“${raw}”`, () => { zoek.value = ''; })] : []),
        ...(lLabel ? [chip(lLabel, () => { land.value = ''; })] : []),
        ...(dLabel ? [chip(dLabel, () => { duur.value = ''; })] : []),
      );
      wis.hidden = actief === 0;
      const selN = (s.land ? 1 : 0) + (s.duur ? 1 : 0);
      filtersLbl.textContent = selN ? `${t.filters} (${selN})` : t.filters;
      leeg.hidden = n > 0;
      const hash = serializeKeuze({ q: raw, ...s });
      if (hash !== location.hash.slice(1)) {
        history.replaceState(history.state, '', hash ? `#${hash}` : location.pathname + location.search);
      }
    }

    const readHash = () => {
      // #nareizen e.d. zijn ankers, geen filterstatus.
      if (location.hash && !/[=]/.test(location.hash)) return;
      const p = parseKeuzeHash(location.hash);
      zoek.value = p.q;
      land.value = hasOption(land, p.land) ? p.land : '';
      duur.value = hasOption(duur, p.duur) ? p.duur : '';
    };

    // Mobiel: Land/Reisduur standaard open; "Filters (n)" klapt ze in en uit.
    filtersBtn.addEventListener('click', () => {
      const open = filtersBtn.getAttribute('aria-expanded') !== 'true';
      filtersBtn.setAttribute('aria-expanded', String(open));
      sels.classList.toggle('is-dicht', !open);
      if (open) land.focus();
    });

    readHash();
    apply();
    syncMap();
    desktop.addEventListener('change', syncMap);

    zoek.addEventListener('input', () => apply());
    land.addEventListener('change', () => { apply(); if (land.value) trackEvent('cta_click', { cta_id: `wijnroutes_land:${land.value}` }); });
    duur.addEventListener('change', () => { apply(); if (duur.value) trackEvent('cta_click', { cta_id: `wijnroutes_duur:${duur.value}` }); });
    form.addEventListener('submit', (ev) => { ev.preventDefault(); zoek.blur(); });
    const wisAlles = () => { zoek.value = ''; land.value = ''; duur.value = ''; apply(); zoek.focus(); };
    wis.addEventListener('click', wisAlles);
    leeg.querySelector('[data-wk-wis-leeg]')!.addEventListener('click', wisAlles);
    window.addEventListener('hashchange', () => { if (/[=]/.test(location.hash) || !location.hash) { readHash(); apply(); } });

    // Gedeelde selectie: hover/focus op een kaart licht de route op de kaart bordeaux op.
    for (const c of cards) {
      const sel = () => selectRoute(c.dataset.slug || null);
      c.addEventListener('mouseenter', sel);
      c.addEventListener('focusin', sel);
    }

    window.addEventListener('pagehide', () => sessionStorage.setItem(scrollKey, String(window.scrollY)));
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    const saved = Number(sessionStorage.getItem(scrollKey));
    if (nav?.type === 'back_forward' && saved > 0) requestAnimationFrame(() => window.scrollTo(0, saved));
  }
</script>

