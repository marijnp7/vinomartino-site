---
// LAT-2693 — gedeeld artikelen-overzicht (listing-index, incl. keuzehulp LAT-13773).
// NL-route + /en/-tegenhanger renderen dit component; `locale` stuurt de loader
// (no-translation-guard), de datum-locale en de UI-dictionary. De keuzehulp leest
// zijn zichtbare woorden uit data-i18n, zodat ook het EN-resultaat gelokaliseerd is.
import SiteLayout from '../layouts/SiteLayout.astro';
import SmartImg from '../components/SmartImg.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { loadArticles } from '../lib/articles';
import { isRedirectedArticleSlug } from '../lib/content-links';
import { getAuthorByByline } from '../lib/authors';
import { loadUiStrings } from '../lib/ui-strings';
import { rubriekLabel, rubriekSlug } from '../lib/rubriek-labels';
import { DEFAULT_LOCALE, localizePath, type Locale } from '../lib/i18n';
import { loadStrekenNav } from '../lib/streken';
import { foldText } from '../lib/wijnhuis-filter';
import '../styles/keuzehulp.css';

interface Props {
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale = DEFAULT_LOCALE, alternates } = Astro.props;
const ui = await loadUiStrings(locale);
const collation = locale === 'en' ? 'en' : 'nl';
const dateLocale = locale === 'en' ? 'en-GB' : 'nl-NL';

// LAT-1848: toon de gecanoniseerde auteursnaam uit het auteur-record (bv.
// "Marijn") i.p.v. het ruwe Directus author-veld (dat nog "Martin" kan zijn).
const authorName = (byline: string | null | undefined): string =>
  getAuthorByByline(byline)?.name ?? byline ?? 'VinoMartino';

const allArticles = await loadArticles(locale);
// LAT-13350: geen kaarten naar een slug die op productie 301't (nginx-prod.conf).
const publishedSlugs = new Set(allArticles.map((a) => a.slug));
const articles = allArticles.filter((a) => !isRedirectedArticleSlug(a.slug, locale, publishedSlugs));

// LAT-13773 — keuzehulp zoals /wijnhuizen/ (gedeelde primitieven uit LAT-13771:
// src/lib/keuzehulp-client.ts + src/styles/keuzehulp.css). Velden: zoeken, Bestemming
// (land → streken, OR binnen het veld) en Rubriek. Land komt uit de CMS-relaties
// related_landen + streek → land; niets afgeleid uit tekst.
// LAT-3306: de rubriek-slug blijft uit de rauwe NL-`category` komen, zodat oude
// ?rubriek=…-links taal-onafhankelijk blijven; alleen het label is vertaald.
const strekenNav = await loadStrekenNav(locale);
const landSlugByStreek = new Map(strekenNav.map((s) => [s.slug, s.landSlug]));
const collator = new Intl.Collator(collation);

const cards = articles.map((a) => {
  const rubriekNaam = a.category ? rubriekLabel(ui, a.category) : '';
  const streken = a.relatedStreken.filter((s) => s?.slug);
  const landSlugs = new Set(a.relatedLanden.map((l) => l.slug).filter(Boolean));
  for (const s of streken) { const l = landSlugByStreek.get(s.slug); if (l) landSlugs.add(l); }
  return {
    a,
    rubriek: a.category ? rubriekSlug(a.category) : '',
    rubriekNaam,
    streken,
    landSlugs: [...landSlugs],
    zoek: foldText([a.title, a.description, rubriekNaam, a.category, ...streken.map((s) => s.name), ...a.relatedLanden.map((l) => l.name)].filter(Boolean).join(' ')),
  };
});

// Bestemmingen: land → streken met aantallen. Streken zonder land in het CMS in een neutrale groep.
const landNaam = new Map<string, string>();
for (const a of articles) for (const l of a.relatedLanden) if (l.slug && l.name) landNaam.set(l.slug, l.name);
const landen = new Map<string, { naam: string; n: number; streken: Map<string, { naam: string; n: number }> }>();
const losseStreken = new Map<string, { naam: string; n: number }>();
for (const c of cards) {
  for (const ls of c.landSlugs) {
    const l = landen.get(ls) ?? { naam: landNaam.get(ls) || ls, n: 0, streken: new Map() };
    l.n++;
    landen.set(ls, l);
  }
  for (const s of c.streken) {
    const ls = landSlugByStreek.get(s.slug);
    const doel = ls && landen.get(ls) ? landen.get(ls)!.streken : losseStreken;
    const st = doel.get(s.slug) ?? { naam: s.name || s.slug, n: 0 };
    st.n++;
    doel.set(s.slug, st);
  }
}
const landOpties = [...landen.entries()].sort((a, b) => collator.compare(a[1].naam, b[1].naam));
const rubriekTelling = new Map<string, { label: string; n: number }>();
for (const c of cards) {
  if (!c.rubriek) continue;
  const r = rubriekTelling.get(c.rubriek) ?? { label: c.rubriekNaam, n: 0 };
  r.n++;
  rubriekTelling.set(c.rubriek, r);
}
const rubriekOpties = [...rubriekTelling.entries()].sort((a, b) => collator.compare(a[1].label, b[1].label));
const khI18n = {
  een: ui.t('artikelen.filter.telling.een'),
  alle: ui.t('artikelen.filter.telling.alle'),
  van: ui.t('artikelen.filter.telling.van'),
  verwijder: ui.t('wijnhuizen.filter.chip.verwijder'),
};
const tellingStart = cards.length === 1 ? khI18n.een : khI18n.alle.replace('{n}', String(cards.length));
const landAlle = (naam: string) => ui.t('wijnhuizen.filter.land.alle').replace('{land}', naam);
---

<SiteLayout
  title={ui.t('artikelen.index.meta.title')}
  description={ui.t('artikelen.index.meta.description')}
  activeNav="artikelen"
  locale={locale}
  alternates={alternates}
>
  <section class="hero-sm">
    <div class="container">
      <span class="section-label">{ui.t('artikelen.index.hero.label')}</span>
      <h1 set:html={ui.t('artikelen.index.hero.h1')} />
      <p class="hero-desc">{ui.t('artikelen.index.hero.desc')}</p>
    </div>
  </section>

  <section class="section container">
    {articles.length > 0 ? (
      <div class="articles-layout" data-kh-root data-i18n={JSON.stringify(khI18n)} data-totaal={cards.length} data-track="artikelen">
        {/* Zelfde CLS-aanpak als /wijnhuizen/ (LAT-12594): server-side zichtbaar, zonder JS verborgen; de volledige lijst blijft staan. */}
        <noscript><style is:inline>.wh-filters { display: none !important; }</style></noscript>
        <form class="wh-filters" role="search" aria-label={ui.t('artikelen.filter.label')} data-kh-form>
          <div class="wh-field">
            <label for="art-zoek">{ui.t('artikelen.filter.zoek.label')}</label>
            <input id="art-zoek" name="q" type="search" autocomplete="off" enterkeyhint="search" placeholder={ui.t('artikelen.filter.zoek.placeholder')} data-kh-zoek />
          </div>
          <div class="wh-field">
            <label for="art-bestemming">{ui.t('wijnhuizen.filter.bestemming.label')}</label>
            <select id="art-bestemming" name="bestemming" data-kh-select data-kh-lijst>
              <option value="">{ui.t('wijnhuizen.filter.bestemming.alle')}</option>
              {landOpties.map(([slug, l]) => (
                <optgroup label={l.naam}>
                  <option value={`land:${slug}`} data-label={l.naam} data-base={landAlle(l.naam)}>{landAlle(l.naam)} ({l.n})</option>
                  {[...l.streken.entries()].sort((a, b) => collator.compare(a[1].naam, b[1].naam)).map(([ss, st]) => (
                    <option value={`streek:${ss}`} data-label={st.naam}>{st.naam} ({st.n})</option>
                  ))}
                </optgroup>
              ))}
              {losseStreken.size > 0 && (
                <optgroup label={ui.t('wijnhuizen.filter.overigeStreken')}>
                  {[...losseStreken.entries()].sort((a, b) => collator.compare(a[1].naam, b[1].naam)).map(([ss, st]) => (
                    <option value={`streek:${ss}`} data-label={st.naam}>{st.naam} ({st.n})</option>
                  ))}
                </optgroup>
              )}
            </select>
          </div>
          <details class="wh-meer">
            <summary>{ui.t('wijnhuizen.filter.meer')} <span class="wh-meer-n" data-kh-meer-n hidden></span></summary>
            <div class="wh-field">
              <label for="art-rubriek">{ui.t('artikelen.index.filter.rubriek')}</label>
              <select id="art-rubriek" name="rubriek" data-kh-select>
                <option value="">{ui.t('artikelen.filter.rubriek.alle')}</option>
                {rubriekOpties.map(([slug, r]) => (
                  <option value={slug} data-label={r.label}>{r.label} ({r.n})</option>
                ))}
              </select>
            </div>
          </details>
          <div class="wh-status">
            <p class="wh-telling" data-kh-telling aria-live="polite" aria-atomic="true">{tellingStart}</p>
            <ul class="wh-chips" data-kh-chips aria-label={ui.t('wijnhuizen.filter.actief')}></ul>
            <button type="button" class="wh-wis" data-kh-wis hidden>{ui.t('wijnhuizen.filter.wis')}</button>
          </div>
        </form>

        <div class="wh-leeg" data-kh-leeg hidden>
          <h2>{ui.t('artikelen.index.filterEmpty.title')}</h2>
          <p>{ui.t('wijnhuizen.filter.leeg.tekst')}</p>
          <div class="wh-leeg-acties">
            <button type="button" data-wh-wis-leeg>{ui.t('wijnhuizen.filter.wis')}</button>
          </div>
        </div>

        <div class="article-grid">
          {cards.map(({ a: article, rubriek, rubriekNaam, streken, landSlugs, zoek }) => (
            <ArticleCard
              href={localizePath(`/artikelen/${article.slug}/`, locale)}
              title={article.title}
              kicker={rubriekNaam || null}
              zelfGereisd={article.zelfGereisd}
              bezoekjaar={article.bezoekjaar}
              headingLevel="h2"
              locale={locale}
              attrs={{ 'data-kh-card': '', 'data-zoek': zoek, 'data-rubriek': rubriek, 'data-land': landSlugs.join(' '), 'data-streek': streken.map((s) => s.slug).join(' ') }}
            >
              <SmartImg slot="media" src={article.heroImage || undefined} alt={article.title} theme="vineyard" class="article-img" fileId={article.heroImageId} />
            </ArticleCard>
          ))}
        </div>
      </div>
    ) : (
      <div class="empty-state">
        <h2>{ui.t('artikelen.index.empty.title')}</h2>
        <p>{ui.t('artikelen.index.empty.desc')}</p>
      </div>
    )}
  </section>
</SiteLayout>

<script>
  // LAT-13773 — keuzehulp (zoek + bestemming + rubriek), status in het URL-fragment
  // zoals /wijnhuizen/. Oude deeplinks ?rubriek=&land=&streek= (LAT-1753, kommalijsten)
  // worden eenmalig vertaald naar het fragment; de querystring verdwijnt via replaceState.
  import { initAlleKeuzehulpen } from '../lib/keuzehulp-client';
  const oud = new URLSearchParams(location.search);
  if (['rubriek', 'land', 'streek'].some((k) => oud.has(k))) {
    const bestaat = (id: string, v: string) => !!document.querySelector(`#${id} option[value="${CSS.escape(v)}"]`);
    const eerste = (k: string, id: string, pre = '') =>
      (oud.get(k) || '').split(',').map((v) => pre + v.trim()).find((v) => v !== pre && bestaat(id, v));
    const hash = new URLSearchParams(location.hash.slice(1));
    const rubriek = eerste('rubriek', 'art-rubriek');
    const bestemming = eerste('streek', 'art-bestemming', 'streek:') || eerste('land', 'art-bestemming', 'land:');
    if (rubriek && !hash.has('rubriek')) hash.set('rubriek', rubriek);
    if (bestemming && !hash.has('bestemming')) hash.set('bestemming', bestemming);
    for (const k of ['rubriek', 'land', 'streek']) oud.delete(k);
    const qs = oud.toString();
    const h = hash.toString();
    history.replaceState(history.state, '', location.pathname + (qs ? `?${qs}` : '') + (h ? `#${h}` : ''));
  }
  initAlleKeuzehulpen();
</script>

<style>
  /* .section (padding: … 0) wint anders van .container's gutter: filterpaneel liep tot de viewportrand (LAT-13062) */
  .section.container { padding-inline: var(--gutter); }
  .hero-sm {
    background: var(--hero-band-bg); /* LAT-14690: zachte overgang in kelder-modus */
    padding: var(--space-12) 0 var(--space-8);
    text-align: center;
  }
  .hero-sm h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 1.5vw, 3rem);
    font-weight: 400;
    font-style: italic;
    color: var(--ink);
    margin-top: var(--space-3);
  }
  .hero-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--inkSoft);
    margin-top: var(--space-3);
    max-width: 36rem;
    margin-inline: auto;
  }

  /* LAT-13056 Variant A: 4 kolommen desktop, 2 tablet, 1 mobiel. */
  .article-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }
  @media (max-width: 1024px) {
    .article-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .article-grid { grid-template-columns: 1fr; }
  }
  .empty-state {
    text-align: center;
    padding: var(--space-16) var(--space-4);
  }
  .empty-state h2 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    font-style: italic;
    color: var(--ink);
    margin-bottom: var(--space-3);
  }
  .empty-state p {
    font-size: 1rem;
    color: var(--inkSoft);
  }
</style>
