---
import OverviewIcon from './OverviewIcon.astro';
import { overviewFacts, type OverviewFact } from '../lib/overview';
interface Props {
 facts: OverviewFact[];
 heading?: string | null;
 tip?: { title: string; text: string } | null;
}
const { facts, heading, tip } = Astro.props;
const items = overviewFacts(facts);
---
{items.length > 0 && <div class="overview">
 {heading && <h2 class="overview__heading">{heading}</h2>}
 <dl class="overview__facts" style={`--fact-columns:${Math.min(items.length, 4)};--wide-span:${Math.min(items.length, 2)}`}>
  {items.map(item => <div class:list={['overview__fact', { 'overview__fact--long': item.value.length > 48, 'overview__fact--prose': item.value.length > 32 }]}>
   <dt><span class="overview__icon"><OverviewIcon name={item.icon!} /></span><span>{item.label}</span></dt>
   <dd>{item.value}</dd>
  </div>)}
 </dl>
 {tip?.title?.trim() && tip?.text?.trim() && <details class="overview__tip">
  <summary><OverviewIcon name="info" /><span>{tip.title}</span><span class="overview__toggle" aria-hidden="true"></span></summary>
  <p>{tip.text}</p>
 </details>}
</div>}
<style>
 .overview { container-type: inline-size; color: var(--ink); }
 .overview__heading { font-family: var(--font-display); font-size: clamp(1.75rem, 1.5rem + 1vw, 2.5rem); font-weight: 400; line-height: 1.1; margin: 0 0 1.25rem; }
 .overview__facts { display: flex; flex-wrap: wrap; margin: 0; padding: 0; border-block: 1px solid var(--rule); }
 .overview__fact { box-sizing: border-box; flex: 1 1 calc(100% / var(--fact-columns)); min-width: 0; padding: 1.3rem 1.2rem; border-inline-start: 1px solid var(--ruleSoft); border-bottom: 1px solid var(--ruleSoft); }
 .overview__fact dt { display: flex; flex-direction: column; gap: .7rem; font-family: var(--font-mono); font-size: .625rem; font-weight: 400; letter-spacing: .09em; line-height: 1.5; text-transform: uppercase; color: var(--inkSoft); overflow-wrap: anywhere; }
 .overview__icon { color: var(--burgundy); height: 28px; }
 .overview__fact:nth-child(3n + 2) .overview__icon { color: var(--vine); }
 .overview__fact:nth-child(3n) .overview__icon { color: var(--rust); }
 .overview__fact dd { margin: .55rem 0 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(1.4rem, 3cqi, 1.875rem); line-height: 1.2; overflow-wrap: anywhere; }
 .overview__fact--long { flex-basis: calc(100% * var(--wide-span) / var(--fact-columns)); }
 .overview__fact--long:last-child { flex-basis: 100%; }
 .overview__fact--prose dd { font-family: var(--font-body); font-size: 1rem; line-height: 1.55; }
 .overview__tip { background: var(--paperDeep); margin-top: 1rem; border: 1px solid var(--ruleSoft); }
 .overview__tip summary { display: flex; align-items: center; gap: .85rem; padding: 1rem; cursor: pointer; list-style: none; font-family: var(--font-body); }
 .overview__tip summary::-webkit-details-marker { display: none; }
 .overview__tip summary:focus-visible { outline: 2px solid var(--burgundy); outline-offset: 3px; }
 .overview__tip summary :global(svg) { color: var(--burgundy); flex: none; }
 .overview__toggle { margin-left: auto; width: 14px; height: 14px; position: relative; flex: none; }
 .overview__toggle::before, .overview__toggle::after { content: ''; position: absolute; background: currentColor; width: 14px; height: 1px; top: 7px; }
 .overview__toggle::after { transform: rotate(90deg); }
 details[open] .overview__toggle::after { display: none; }
 .overview__tip p { margin: 0; padding: 0 1rem 1rem 3.6rem; font-family: var(--font-body); color: var(--inkSoft); line-height: 1.6; }
 @container (max-width: 600px) { .overview__fact { flex-basis: 50%; padding: 1rem .8rem; } .overview__fact--long { flex-basis: 100%; } }
 @container (max-width: 280px) { .overview__fact { flex-basis: 100%; } }
</style>
